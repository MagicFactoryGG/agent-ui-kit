{
 "$schema": "brand-intake/preset@1",
 "name": "Cloudflare Kumo",
 "source": {
  "package": "@cloudflare/kumo@2.19.0",
  "themes": {
   "light": "default",
   "dark": "default"
  }
 },
 "licence": {
  "spdx": "MIT",
  "url": "https://github.com/cloudflare/kumo/blob/main/LICENSE",
  "notice": "Values from Cloudflare Kumo (@cloudflare/kumo@2.19.0), MIT.",
  "acceptBeforeUse": true
 },
 "tokens": {
  "color.background": {
   "light": "#ffffff",
   "dark": "#0f0f0f",
   "origin": "style",
   "from": "--color-kumo-base"
  },
  "color.card": {
   "light": "#f8f8f8",
   "dark": "#060606",
   "origin": "style",
   "from": "--color-kumo-elevated"
  },
  "color.popover": {
   "light": "#f8f8f8",
   "dark": "#060606",
   "origin": "style",
   "from": "--color-kumo-elevated"
  },
  "color.foreground": {
   "light": "#18181b",
   "dark": "#f5f5f5",
   "origin": "style",
   "from": "--text-color-kumo-default"
  },
  "color.muted-foreground": {
   "light": "#737373",
   "dark": "#a1a1a1",
   "origin": "style",
   "from": "--text-color-kumo-subtle"
  },
  "color.border": {
   "light": "#e7e7e7",
   "dark": "#333333",
   "origin": "style",
   "from": "--color-kumo-line"
  },
  "color.muted": {
   "light": "#f2f2f2",
   "dark": "#0b0b0b",
   "origin": "style",
   "from": "--color-kumo-recessed"
  },
  "color.accent": {
   "light": "#f3f3f3",
   "dark": "#404040",
   "origin": "style",
   "from": "--color-kumo-fill-hover"
  },
  "color.primary": {
   "light": "#056dff",
   "dark": "#045ede",
   "origin": "style",
   "from": "--color-kumo-brand"
  },
  "color.primary-foreground": {
   "light": "#f5f5f5",
   "dark": "#171717",
   "origin": "style",
   "from": "--text-color-kumo-inverse"
  },
  "color.ring": {
   "light": "#0b0b0b",
   "dark": "#e9e9e9",
   "origin": "style",
   "from": "--color-kumo-focus"
  },
  "color.success": {
   "light": "#009966",
   "dark": "#00d492",
   "origin": "style",
   "from": "--color-kumo-success"
  },
  "color.warning": {
   "light": "#fa8900",
   "dark": "#db6809",
   "origin": "style",
   "from": "--color-kumo-warning"
  },
  "color.destructive": {
   "light": "#fb2c36",
   "dark": "#e7000b",
   "origin": "style",
   "from": "--color-kumo-danger"
  },
  "color.destructive-foreground": {
   "light": "#f5f5f5",
   "dark": "#171717",
   "origin": "style",
   "from": "--text-color-kumo-inverse"
  }
 }
}
