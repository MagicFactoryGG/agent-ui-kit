// The journeys' words, their one tool list and their start values. Every word a person reads is here or in the
// app's view, never in a design package.
use Value, AgentTool, AnswerWords, Act, Ledger, act, valueOf from "@agent-ui-kit/agent"
use Fact, Event, Step from "__SCOPE__/blocks"

fn onOff(on: bool): string = on ? "on" : "off"
fn answerWords(): AnswerWords = AnswerWords(keep="Keep", undo="Undo", accept="Accept", reject="Reject", now="Now", stop="Stop")
// The newest change on any of the keys, said in one sentence; "" when there is none.
fn latestAbout(l: Ledger, keys: string[]): string = l.changes.filter(c => keys.includes(c.key)).slice(0, 1).map(c => c.sentence).join("")

// SettingsGroup: email notifications.
fn notifyKeys(): string[] = ["digest", "failures", "marketing"]
fn titleOf(key: string): string = key == "digest" ? "Weekly digest" : key == "failures" ? "Deploy failures" : key == "marketing" ? "Product news" : key
fn detailOf(key: string): string = key == "digest" ? "A summary of your week, each Monday." : key == "failures" ? "An email when a deploy fails." : key == "marketing" ? "New features, now and then." : ""
fn switchAct(tool: string, key: string, on: bool): Act = Act(tool=tool, door="agent", key=key, title=titleOf(key), value=onOff(on), did=`Your assistant turned ${titleOf(key)} ${onOff(on)}.`, asks=`Your assistant suggests turning ${titleOf(key)} ${onOff(on)}.`, will=`Your assistant will turn ${titleOf(key)} ${onOff(on)} in 5 seconds.`)

// DetailPanel: one incident's record; its status (open or resolved) is the value both doors set.
fn incidentTitle(): string = "Checkout returns 502 on retry"
fn statusWord(status: string): string = status == "resolved" ? "Resolved" : "Open"
fn incidentFacts(): Fact[] = [
  Fact(key="service", label="Service", value="payments-api"),
  Fact(key="owner", label="Owner", value="Rui Costa"),
  Fact(key="opened", label="Opened", value="Today, 09:12"),
  Fact(key="impact", label="Impact", value="About one in twenty checkouts fail when the card form is sent a second time.")
]
fn incidentEvents(): Event[] = [
  Event(key="deploy", who="Ana Sousa", what="Rolled back the 09:05 deploy", when="09:40"),
  Event(key="opened", who="Rui Costa", what="Opened the incident", when="09:12")
]
fn statusAct(status: string): Act = Act(tool="setIncidentStatus", door="agent", key="incident", title="Incident status", value=status, did=`Your assistant marked the incident ${status}.`, asks=`Your assistant suggests marking the incident ${status}.`, will=`Your assistant will mark the incident ${status} in 5 seconds.`)
// StatePanel: the files area, whose last load failed; its one act starts the load again (its value: loading).
fn loadAct(tool: string): Act = Act(tool=tool, door="agent", key="files", title="Your files", value="loading", did="Your assistant is loading your files again.", asks="Your assistant suggests loading your files again.", will="Your assistant will load your files again in 5 seconds.")

// OnboardingSteps: a workspace's setup; the value is the step the person is on ("done" past the last). Continue
// moves it on one step, Back one step back; the agent continues past a step it names, so a call twice moves once.
fn setupKeys(): string[] = ["account", "profile", "team", "plan"]
fn setupTitle(key: string): string = key == "account" ? "Create your account" : key == "profile" ? "About your work" : key == "team" ? "Invite your team" : key == "plan" ? "Choose a plan" : "Setup complete"
fn setupDetail(key: string): string = key == "account" ? "Your name and a password." : key == "profile" ? "Your role and how big your team is, so the workspace starts with the right layout." : key == "team" ? "Add the people you work with; they get an invitation by email." : key == "plan" ? "Pick the plan that fits; you can change it at any time." : ""
fn setupAt(step: string): number = step == "done" ? setupKeys().length : setupKeys().indexOf(step)
fn setupNext(step: string): string = match setupKeys().at(setupAt(step) + 1) { case some(k) => k, case none => "done" }
fn setupBack(step: string): string = setupAt(step) <= 0 ? "account" : match setupKeys().at(setupAt(step) - 1) { case some(k) => k, case none => "account" }
fn setupSteps(step: string): Step[] = setupKeys().map((k, i) => Step(key=k, title=setupTitle(k), state=(i < setupAt(step) ? "done" : i == setupAt(step) ? "current" : "next")))
fn continueAct(from: string): Act = Act(tool="continueOnboarding", door="agent", key="onboarding", title="Workspace setup", value=setupNext(from), did=`Your assistant finished ${setupTitle(from)} and moved you on.`, asks=`Your assistant suggests finishing ${setupTitle(from)} and moving on.`, will=`Your assistant will finish ${setupTitle(from)} and move you on in 5 seconds.`)
// The agent continues only from the step the person is on; any other step answers not-current and moves nothing.
fn continueFrom(l: Ledger, step: string): Ledger = valueOf(l, "onboarding") == step ? act(l, continueAct(step)) : Ledger(l, answer="not-current")
// The newest change on a key, by id ("" when none): the note's Undo takes back that one.
fn latestIdAbout(l: Ledger, key: string): string = l.changes.filter(c => c.key == key).slice(0, 1).map(c => c.id).join("")

// The app's one tool list: each tool's floor (a change only this person sees is recorded).
fn agentTools(): AgentTool[] = [
  AgentTool(name="setSetting", title="Email notifications", sentence="Turns an email notification on or off.", floor="recorded", reach="self", secret=false),
  AgentTool(name="setIncidentStatus", title="Incident status", sentence="Marks the incident open or resolved.", floor="recorded", reach="self", secret=false),
  AgentTool(name="loadFiles", title="Your files", sentence="Loads the files area again.", floor="recorded", reach="self", secret=false),
  AgentTool(name="continueOnboarding", title="Workspace setup", sentence="Finishes the setup step the person is on and moves on to the next.", floor="recorded", reach="self", secret=false)
]

fn startValues(): Value[] = [
  Value(key="digest", value="on"), Value(key="failures", value="on"), Value(key="marketing", value="off"),
  Value(key="incident", value="open"),
  Value(key="files", value="failed"),
  Value(key="onboarding", value="profile")
]
