// Journeys: blocks. Each block in a small real use, so its two doors can be proved: a person's real input (a tap,
// a switch) and an agent's tool reach the same value in the app's ledger (`book`, @agent-ui-kit/agent), and the
// agent's is recorded and shown on the block. `bun <kit>/tools/both-doors.mjs . web --only "SettingsGroup: "`
// runs one block's cases from both-doors.json.
//
// A block adds: its values in model.contract (startValues, a row in agentTools with its floor, its words), the
// person's door here (actions that call personSet), the agent's door in tools.contract (an action that calls act)
// with a `tool` line below and a face in app.json, its place in the view, and its cases, named "<Block>: …".
// Keys in the ledger are unique in this app; a block's own view state stays out of it.
//
// Members files: tools.contract (the agent's door), model.contract (words, the tool list, start values).
use Ledger, ledger, personSet, undo, isOn, isMarked, valueOf from "@agent-ui-kit/agent"
use SettingsGroup, Setting, DetailPanel, StatePanel, OnboardingSteps, MessageList, SideNav, DataTable, Checked, Marks, FeatureGrid, Pricing from "__SCOPE__/blocks"
use startValues, agentTools, answerWords, onOff, titleOf, detailOf, notifyKeys, latestAbout, incidentTitle, statusWord, incidentFacts, incidentEvents, setupTitle, setupDetail, setupNext, setupBack, setupSteps, latestIdAbout, mailKey, mailLedgerKeys, mailMessages, mailText, mailMarkedKey, homeEntries, menuText, recordKeys, queueRecords, pickWord, firstFeatures, featuresText, planName, planList, planText from "./model.contract"
use Ledger, ledger, personSet, undo, answerKey, waitingSentence, isOn, isMarked, valueOf from "@agent-ui-kit/agent"
use SettingsGroup, Setting, DetailPanel, StatePanel, OnboardingSteps, MessageList, SideNav, DataTable, Checked, Marks, FeatureGrid, Hero from "__SCOPE__/blocks"
use startValues, agentTools, answerWords, onOff, titleOf, detailOf, notifyKeys, latestAbout, incidentTitle, statusWord, incidentFacts, incidentEvents, setupTitle, setupDetail, setupNext, setupBack, setupSteps, latestIdAbout, mailKey, mailLedgerKeys, mailMessages, mailText, mailMarkedKey, homeEntries, menuText, recordKeys, queueRecords, pickWord, firstFeatures, featuresText, trialStarted, heroPoints from "./model.contract"

use Faq from "__SCOPE__/blocks"
use faqKey, faqLedgerKeys, faqQuestions, faqText, faqMarkedKey from "./model.contract"
use BarChart, NotificationList from "__SCOPE__/blocks"
use chartRanges, chartNote, chartLabel, chartPoints, chartText, notesRead, inboxNotes, notesText from "./model.contract"
use StatTiles from "__SCOPE__/blocks"
use weekStats, statsText from "./model.contract"
use Menu, ActionButton from "__SCOPE__/components"
use sortShown, sortText from "./model.contract"
use ActivityTimeline from "__SCOPE__/blocks"
use activityEvents, activityText from "./model.contract"
use CommandMenu from "__SCOPE__/blocks"
use commandsShown, commandResult, commandText from "./model.contract"

// The window's width, for the Hero's size (compact under 600 px): an app reads the viewport, a piece cannot.
shape JourneyViewport
  width: number
use SettingsGroup, Setting, DetailPanel, StatePanel, OnboardingSteps, MessageList, SideNav, DataTable, Checked, Marks, FeatureGrid, SiteFooter from "__SCOPE__/blocks"
use startValues, agentTools, answerWords, onOff, titleOf, detailOf, notifyKeys, latestAbout, incidentTitle, statusWord, incidentFacts, incidentEvents, setupTitle, setupDetail, setupNext, setupBack, setupSteps, latestIdAbout, mailKey, mailLedgerKeys, mailMessages, mailText, mailMarkedKey, homeEntries, menuText, recordKeys, queueRecords, pickWord, firstFeatures, featuresText, helpGroups, footerText from "./model.contract"

component App
  members "./tools.contract"

  state book: Ledger = ledger(startValues(), agentTools(), answerWords())

  // SettingsGroup: the email notifications, each a switch row over one value in the ledger.
  derive notifyRows = notifyKeys().map(k => Setting(key=k, kind="switch", label=titleOf(k), detail=detailOf(k), value="", on=isOn(book, k)))
  derive notifyMarked = notifyKeys().filter(k => isMarked(book, k)).length > 0
  derive notifyText = notifyKeys().map(k => `${k}\t${isOn(book, k) ? "on" : "off"}`).join("\n")

  // DetailPanel: one incident's record; its status is one value in the ledger, "open" or "resolved".
  derive incidentStatus = valueOf(book, "incident")
  derive incidentText = `${incidentTitle()}\t${incidentStatus}`
  // StatePanel: the files area; its value is the area's data state (empty, loading or failed), given to the
  // panel's `data` inline (an enum prop takes the literals there; a derive of them is a string).
  derive filesState = valueOf(book, "files")
  derive filesMarked = isMarked(book, "files")
  // OnboardingSteps: the workspace's setup; its value is the step the person is on, "done" past the last.
  derive setupStep = valueOf(book, "onboarding")
  derive setupMarked = isMarked(book, "onboarding")
  derive setupText = `${setupStep}\t${setupTitle(setupStep)}`
  // MessageList: the inbox; each message's read state is a value in the ledger. The reading pane shows the
  // chosen message (a view fact of this use, not a value both doors set).
  derive mailChosen = "review"
  derive mailChosenUnread = valueOf(book, mailKey(mailChosen)) == "unread"
  derive mailAgentKey = mailMarkedKey(book)
  derive mailReadText = mailText(book)
  // SideNav: a new workspace's menu, empty until Home is added; given to the piece's `data` inline.
  derive menu = valueOf(book, "menu")
  derive menuMarked = isMarked(book, "menu")
  // DataTable: the deploy queue; each record's selection is one value in the ledger, "selected" or "unselected".
  derive queueChecked = Checked(keys=recordKeys().filter(k => valueOf(book, k) == "selected"))
  derive queueAll = queueChecked.keys.length == recordKeys().length
  derive queueMarks = Marks(keys=recordKeys().filter(k => isMarked(book, k)))
  derive queueText = recordKeys().map(k => `${k}\t${valueOf(book, k)}`).join("\n")
  // FeatureGrid: a product page's features, empty until Live sync is added; given to the piece's `data` inline.
  derive features = valueOf(book, "features")
  derive featuresMarked = isMarked(book, "features")
  // Pricing: the workspace's plan, "none" until one is chosen; the chosen card carries the agent's mark.
  derive plan = valueOf(book, "plan")
  // Menu: the list's order, "newest" until another is chosen.
  derive sort = valueOf(book, "sort")
  derive planMarked = isMarked(book, "plan")
  // Hero: the landing page's free trial; its value is "off" until it starts, then "started". An agent's start
  // is marked on the hero (changed, with Undo); one held for the person's answer shows as its proposal.
  resource viewport = exactViewport() as shape JourneyViewport
  derive trialOn = trialStarted(book)
  derive trialMarked = isMarked(book, "trial")
  derive trialAsks = waitingSentence(book, "trial")
  // SiteFooter: a product site's footer, with no links until Help is added; given to the piece's `data` inline.
  derive footerLinks = valueOf(book, "footer")
  derive footerMarked = isMarked(book, "footer")
  // Faq: the help page's questions; each one's disclosure is a value in the ledger, "open" or "closed". The
  // question the agent opened or closed wears its mark and the change's sentence.
  derive faqAgentKey = faqMarkedKey(book)
  derive faqMarked = faqAgentKey != ""
  derive faqReadText = faqText(book)
  // BarChart: the orders chart; its range is one value in the ledger, "week" or "month". An agent's switch is
  // marked on the chart, with its sentence and Undo.
  derive chartRange = valueOf(book, "chart-range")
  derive chartMarked = isMarked(book, "chart-range")
  // NotificationList: the person's notifications; whether the new ones are read is one value in the ledger. An
  // agent's mark is shown on the list (changed, with Undo); one held for the person's answer shows as its ask.
  derive notesAllRead = notesRead(book)
  derive notesMarked = isMarked(book, "notes")
  derive notesAsks = waitingSentence(book, "notes")
  derive notesReadText = notesText(book)
  // StatTiles: this week's numbers; the row's data state is one value in the ledger, "failed" until read again,
  // then "many". The agent's read is said under the row (changed: what it did), with one Undo.
  derive stats = valueOf(book, "stats")
  derive statsMarked = isMarked(book, "stats")
  // ActivityTimeline: the workspace's activity; its filter is one value in the ledger (everyone, person or agent),
  // and the assistant's archive of yesterday another ("archived", or "kept" once undone). The open Undo is on the
  // archive while it stands, then on the assistant's own undo while that is marked.
  derive activityFilter = valueOf(book, "activity-filter")
  derive activityFilterMarked = isMarked(book, "activity-filter")
  derive threads = valueOf(book, "threads")
  derive threadsMarked = isMarked(book, "threads")
  derive activityUndoKey = threads == "archived" ? "archive" : threadsMarked ? "restore" : ""
  // CommandMenu: the last command run, "none" until one is; the agent's run is marked on its command, with Undo.
  derive lastCommand = valueOf(book, "command")
  derive commandMarked = isMarked(book, "command")

  // The person's door: the switch says which row; the app flips its own value.
  action toggleByPerson(key: string)
    book = personSet(book, key, onOff(not isOn(book, key)))
  // The incident's primary action marks it resolved, or reopens it once resolved.
  action markIncidentByPerson
    book = personSet(book, "incident", incidentStatus == "resolved" ? "open" : "resolved")
  // The panel's one action (Try again when failed, the way in when empty) starts the load again.
  action loadByPerson
    book = personSet(book, "files", "loading")
  // The setup's way on: Continue and Skip move on one step, Back one step back; the note's Keep makes the
  // agent's move the person's own (it clears the mark), its Undo takes the move back.
  action continueByPerson
    book = personSet(book, "onboarding", setupNext(setupStep))
  action backByPerson
    book = personSet(book, "onboarding", setupBack(setupStep))
  action keepSetup
    book = personSet(book, "onboarding", setupStep)
  action undoSetup
    book = undo(book, latestIdAbout(book, "onboarding"))
  // The reading pane's one button marks the chosen message read, or unread once read.
  action markMailByPerson
    book = personSet(book, mailKey(mailChosen), mailChosenUnread ? "read" : "unread")
  // The empty menu's way on adds its first place, Home.
  action addHomeByPerson
    book = personSet(book, "menu", "home")
  // A record's checkbox says which row; the app flips its selection. Select all selects every row, or clears
  // them all once every row is selected.
  action pickByPerson(key: string)
    book = personSet(book, key, pickWord(valueOf(book, key) != "selected"))
  action pickAllByPerson
    book = personSet(personSet(personSet(book, "audit", pickWord(not queueAll)), "rotate", pickWord(not queueAll)), "invoices", pickWord(not queueAll))
  // The empty features section's way on adds its first feature, Live sync.
  action addFeatureByPerson
    book = personSet(book, "features", "sync")
  // A plan's button chooses it; the agent's note's Undo takes its choice back.
  // An item of the order's Menu chooses it; its search narrows the items (the words typed are this view's own).
  action chooseSortByPerson(key: string)
    book = personSet(book, "sort", key)
  state sortQuery = ""
  action findSort(v: string)
    sortQuery = v
  // the Order button only opens the menu (its `opens`); a press has nothing more to do
  action sortOpened
  // A command chosen in the Commands menu runs it (and the search starts empty next time); the menu's search
  // narrows the commands (the words typed are this view's own); Undo takes the agent's run back.
  action runCommandByPerson(key: string)
    book = personSet(book, "command", key)
    commandQuery = ""
  state commandQuery = ""
  action findCommand(v: string)
    commandQuery = v
  action undoCommand
    book = undo(book, latestIdAbout(book, "command"))
  action choosePlanByPerson(key: string)
    book = personSet(book, "plan", key)
  action undoPlan
    book = undo(book, latestIdAbout(book, "plan"))
  // The hero's primary starts the trial (once started, it stays started); Undo takes the agent's start back,
  // and a proposal's answers accept or reject the agent's held start.
  action startTrialByPerson
    book = personSet(book, "trial", "started")
  action undoTrial
    book = undo(book, latestIdAbout(book, "trial"))
  action acceptTrial
    book = answerKey(book, "trial", true, "person")
  action rejectTrial
    book = answerKey(book, "trial", false, "person")
  // The empty footer's way on adds its first column, Help; the agent's note's Undo takes the agent's add back.
  action addFooterLinksByPerson
    book = personSet(book, "footer", "help")
  action undoFooter
    book = undo(book, latestIdAbout(book, "footer"))
  // A question's press opens it, or closes it once open.
  action toggleQuestionByPerson(key: string)
    book = personSet(book, faqKey(key), valueOf(book, faqKey(key)) == "open" ? "closed" : "open")
  // The chart's range switch shows the range pressed; Undo takes the agent's switch back.
  action chooseRangeByPerson(key: string)
    book = personSet(book, "chart-range", key)
  action undoRange
    book = undo(book, latestIdAbout(book, "chart-range"))
  // The list's Mark all read marks the new notifications read; the agent's band answers its ask or takes its
  // change back.
  action markNotesByPerson
    book = personSet(book, "notes", "read")
  action undoNotes
    book = undo(book, latestIdAbout(book, "notes"))
  action acceptNotes
    book = answerKey(book, "notes", true, "person")
  action rejectNotes
    book = answerKey(book, "notes", false, "person")
  // A note's own answers (Manage storage) lead elsewhere in a real app; this use has none.
  action ignoreAnswer(key: string, yes: bool)
    book = book
  // The failed banner's Try again reads the numbers again; the note's Undo takes the agent's read back.
  action loadStatsByPerson
    book = personSet(book, "stats", "many")
  action undoStats
    book = undo(book, latestIdAbout(book, "stats"))
  // The timeline's segments show the events by who did them; the event's Undo takes back the assistant's archive,
  // or its own undo of it.
  action chooseActivityByPerson(key: string)
    book = personSet(book, "activity-filter", key)
  action undoActivityByPerson
    if threads == "archived"
      book = personSet(book, "threads", "kept")
    else
      book = undo(book, latestIdAbout(book, "threads"))
  // Rows of other kinds, a retry and a proposal's answers: this use has none.
  action ignoreKey(key: string)
    book = book
  action ignore
    book = book

  // The agent's door. Answer words: saved, delayed, proposed, off.
  tool readSettings reads "Each email notification, one per line: id (digest, failures or marketing), then on or off, tab-separated." = readSettings
    returns notifyText
  tool setSetting writes idempotent closed "Turn an email notification on or off: digest, failures or marketing. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readSettings." = setSetting
    returns book.answer
    fails when book.answer == "off"
  tool readIncident reads "The incident on screen: its title, then its status (open or resolved), tab-separated." = readIncident
    returns incidentText
  tool setIncidentStatus writes idempotent closed "Mark the incident open or resolved. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readIncident." = setIncidentStatus
    returns book.answer
    fails when book.answer == "off"
  tool readFiles reads "The files area's state: empty, loading or failed." = readFiles
    returns valueOf(book, "files")
  tool loadFiles writes idempotent closed "Load the files area again, as its Try again does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readFiles." = loadFiles
    returns book.answer
    fails when book.answer == "off"
  tool readOnboarding reads "The workspace setup: the step the person is on (account, profile, team, plan, or done when every step is finished), then its title, tab-separated." = readOnboarding
    returns setupText
  tool continueOnboarding writes idempotent closed "Finish the setup step the person is on and move on to the next, as its Continue does: name that step (account, profile, team or plan). Answers saved, not-current when the person is on another step (nothing moves), or delayed, proposed or off when the person raised its mode. Check with readOnboarding." = continueOnboarding
    returns book.answer
    fails when book.answer == "off" or book.answer == "not-current"
  tool readMail reads "The inbox, one message per line: id (review, report or lunch), sender, subject, then read or unread, tab-separated." = readMail
    returns mailReadText
  tool markMessage writes idempotent closed "Mark a message in the inbox read or unread: review, report or lunch. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readMail." = markMessage
    returns book.answer
    fails when book.answer == "off"
  tool readMenu reads "The menu's places, one per line: id, then name, tab-separated; empty while the menu has none." = readMenu
    returns menuText(menu)
  tool addHome writes idempotent closed "Add Home to the empty menu, as its Add Home does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readMenu." = addHome
    returns book.answer
    fails when book.answer == "off"
  tool readQueue reads "Each record in the deploy queue, one per line: id (audit, rotate or invoices), then selected or unselected, tab-separated." = readQueue
    returns queueText
  tool selectRecord writes idempotent closed "Select a record in the deploy queue, or clear it: audit, rotate or invoices. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readQueue." = selectRecord
    returns book.answer
    fails when book.answer == "off"
  tool readFeatures reads "The features section's features, one per line: id, then title, tab-separated; empty while the section has none." = readFeatures
    returns featuresText(features)
  tool addFeature writes idempotent closed "Add the first feature, Live sync, to the empty features section, as its Add a feature does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readFeatures." = addFeature
    returns book.answer
    fails when book.answer == "off"
  tool readPlan reads "The workspace's plan: its id (none, starter, team or business), then its name, tab-separated." = readPlan
    returns planText(plan)
  tool choosePlan writes idempotent closed "Choose the workspace's plan, as a plan's Choose button does: starter, team or business. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readPlan." = choosePlan
    returns book.answer
    fails when book.answer == "off"
  tool readTrial reads "The free trial on the landing page: off, or started." = readTrial
    returns valueOf(book, "trial")
  tool startTrial writes idempotent closed "Start the free trial, as the page's Start free trial does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readTrial." = startTrial
    returns book.answer
    fails when book.answer == "off"
  tool readFooter reads "The footer's links, one column per line: column id, title, then each link's id and label, tab-separated; empty while the footer has none." = readFooter
    returns footerText(footerLinks)
  tool addFooterLinks writes idempotent closed "Add the first column, Help with Contact us, to the footer that has no links, as its Add links does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readFooter." = addFooterLinks
    returns book.answer
    fails when book.answer == "off"
  tool readFaq reads "The help page's questions, one per line: id (returns, delivery, change or payment), the question, then open or closed, tab-separated." = readFaq
    returns faqReadText
  tool openQuestion writes idempotent closed "Open a question on the help page to show the person its answer, or close it, as a press on the question does: returns, delivery, change or payment. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readFaq." = openQuestion
    returns book.answer
    fails when book.answer == "off"
  tool readChart reads "The orders chart: its range (week or month) on the first line, then each bar, one per line: label, then orders, tab-separated." = readChart
    returns chartText(chartRange)
  tool setChartRange writes idempotent closed "Show the orders chart by week or by month, as its Weeks and Months switch does: week or month. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readChart." = setChartRange
    returns book.answer
    fails when book.answer == "off"
  tool readNotes reads "The notifications, one per line: id, title, then read or unread, tab-separated." = readNotes
    returns notesReadText
  tool markNotesRead writes idempotent closed "Mark the new notifications read, as the list's Mark all read does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readNotes." = markNotesRead
    returns book.answer
    fails when book.answer == "off"

  tool readStats reads "This week's numbers, one per line: id, label, value and change, tab-separated; or failed while they could not be read." = readStats
    returns statsText(stats)
  tool loadStats writes idempotent closed "Read this week's numbers again after a failed read, as their Try again does. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readStats." = loadStats
    returns book.answer
  tool readSort reads "The list's order: its id (newest, oldest or name), then its name, tab-separated." = readSort
    returns sortText(sort)
  tool setSort writes idempotent closed "Put the list in an order, as an item of the Order menu does: newest, oldest or name. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readSort." = setSort
    returns book.answer
  tool readCommands reads "The last command run: its id (none until one is), then its name, tab-separated." = readCommands
    returns commandText(lastCommand)
  tool runCommand writes idempotent closed "Run one of the workspace's commands, as choosing it in the Commands menu does: new-invoice, new-customer, export, archive or settings. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readCommands." = runCommand
    returns book.answer
    fails when book.answer == "off"
  tool readActivity reads "The activity: the filter (everyone, person or agent) on the first line, then each event shown to everyone, newest first, one per line: id, day, time, who (person or agent), then what happened, tab-separated." = readActivity
    returns activityText(book)
  tool setActivityFilter writes idempotent closed "Show the activity of everyone, only the person's own events, or only the assistant's, as the timeline's Everyone, You and Your assistant do: everyone, person or agent. Answers saved, or delayed, proposed or off when the person raised its mode. Check with readActivity." = setActivityFilter
    returns book.answer
    fails when book.answer == "off"
  tool undoActivity writes idempotent closed "Undo an event the assistant did, as the event's Undo does: archive puts the 12 threads it archived back in the inbox. Answers saved, not-archived when they are back already, or delayed, proposed or off when the person raised its mode. Check with readActivity." = undoActivity
    returns book.answer
    fails when book.answer == "off"

  view
    main testId="app" width="100%" height="100%"
      SettingsGroup(title="Email notifications", footer="Changes apply at once.", emptyText="", loadingText="", failedText="", failedDetail="", retryLabel="", proposalText="", proposalKey="", acceptLabel="", declineLabel="", changedText=latestAbout(book, notifyKeys()), waitingText="", outcomeText="", data="many", interaction="idle", outcome="none", agent=(notifyMarked ? "changed" : "none"), rows=notifyRows, toggle=toggleByPerson, choose=ignoreKey, open=ignoreKey, remove=ignoreKey, retry=ignore, accept=ignore, decline=ignore, testId="notify")
      DetailPanel(title=incidentTitle(), statusLabel=statusWord(incidentStatus), status=(incidentStatus == "resolved" ? "success" : "none"), primaryLabel=(incidentStatus == "resolved" ? "Reopen" : "Mark resolved"), primaryPress=markIncidentByPerson, secondaryLabel="", secondaryPress=ignore, interaction="idle", busyNote="", changedNote=latestAbout(book, ["incident"]), waitingNote="", retryLabel="", retryPress=ignore, factsTitle="Details", facts=incidentFacts(), factsEmptyText="", notesTitle="", notes="", activityTitle="Activity", events=incidentEvents(), activityEmptyText="", loadingText="", failedText="", data="one", agent=(isMarked(book, "incident") ? "changed" : "none"), testId="incident")
      StatePanel(title="Your files", message="Everything you add to this project will appear here, ready to share.", failedText="We couldn't load your files. Check your connection, then try again.", agentNote=latestAbout(book, ["files"]), actionLabel="Add files", retryLabel="Try again", data=(filesState == "loading" ? "loading" : filesState == "empty" ? "empty" : "failed"), agent=(filesMarked ? "changed" : "none"), size="full", press=loadByPerson, testId="files")
      OnboardingSteps(steps=(setupStep == "done" ? [] : setupSteps(setupStep)), lead=setupDetail(setupStep), countLabel="Workspace setup", backLabel="Back", continueLabel=(setupStep == "done" ? "Go to your workspace" : "Continue"), skipLabel=(setupStep == "done" ? "" : "Skip for now"), errorText="", emptyText="Your workspace is ready. You can change any of these later in Settings.", completeText="All steps complete", loadingText="", failedText="", retryLabel="", agentNote=latestAbout(book, ["onboarding"]), acceptLabel="Keep", rejectLabel="Undo", data=(setupStep == "done" ? "empty" : "many"), interaction="idle", outcome="none", agent=(setupMarked ? "proposed" : "none"), testId="onboarding", back=backByPerson, advance=continueByPerson, skip=continueByPerson, retry=ignore, accept=keepSetup, reject=undoSetup)
      MessageList(title="Inbox", unreadLabel="unread", emptyText="No messages yet.", failedText="Your messages did not load.", composeLabel="Write a message", retryLabel="Try again", orderLabel="Newest first", paneLabel="Message preview", paneEmptyText="Choose a message to read it here.", paneQuietText="When a message arrives, it opens here.", openLabel=(mailChosenUnread ? "Mark as read" : "Mark as unread"), agentNote=latestAbout(book, mailLedgerKeys()), chosenKey=mailChosen, agentKey=mailAgentKey, data="many", agent=(mailAgentKey != "" ? "changed" : "none"), messages=mailMessages(book), compose=ignore, retry=ignore, openMessage=markMailByPerson, testId="mail")
      SideNav(productName="Acme Console", productMark="AC", navLabel="Main menu", entries=(menu == "home" ? homeEntries() : []), data=(menu == "home" ? "one" : "empty"), emptyText="This workspace's menu has no places yet.", emptyLabel="Add Home", empty=addHomeByPerson, loadingText="", failedText="", retryLabel="", retry=ignore, accountName="Ada Lovelace", accountDetail="Workspace admin", agent=(menuMarked ? "changed" : "none"), agentKey="home", agentNote=latestAbout(book, ["menu"]), testId="nav")
      DataTable(records=queueRecords(), checked=queueChecked, marks=queueMarks, titleLabel="Change", statusLabel="Status", ownerLabel="Owner", updatedLabel="Updated", selectLabel="Select", selectAllLabel="Select every change", emptyText="", loadingText="", failedText="", busyText="", agentNote=latestAbout(book, recordKeys()), retryLabel="", createLabel="", sort="updated", sortDir="descending", data="many", interaction="idle", agent=(queueMarks.keys.length > 0 ? "changed" : "none"), toggle=pickByPerson, toggleAll=pickAllByPerson, retry=ignore, create=ignore, testId="queue")
