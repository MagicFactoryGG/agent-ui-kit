// The agent's door: the actions the root's `tool` lines name. Each is one line over the ledger's functions; the
// mode comes from the tool list, never from an `if` here. The door is passed as "agent": an action cannot read
// which door called it. A tool's action calls functions only, never another action with arguments (the kit's
// docs/recipes/exact-workarounds.md, 3).
use act from "@agent-ui-kit/agent"
use switchAct, statusAct, loadAct, continueFrom, readAct, addHomeAct, pickAct, addFeatureAct, planAct, trialAct, addFooterLinksAct from "./model.contract"
use switchAct, statusAct, loadAct, continueFrom, readAct, addHomeAct, pickAct, addFeatureAct, planAct, trialAct from "./model.contract"
use faqAct from "./model.contract"
use rangeAct, notesReadAct from "./model.contract"
use loadStatsAct from "./model.contract"
use sortAct from "./model.contract"
use commandAct from "./model.contract"

members App
  action readSettings
  action setSetting(setting: enum<"digest", "failures", "marketing">, on: bool)
    book = act(book, switchAct("setSetting", setting, on))
  action readIncident
  action setIncidentStatus(status: enum<"open", "resolved">)
    book = act(book, statusAct(status))
  action readFiles
  action loadFiles
    book = act(book, loadAct("loadFiles"))
  action readOnboarding
  action continueOnboarding(step: enum<"account", "profile", "team", "plan">)
    book = continueFrom(book, step)
  action readMail
  action markMessage(message: enum<"review", "report", "lunch">, read: bool)
    book = act(book, readAct(message, read))
  action readMenu
  action addHome
    book = act(book, addHomeAct())
  action readQueue
  action selectRecord(record: enum<"audit", "rotate", "invoices">, selected: bool)
    book = act(book, pickAct(record, selected))
  action readFeatures
  action addFeature
    book = act(book, addFeatureAct())
  action readPlan
  action choosePlan(plan: enum<"starter", "team", "business">)
    book = act(book, planAct(plan))
  action readTrial
  action startTrial
    book = act(book, trialAct())
  action readFooter
  action addFooterLinks
    book = act(book, addFooterLinksAct())
  action readFaq
  action openQuestion(question: enum<"returns", "delivery", "change", "payment">, open: bool)
    book = act(book, faqAct(question, open))
  action readChart
  action setChartRange(range: enum<"week", "month">)
    book = act(book, rangeAct(range))
  action readNotes
  action markNotesRead
    book = act(book, notesReadAct())
  action readStats
  action loadStats
    book = act(book, loadStatsAct())
  action readSort
  action setSort(sort: enum<"newest", "oldest", "name">)
    book = act(book, sortAct(sort))
  action readCommands
  action runCommand(command: enum<"new-invoice", "new-customer", "export", "archive", "settings">)
    book = act(book, commandAct(command))
