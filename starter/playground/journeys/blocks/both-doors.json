[
  {
    "name": "SettingsGroup: the weekly digest: the switch and setSetting reach the same value; the agent's is recorded and marked",
    "person": [
      "type notify-switch-digest false"
    ],
    "agent": [
      "call setSetting {\"setting\":\"digest\",\"on\":false}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.0.value": "off",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": [
        "digest"
      ]
    },
    "expectPerson": {
      "book.values.0.value": "off",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "DetailPanel: the incident's status: Mark resolved and setIncidentStatus reach the same value; the agent's is recorded and marked",
    "person": [
      "tap incident-primary"
    ],
    "agent": [
      "call setIncidentStatus {\"status\":\"resolved\"}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.3.value": "resolved",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.key": "incident",
      "book.marked": [
        "incident"
      ]
    },
    "expectPerson": {
      "book.values.3.value": "resolved",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "StatePanel: the files failed to load: Try again and loadFiles reach the same loading state; the agent's is recorded and marked",
    "person": [
      "tap files-action"
    ],
    "agent": [
      "call loadFiles {}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.4.value": "loading",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.was": "failed",
      "book.marked": [
        "files"
      ]
    },
    "expectPerson": {
      "book.values.4.value": "loading",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "OnboardingSteps: the workspace setup: Continue and continueOnboarding move the person on to the same step; the agent's is recorded and marked",
    "person": [
      "tap onboarding-continue"
    ],
    "agent": [
      "call continueOnboarding {\"step\":\"profile\"}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.5.value": "team",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.key": "onboarding",
      "book.changes.0.was": "profile",
      "book.marked": [
        "onboarding"
      ],
      "setupMarked": true,
      "setupText": "team\tInvite your team"
    },
    "expectPerson": {
      "book.values.5.value": "team",
      "book.changes.length": 0,
      "book.marked": [],
      "setupMarked": false
    }
  },
  {
    "name": "OnboardingSteps: a step the person is not on: continueOnboarding answers not-current and moves nothing, as no tap does",
    "person": [],
    "agent": [
      "call continueOnboarding {\"step\":\"team\"}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "failed",
        "not-current"
      ]
    ],
    "expect": {
      "book.values.5.value": "profile",
      "book.changes.length": 0,
      "book.marked": []
    }
  }
]
