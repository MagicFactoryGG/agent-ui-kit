[
  {
    "name": "SettingsGroup: the weekly digest: the switch and setSetting reach the same value; the agent's is recorded and marked",
    "person": [
      "type notify-switch-digest false"
    ],
    "agent": [
      "call setSetting {\"setting\":\"digest\",\"on\":false}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.0.value": "off",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": [
        "digest"
      ]
    },
    "expectPerson": {
      "book.values.0.value": "off",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "DetailPanel: the incident's status: Mark resolved and setIncidentStatus reach the same value; the agent's is recorded and marked",
    "person": [
      "tap incident-primary"
    ],
    "agent": [
      "call setIncidentStatus {\"status\":\"resolved\"}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.3.value": "resolved",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.key": "incident",
      "book.marked": [
        "incident"
      ]
    },
    "expectPerson": {
      "book.values.3.value": "resolved",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "StatePanel: the files failed to load: Try again and loadFiles reach the same loading state; the agent's is recorded and marked",
    "person": [
      "tap files-action"
    ],
    "agent": [
      "call loadFiles {}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.4.value": "loading",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.was": "failed",
      "book.marked": [
        "files"
      ]
    },
    "expectPerson": {
      "book.values.4.value": "loading",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "DataTable: a record's selection: its checkbox and selectRecord reach the same value; the agent's is recorded and marked",
    "person": [
      "tap queue-check-rotate"
    ],
    "agent": [
      "call selectRecord {\"record\":\"rotate\",\"selected\":true}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.6.value": "selected",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.changes.0.key": "rotate",
      "book.changes.0.was": "unselected",
      "book.marked": [
        "rotate"
      ]
    },
    "expectPerson": {
      "book.values.6.value": "selected",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "DataTable: a record selected, then cleared: two checkbox taps and two selectRecord calls end at the same value",
    "person": [
      "tap queue-check-audit",
      "tap queue-check-audit"
    ],
    "agent": [
      "call selectRecord {\"record\":\"audit\",\"selected\":true}",
      "call selectRecord {\"record\":\"audit\",\"selected\":false}"
    ],
    "same": [
      "book.values"
    ],
    "calls": [
      [
        "ok",
        "saved"
      ],
      [
        "ok",
        "saved"
      ]
    ],
    "expect": {
      "book.values.5.value": "unselected",
      "book.changes.length": 2,
      "book.changes.0.was": "selected",
      "book.changes.0.now": "unselected",
      "book.marked": [
        "audit"
      ]
    },
    "expectPerson": {
      "book.values.5.value": "unselected",
      "book.changes.length": 0,
      "book.marked": []
    }
  }
]
