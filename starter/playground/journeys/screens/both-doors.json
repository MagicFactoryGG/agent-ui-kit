[
  {
    "name": "MediaViewer: Next and showPicture reach the same picture; the agent's is recorded and marked",
    "person": ["tap media-viewer-next"],
    "agent": ["call showPicture {\"picture\":\"tram\"}"],
    "same": ["pictureIndex", "book.values"],
    "calls": [["ok", "saved"]],
    "expect": {
      "pictureIndex": 1,
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": ["picture"]
    },
    "expectPerson": {
      "pictureIndex": 1,
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "MailScreen: Flag and flagMessage flag the same message; the agent's is recorded and marked",
    "person": ["call openScreen {\"screen\":\"MailScreen\"}", "tap mail-flag"],
    "agent": ["call openScreen {\"screen\":\"MailScreen\"}", "call flagMessage {\"message\":\"m2\",\"flagged\":true}"],
    "same": ["mailMessages", "book.values"],
    "calls": [["ok", "MailScreen"], ["ok", "saved"]],
    "expect": {
      "mailMarkedKey": "m2",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": ["flag-m2"]
    },
    "expectPerson": {
      "mailMarkedKey": "",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "ListDetail: a tap on a row and openProject open the same project; the agent's is recorded and marked",
    "person": ["call openScreen {\"screen\":\"ListDetail\"}", "tap list-detail-row-north"],
    "agent": ["call openScreen {\"screen\":\"ListDetail\"}", "call openProject {\"project\":\"north\"}"],
    "same": ["projectKey", "opened", "book.values"],
    "calls": [["ok", "ListDetail"], ["ok", "saved"]],
    "expect": {
      "projectKey": "north",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": ["project"]
    },
    "expectPerson": {
      "projectKey": "north",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "ListDetail: Undo on the screen takes back the agent's openProject",
    "person": ["call openScreen {\"screen\":\"ListDetail\"}"],
    "agent": ["call openScreen {\"screen\":\"ListDetail\"}", "call openProject {\"project\":\"atlas\"}", "tap list-detail-undo"],
    "same": ["projectKey", "book.values", "book.marked"],
    "calls": [["ok", "ListDetail"], ["ok", "saved"]],
    "expect": {
      "projectKey": "harbour",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "OnboardingScreen: typing the workspace name and fillAnswer write the same answer; the agent's is recorded and marked",
    "person": ["call openScreen {\"screen\":\"OnboardingScreen\"}", "type onboarding-workspace-input Harbour Studio"],
    "agent": ["call openScreen {\"screen\":\"OnboardingScreen\"}", "call fillAnswer {\"answer\":\"workspace\",\"value\":\"Harbour Studio\"}"],
    "same": ["setupStep", "book.values"],
    "calls": [["ok", "OnboardingScreen"], ["ok", "saved"]],
    "expect": {
      "setupFields.0.value": "Harbour Studio",
      "setupFields.0.byAgent": true,
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": ["setup-workspace"]
    },
    "tree": { "onboarding-workspace-input": "Harbour Studio" },
    "expectPerson": {
      "setupFields.0.value": "Harbour Studio",
      "setupFields.0.byAgent": false,
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "OnboardingScreen: Continue moves the step on, and the person's typing takes an answer the agent filled back",
    "person": ["call openScreen {\"screen\":\"OnboardingScreen\"}", "tap onboarding-steps-continue", "type onboarding-size-input 12"],
    "agent": ["call openScreen {\"screen\":\"OnboardingScreen\"}", "call fillAnswer {\"answer\":\"size\",\"value\":\"8\"}", "tap onboarding-steps-continue", "type onboarding-size-input 12"],
    "same": ["setupStep", "setupFields", "book.values", "book.marked"],
    "calls": [["ok", "OnboardingScreen"], ["ok", "saved"]],
    "expect": {
      "setupStep": "team",
      "setupFields.0.value": "12",
      "book.changes.length": 1,
      "book.marked": []
    }
  },
  {
    "name": "SettingsScreen: the weekly digest's switch and setSetting turn it off alike; the agent's is recorded and marked",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}", "type settings-email-switch-digest false"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call setSetting {\"setting\":\"digest\",\"on\":false}"],
    "same": ["settingsAt", "settingsGroups", "book.values"],
    "calls": [["ok", "SettingsScreen"], ["ok", "saved"]],
    "expect": {
      "settingsGroups.0.rows.0.on": false,
      "settingsMarkedKey": "digest",
      "book.changes.length": 1,
      "book.changes.0.mode": "recorded",
      "book.marked": ["settings-digest"]
    },
    "expectPerson": {
      "settingsGroups.0.rows.0.on": false,
      "settingsMarkedKey": "",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "SettingsScreen: a place in the list and showSettingsSection show the same section, and its switch and setSetting turn read receipts on alike",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}", "tap settings-screen-place-privacy", "type settings-sharing-switch-receipts true"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call setSetting {\"setting\":\"receipts\",\"on\":true}", "call showSettingsSection {\"section\":\"privacy\"}"],
    "same": ["settingsAt", "settingsGroups", "book.values"],
    "calls": [["ok", "SettingsScreen"], ["ok", "saved"], ["ok", "privacy"]],
    "expect": {
      "settingsAt": "privacy",
      "settingsGroups.0.rows.1.on": true,
      "settingsMarkedKey": "receipts",
      "book.marked": ["settings-receipts"]
    },
    "expectPerson": {
      "settingsAt": "privacy",
      "book.marked": []
    }
  },
  {
    "name": "SettingsScreen: Undo on the screen takes back the agent's setSetting",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call setSetting {\"setting\":\"mentions\",\"on\":false}", "tap settings-screen-undo"],
    "same": ["settingsGroups", "book.values", "book.marked"],
    "calls": [["ok", "SettingsScreen"], ["ok", "saved"]],
    "expect": {
      "settingsGroups.0.rows.1.on": true,
      "settingsMarkedKey": "",
      "book.changes.length": 0,
      "book.marked": []
    }
  },
  {
    "name": "SettingsScreen: suggestSetting changes nothing until the person answers; the suggestion is shown on the setting's group",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call suggestSetting {\"setting\":\"digest\",\"on\":false}"],
    "same": ["settingsGroups", "book.values", "book.changes"],
    "calls": [["ok", "SettingsScreen"], ["ok", "proposed"]],
    "expect": {
      "settingsAgent": "proposed",
      "settingsAgentKey": "digest",
      "settingsGroups.0.rows.0.on": true,
      "book.waiting.length": 1,
      "book.changes.length": 0
    }
  },
  {
    "name": "SettingsScreen: Accept on the screen lets suggestSetting through, to the value the person's switch reaches",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}", "type settings-email-switch-digest false"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call suggestSetting {\"setting\":\"digest\",\"on\":false}", "tap settings-email-accept"],
    "same": ["settingsGroups", "book.values", "book.waiting"],
    "calls": [["ok", "SettingsScreen"], ["ok", "proposed"]],
    "expect": {
      "settingsGroups.0.rows.0.on": false,
      "settingsAgent": "changed",
      "book.waiting.length": 0,
      "book.changes.length": 1,
      "book.changes.0.mode": "proposed"
    }
  },
  {
    "name": "SettingsScreen: Not now on the screen drops suggestSetting, and nothing changes",
    "person": ["call openScreen {\"screen\":\"SettingsScreen\"}"],
    "agent": ["call openScreen {\"screen\":\"SettingsScreen\"}", "call suggestSetting {\"setting\":\"mentions\",\"on\":false}", "tap settings-email-decline"],
    "same": ["settingsGroups", "settingsAgent", "book.values", "book.waiting", "book.changes", "book.marked"],
    "calls": [["ok", "SettingsScreen"], ["ok", "proposed"]],
    "expect": {
      "settingsAgent": "none",
      "settingsGroups.0.rows.1.on": true,
      "book.waiting.length": 0
    }
  }
]
