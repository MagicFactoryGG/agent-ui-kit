// The journeys' words, their one tool list and their start values. Every word a person reads is here or in the
// app's view, never in a design package.
use Value, AgentTool, AnswerWords, Act, Ledger from "@agent-ui-kit/agent"
use Media, ListDetailItem, MailFolder, MailLetter, OnboardingAnswer, ShellRow, SettingsSection, SettingsScreenGroup, DashboardPeriod, DashboardItem, ChatTurn from "__SCOPE__/screens"
use MenuItem from "__SCOPE__/components"
use Fact, Message, Step, NavEntry, Setting, Stat, BarPoint from "__SCOPE__/blocks"

fn answerWords(): AnswerWords = AnswerWords(keep="Keep", undo="Undo", accept="Accept", reject="Reject", now="Now", stop="Stop")
// The newest change on any of the keys, said in one sentence; "" when there is none.
fn latestAbout(l: Ledger, keys: string[]): string = l.changes.filter(c => keys.includes(c.key)).slice(0, 1).map(c => c.sentence).join("")

// MediaViewer: an album of four pictures (each a small drawn placeholder, data only).
fn picture(fill: string): string = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2'%3E%3Crect width='3' height='2' fill='${fill}'/%3E%3C/svg%3E`
fn album(): Media[] = [
  Media(key="harbour", src=picture("steelblue"), caption="Harbour lights at dusk"),
  Media(key="tram", src=picture("goldenrod"), caption="Tram 28 on the hill"),
  Media(key="tiles", src=picture("teal"), caption="Blue tiles on a doorway"),
  Media(key="river", src=picture("slategray"), caption="The river at noon")
]
fn albumKeys(): string[] = album().map(m => m.key)
fn captionOf(key: string): string = album().filter(m => m.key == key).map(m => m.caption).join("")
// The key `by` steps from `key`, held at the album's ends.
fn stepAt(key: string, by: number): number = max(0, min(albumKeys().length - 1, albumKeys().indexOf(key) + by))
fn stepKey(key: string, by: number): string = albumKeys().slice(stepAt(key, by), stepAt(key, by) + 1).join("")
fn pictureAct(key: string): Act = Act(tool="showPicture", door="agent", key="picture", title="Picture", value=key, did=`Your assistant showed ${captionOf(key)}.`, asks=`Your assistant suggests showing ${captionOf(key)}.`, will=`Your assistant will show ${captionOf(key)} in 5 seconds.`)

// MailScreen: a small inbox. Each message's flag is a value in the ledger (`flag-<key>`, on or off); the open
// message is m2 (which message is open is the person's view, not a value).
fn mailBase(): Message[] = [
  Message(key="m1", from="Priya Nair", subject="Design review notes", snippet="Three small changes before we cut the release.", when="09:41", unread=true, flagged=false, href="/"),
  Message(key="m2", from="Jonas Weber", subject="Q3 report is ready to file", snippet="The numbers are reconciled and wait on your sign-off.", when="08:15", unread=false, flagged=false, href="/"),
  Message(key="m3", from="Maya Okafor", subject="Lunch on Thursday?", snippet="A new place two streets down, with a table for eight.", when="Wed 14:05", unread=true, flagged=false, href="/"),
  Message(key="m4", from="Sam Delacroix", subject="Fwd: the venue contract", snippet="Flagging this one before the deposit is due.", when="Mon 16:20", unread=false, flagged=false, href="/")
]
fn mailKeys(): string[] = mailBase().map(m => m.key)
fn flagKey(key: string): string = `flag-${key}`
fn flagKeys(): string[] = mailKeys().map(k => flagKey(k))
fn mailSubject(key: string): string = mailBase().filter(m => m.key == key).map(m => m.subject).join("")
fn mailFolders(): MailFolder[] = [
  MailFolder(key="inbox", label="Inbox", href="/", group="", count=2),
  MailFolder(key="flagged", label="Flagged", href="/", group="", count=0),
  MailFolder(key="sent", label="Sent", href="/", group="", count=0),
  MailFolder(key="receipts", label="Receipts", href="/", group="Folders", count=0)
]
fn mailLetter(): MailLetter = MailLetter(key="m2", from="Jonas Weber", address="jonas.weber@studio.example", to="Ada Lovelace", when="Today, 08:15", subject="Q3 report is ready to file", body="Hi Ada,\nThe numbers are reconciled and the summary page waits on your sign-off before Friday.\nJonas")
fn flagAct(key: string, on: bool): Act = Act(tool="flagMessage", door="agent", key=flagKey(key), title="Flag", value=(on ? "on" : "off"), did=`Your assistant ${on ? "flagged" : "unflagged"} ${mailSubject(key)}.`, asks=`Your assistant suggests ${on ? "flagging" : "unflagging"} ${mailSubject(key)}.`, will=`Your assistant will ${on ? "flag" : "unflag"} ${mailSubject(key)} in 5 seconds.`)

// ListDetail: three projects; the one open is a value in the ledger, by key. Each project's facts are data only.
fn projects(): ListDetailItem[] = [
  ListDetailItem(key="atlas", title="Atlas rebrand", detail="Identity, signage and the new site", status="In review", href=""),
  ListDetailItem(key="harbour", title="Harbour cafés spring campaign", detail="Posters, ferry film and a printed map", status="In progress", href=""),
  ListDetailItem(key="north", title="North Line timetable", detail="Print and screen editions", status="Scheduled", href="")
]
fn projectKeys(): string[] = projects().map(p => p.key)
fn projectTitle(key: string): string = projects().filter(p => p.key == key).map(p => p.title).join("")
fn projectFacts(key: string): Fact[] = key == "atlas" ? [Fact(key="owner", label="Owner", value="Maya Okafor"), Fact(key="launch", label="Launch", value="April 2")] : key == "north" ? [Fact(key="owner", label="Owner", value="Jonas Weber"), Fact(key="launch", label="Launch", value="May 18")] : [Fact(key="owner", label="Owner", value="Priya Nair"), Fact(key="launch", label="Launch", value="March 7")]
fn projectAct(key: string): Act = Act(tool="openProject", door="agent", key="project", title="Project", value=key, did=`Your assistant opened ${projectTitle(key)}.`, asks=`Your assistant suggests opening ${projectTitle(key)}.`, will=`Your assistant will open ${projectTitle(key)} in 5 seconds.`)

// OnboardingScreen: a three-step workspace setup. The step the person is on is a value in the ledger
// (`setup-step`, by key), and so is each answer (`setup-<key>`), so the person's typing and the agent's fillAnswer
// write the same value; an answer the agent wrote stays marked on its field until the person types over it.
fn setupSteps(): Step[] = [
  Step(key="workspace", title="Name your workspace", state="next"),
  Step(key="team", title="Size your team", state="next"),
  Step(key="invite", title="Invite people", state="next")
]
fn setupStepKeys(): string[] = setupSteps().map(s => s.key)
fn setupStepsAt(at: string): Step[] = setupSteps().map((s, i) => Step(s, state=(i < setupStepKeys().indexOf(at) ? "done" : i == setupStepKeys().indexOf(at) ? "current" : "next")))
// The step key `by` steps from `at`, held at the setup's ends.
fn setupStepAt(at: string, by: number): number = max(0, min(setupStepKeys().length - 1, setupStepKeys().indexOf(at) + by))
fn setupStepFrom(at: string, by: number): string = setupStepKeys().slice(setupStepAt(at, by), setupStepAt(at, by) + 1).join("")
// Each step's answers, empty: the ledger holds their values.
fn setupAnswers(): OnboardingAnswer[] = [
  OnboardingAnswer(key="workspace", label="Workspace name", hint="People see this when you invite them.", value="", placeholder="Your team or company", error="", byAgent=false),
  OnboardingAnswer(key="role", label="Your role", hint="It sets the layout you start with.", value="", placeholder="What you do", error="", byAgent=false),
  OnboardingAnswer(key="size", label="Team size", hint="A rough number is fine.", value="", placeholder="For example, 12", error="", byAgent=false),
  OnboardingAnswer(key="invite", label="Invite by email", hint="Separate addresses with commas.", value="", placeholder="name@example.com", error="", byAgent=false)
]
fn setupAnswerKeys(): string[] = setupAnswers().map(a => a.key)
fn setupStepOf(answer: string): string = answer == "workspace" or answer == "role" ? "workspace" : answer == "size" ? "team" : "invite"
fn setupKey(answer: string): string = `setup-${answer}`
fn setupKeys(): string[] = setupAnswerKeys().map(k => setupKey(k))
fn setupLabel(answer: string): string = setupAnswers().filter(a => a.key == answer).map(a => a.label).join("")
fn answerAct(answer: string, value: string): Act = Act(tool="fillAnswer", door="agent", key=setupKey(answer), title=setupLabel(answer), value=value, did=`Your assistant filled in ${setupLabel(answer)}: ${value}.`, asks=`Your assistant suggests ${value} for ${setupLabel(answer)}.`, will=`Your assistant will fill in ${setupLabel(answer)} in 5 seconds.`)
// AppShell: a console's projects under its search. The search's words are a value in the ledger, so the field,
// the rows it keeps and the agent's mark all read it; the phone's menu is the person's view, not a value.
fn shellPages(): ShellRow[] = [
  ShellRow(key="aurora", title="Aurora desk lamp", detail="Production · due Dec 4 · Maya Okafor", href="/"),
  ShellRow(key="spring", title="Spring launch: retail", detail="Planning · 12 tasks open · Jonas Weber", href="/"),
  ShellRow(key="audit", title="2024 audit archive", detail="Review · waiting on finance · Priya Nair", href="/"),
  ShellRow(key="harbour", title="Harbour signage", detail="Paused since March · Sam Rivera", href="/")
]
// The rows a search keeps: those whose title or detail hold its words, in any case.
fn shellFound(query: string): ShellRow[] = shellPages().filter(r => `${r.title} ${r.detail}`.toLowerCase().includes(query.trim().toLowerCase()))
fn shellEntries(): NavEntry[] = [
  NavEntry(key="projects", label="Projects", href="/", group="Workspace", badge=4, current=true),
  NavEntry(key="reports", label="Reports", href="/reports", group="Workspace", badge=0, current=false),
  NavEntry(key="team", label="Team", href="/team", group="People", badge=0, current=false)
]
fn shellSearchAct(text: string): Act = Act(tool="searchProjects", door="agent", key="shell-search", title="Search", value=text, did=(text.trim() == "" ? "Your assistant cleared the search." : `Your assistant searched the projects for “${text.trim()}”.`), asks=`Your assistant suggests searching the projects for “${text.trim()}”.`, will=`Your assistant will search the projects for “${text.trim()}” in 5 seconds.`)

// SettingsScreen: three sections of an account's settings. Which section is shown is the person's view (`settingsAt`
// in the app, navigation, not data); each switch is a value in the ledger (`settings-<key>`, on or off), so the
// switch, the agent's setSetting and the section's dot all read it. The other rows are data only.
fn settingsSections(): SettingsSection[] = [
  SettingsSection(key="account", label="Account", detail="Your name, the address we write to, and how you authenticate."),
  SettingsSection(key="notifications", label="Notifications", detail="What reaches you, and where."),
  SettingsSection(key="privacy", label="Privacy", detail="Who sees what you share.")
]
fn settingsSectionKeys(): string[] = settingsSections().map(s => s.key)
fn settingsSwitch(key: string, label: string, detail: string): Setting = Setting(key=key, kind="switch", label=label, detail=detail, value="", on=false)
fn settingsGroupsOf(section: string): SettingsScreenGroup[] = section == "account" ? [
  SettingsScreenGroup(key="profile", title="Profile", footer="People in your workspace see these.", rows=[
    Setting(key="name", kind="value", label="Name", detail="", value="Ada Lovelace", on=false),
    Setting(key="email", kind="value", label="Email", detail="", value="ada@studio.example", on=false),
    Setting(key="password", kind="link", label="Password", detail="Changed three months ago.", value="", on=false)
  ])
] : section == "privacy" ? [
  SettingsScreenGroup(key="sharing", title="Sharing", footer="Only people in your workspace.", rows=[
    settingsSwitch("presence", "Show when I am online", "A green dot beside your name."),
    settingsSwitch("receipts", "Read receipts", "Others see when you have read their message.")
  ])
] : [
  SettingsScreenGroup(key="email", title="Email", footer="Sent to the address on your account.", rows=[
    settingsSwitch("digest", "Weekly digest", "A summary of your week, each Monday."),
    settingsSwitch("mentions", "Mentions", "When someone names you in a comment."),
    settingsSwitch("news", "Product news", "")
  ]),
  SettingsScreenGroup(key="device", title="On this device", footer="Only this phone or computer.", rows=[
    Setting(key="sound", kind="value", label="Sound", detail="", value="Chime", on=false),
    Setting(key="quiet", kind="link", label="Quiet hours", detail="Nothing makes a sound from 22:00 to 07:00.", value="", on=false)
  ])
]
fn settingsSwitches(): Setting[] = settingsSectionKeys().map(s => settingsGroupsOf(s).map(g => g.rows.filter(r => r.kind == "switch"))).flat().flat()
fn settingsSwitchKeys(): string[] = settingsSwitches().map(r => r.key)
fn settingKey(key: string): string = `settings-${key}`
fn settingKeys(): string[] = settingsSwitchKeys().map(k => settingKey(k))
fn settingLabel(key: string): string = settingsSwitches().filter(r => r.key == key).map(r => r.label).join("")
fn settingSectionOf(key: string): string = settingsSectionKeys().filter(s => settingsGroupsOf(s).filter(g => g.rows.filter(r => r.key == key).length > 0).length > 0).join("")
fn settingAct(key: string, on: bool): Act = Act(tool="setSetting", door="agent", key=settingKey(key), title=settingLabel(key), value=(on ? "on" : "off"), did=`Your assistant turned ${settingLabel(key)} ${on ? "on" : "off"}.`, asks=`Your assistant suggests turning ${settingLabel(key)} ${on ? "on" : "off"}.`, will=`Your assistant will turn ${settingLabel(key)} ${on ? "on" : "off"} in 5 seconds.`)

// EntryScreen: the way in, terms before authentication. The step is a value in the ledger (`entry-step`: terms or
// authenticate), so the person's Accept and Back and the agent's openEntry move the same value. Opening the entry
// brings the person to the terms; accepting them and authenticating stay the person's own acts, so their tools are
// off (refused by the ledger, answering "off") and only the person's door moves the step on.
fn entryKeys(): string[] = ["entry-step"]
fn entryOpenAct(): Act = Act(tool="openEntry", door="agent", key="entry-step", title="Entry", value="terms", did="Your assistant opened the way in, at the terms.", asks="Your assistant suggests opening the way in, at the terms.", will="Your assistant will open the way in, at the terms, in 5 seconds.")
fn entryAcceptAct(): Act = Act(tool="acceptTerms", door="agent", key="entry-step", title="Terms", value="authenticate", did="Accepting the terms is yours to do; your assistant cannot do it.", asks="Accepting the terms is yours to do; your assistant cannot do it.", will="Accepting the terms is yours to do; your assistant cannot do it.")
fn entryAuthenticateAct(): Act = Act(tool="authenticate", door="agent", key="entry-authenticated", title="Authenticate", value="yes", did="Authenticating is yours to do; your assistant cannot do it.", asks="Authenticating is yours to do; your assistant cannot do it.", will="Authenticating is yours to do; your assistant cannot do it.")
// DashboardScreen: a shop's numbers for one period; the period shown is a value in the ledger, by key, so a
// Segment's tap and the agent's setPeriod write the same value. Each period's numbers are data only.
fn dashPeriods(): DashboardPeriod[] = [
  DashboardPeriod(key="week", label="Week"),
  DashboardPeriod(key="month", label="Month"),
  DashboardPeriod(key="quarter", label="Quarter"),
  DashboardPeriod(key="year", label="Year")
]
fn dashPeriodKeys(): string[] = dashPeriods().map(p => p.key)
fn dashPeriodWord(key: string): string = key == "week" ? "this week" : key == "month" ? "this month" : key == "quarter" ? "this quarter" : "the year"
fn dashAgainst(key: string): string = key == "week" ? "on last week" : key == "month" ? "on last month" : key == "quarter" ? "on last quarter" : "on last year"
fn dashStats(key: string): Stat[] = [
  Stat(key="revenue", label="Revenue", value=(key == "week" ? "$2,140" : key == "month" ? "$9,310" : key == "quarter" ? "$26,480" : "$91,870"), change=`+12.4% ${dashAgainst(key)}`, trend="up"),
  Stat(key="orders", label="Orders", value=(key == "week" ? "41" : key == "month" ? "176" : key == "quarter" ? "4,812" : "18,204"), change=`+4.1% ${dashAgainst(key)}`, trend="up"),
  Stat(key="aov", label="Average order value", value="$63.20", change=`-2.1% ${dashAgainst(key)}`, trend="down"),
  Stat(key="on-time", label="Fulfilled on time", value="96.4%", change="0.0%", trend="flat")
]
fn dashPoints(key: string): BarPoint[] = key == "week" ? [BarPoint(key="mon", label="Mon", value="5", share=0.5), BarPoint(key="tue", label="Tue", value="7", share=0.7), BarPoint(key="wed", label="Wed", value="6", share=0.6), BarPoint(key="thu", label="Thu", value="10", share=1), BarPoint(key="fri", label="Fri", value="8", share=0.8), BarPoint(key="sat", label="Sat", value="3", share=0.3), BarPoint(key="sun", label="Sun", value="2", share=0.2)] : key == "month" ? [BarPoint(key="w1", label="Week 1", value="38", share=0.79), BarPoint(key="w2", label="Week 2", value="44", share=0.92), BarPoint(key="w3", label="Week 3", value="48", share=1), BarPoint(key="w4", label="Week 4", value="46", share=0.96)] : key == "quarter" ? [BarPoint(key="apr", label="Apr", value="1,940", share=1), BarPoint(key="may", label="May", value="1,610", share=0.83), BarPoint(key="jun", label="Jun", value="1,350", share=0.7)] : [BarPoint(key="q1", label="Q1", value="4,860", share=1), BarPoint(key="q2", label="Q2", value="4,900", share=1), BarPoint(key="q3", label="Q3", value="4,310", share=0.88), BarPoint(key="q4", label="Q4", value="4,134", share=0.84)]
fn dashNote(key: string): string = key == "week" ? "Orders placed each day of this week" : key == "month" ? "Orders placed each week of this month" : key == "quarter" ? "Orders placed each month of this quarter" : "Orders placed each quarter of the year"
fn dashItems(): DashboardItem[] = [
  DashboardItem(key="o1048", title="Order 1048 · Priya Nair", detail="2 items · 4 minutes ago", trailing="$84.00", tone="none"),
  DashboardItem(key="o1047", title="Order 1047 · Jonas Weber", detail="1 item · 22 minutes ago", trailing="Paid", tone="success"),
  DashboardItem(key="o1046", title="Order 1046 · Maya Okafor", detail="3 items · 1 hour ago", trailing="Refunded", tone="cancelled")
]
fn periodAct(key: string): Act = Act(tool="setPeriod", door="agent", key="dash-period", title="Period", value=key, did=`Your assistant showed the numbers for ${dashPeriodWord(key)}.`, asks=`Your assistant suggests showing the numbers for ${dashPeriodWord(key)}.`, will=`Your assistant will show the numbers for ${dashPeriodWord(key)} in 5 seconds.`)

// ChatScreen: a conversation with an assistant. What the person has sent is one value in the ledger (`chat-log`, each
// message on its own line), so the person's Send and the agent's sendMessage write the same value and the turns
// follow from it; the text being typed is the person's view, not a value. Authenticating stays the person's own act:
// there is no tool for it.
fn chatBase(): ChatTurn[] = [
  ChatTurn(key="turn-1", author="You", text="Find us somewhere for dinner on Thursday. Two people, near Alfama, nothing too loud.", when="18:02", unread=false, href="/"),
  ChatTurn(key="turn-2", author="Atlas", text="Taberna da Rua has a table at 8pm. It is the quietest of three, with grilled fish and a small terrace.", when="18:02", unread=false, href="/")
]
fn chatLines(log: string): string[] = log == "" ? [] : log.split("\n")
fn chatAppend(log: string, text: string): string = log == "" ? text : `${log}\n${text}`
fn chatSettings(): MenuItem[] = [
  MenuItem(key="aloud", heading="", label="Read replies aloud", detail="", kind="toggle", on=false, enabled=true),
  MenuItem(key="brief", heading="Replies", label="Brief", detail="", kind="choice", on=true, enabled=true),
  MenuItem(key="detailed", heading="", label="Detailed", detail="", kind="choice", on=false, enabled=true)
]
fn chatAddItems(): MenuItem[] = [
  MenuItem(key="picture", heading="", label="Picture", detail="From this device", kind="act", on=false, enabled=true),
  MenuItem(key="file", heading="", label="File", detail="A document or a sheet", kind="act", on=false, enabled=true),
  MenuItem(key="place", heading="", label="Place", detail="A place on the map", kind="act", on=false, enabled=true)
]
fn chatAddFound(query: string): MenuItem[] = chatAddItems().filter(m => m.label.toLowerCase().includes(query.trim().toLowerCase()))
fn chatSendAct(log: string, text: string): Act = Act(tool="sendMessage", door="agent", key="chat-log", title="Message", value=chatAppend(log, text), did=`Your assistant sent “${text}” for you.`, asks=`Your assistant suggests sending “${text}”.`, will=`Your assistant will send “${text}” in 5 seconds.`)

// The app's one tool list: each tool's floor (a change only this person sees is recorded).
fn agentTools(): AgentTool[] = [
  AgentTool(name="showPicture", title="Album", sentence="Shows a picture of the album.", floor="recorded", reach="self", secret=false),
  AgentTool(name="openProject", title="Project", sentence="Opens a project beside the list.", floor="recorded", reach="self", secret=false),
  AgentTool(name="flagMessage", title="Flags", sentence="Flags or unflags a message.", floor="recorded", reach="self", secret=false),
  AgentTool(name="fillAnswer", title="Setup", sentence="Fills in an answer of the workspace setup.", floor="recorded", reach="self", secret=false),
  AgentTool(name="searchProjects", title="Search", sentence="Searches the projects.", floor="recorded", reach="self", secret=false),
  AgentTool(name="setSetting", title="Settings", sentence="Turns a setting on or off.", floor="recorded", reach="self", secret=false),
  AgentTool(name="openEntry", title="Entry", sentence="Opens the way in at its terms.", floor="recorded", reach="self", secret=false),
  // The person's own acts: off, so the ledger refuses them from the agent's door whatever mode a person chooses.
  AgentTool(name="acceptTerms", title="Terms", sentence="Accepts the terms for the person. Never allowed.", floor="off", reach="self", secret=false),
  AgentTool(name="authenticate", title="Authenticate", sentence="Authenticates the person. Never allowed: authenticating is the person's own act.", floor="off", reach="self", secret=false),
  AgentTool(name="setPeriod", title="Period", sentence="Shows the dashboard's numbers for another period.", floor="recorded", reach="self", secret=false),
  AgentTool(name="sendMessage", title="Messages", sentence="Sends a message in the conversation for the person.", floor="recorded", reach="self", secret=false)
]

fn startValues(): Value[] = [
  Value(key="picture", value="harbour"),
  Value(key="project", value="harbour")
].concat(flagKeys().map(k => Value(key=k, value="off"))).concat([Value(key="setup-step", value="workspace")]).concat(setupKeys().map(k => Value(key=k, value=""))).concat([Value(key="shell-search", value="")]).concat(settingKeys().map(k => Value(key=k, value=(k == "settings-news" or k == "settings-receipts" ? "off" : "on")))).concat([Value(key="entry-step", value="terms"), Value(key="entry-authenticated", value="no")]).concat([Value(key="dash-period", value="quarter")]).concat([Value(key="chat-log", value="")])
