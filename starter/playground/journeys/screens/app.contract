// Journeys: screens. Each screen in a small real use, so its two doors can be proved: a person's real input (a tap)
// and an agent's tool reach the same value in the app's ledger (`book`, @agent-ui-kit/agent), and the agent's is
// recorded and shown on the screen. `bun <kit>/tools/both-doors.mjs . web --only "MediaViewer: "` runs one
// screen's cases from both-doors.json.
//
// A screen fills the window, so one shows at a time: `shown` names it, MediaViewer first. A screen adds: its
// name to openScreen's enum (tools.contract), its values in model.contract (startValues, a row in agentTools with its
// floor, its words), the person's door here (actions that call personSet), the agent's door in tools.contract (an
// action that calls act) with a `tool` line below and a face in app.json, a branch in the view, and its cases,
// named "<Screen>: …", each side starting with `call openScreen {"screen":"<Screen>"}` (the first needs none).
// Keys in the ledger are unique in this app; a screen's own view state stays out of it.
//
// Members files: tools.contract (the agent's door), model.contract (words, the tool list, start values).
use Ledger, ledger, personSet, valueOf, isOn, isMarked, undoLatest, answerKey, waitingId, waitingSentence from "@agent-ui-kit/agent"
use MediaViewer, Media, ListDetail, MailScreen, OnboardingScreen, OnboardingAnswer, AppShell, SettingsScreen, SettingsScreenGroup, EntryScreen, DashboardScreen, ProfileScreen, ProfileDetail, SearchScreen from "__SCOPE__/screens"
use Words from "__SCOPE__/components"
use Message, Setting from "__SCOPE__/blocks"
use startValues, agentTools, answerWords, latestAbout, album, albumKeys, stepKey, projects, projectFacts, mailBase, mailKeys, flagKey, flagKeys, mailFolders, mailLetter, setupStepsAt, setupStepKeys, setupStepFrom, setupAnswers, setupStepOf, setupKey, setupKeys, shellFound, shellEntries, settingsSections, settingsGroupsOf, settingsSwitches, settingsSwitchKeys, settingKey, settingKeys, settingSectionOf, dashPeriods, dashStats, dashPoints, dashNote, dashItems, profileBase, profileDetailKeys, profileKey, profileKeys, profileProblem, profileMessage, profileSettings, profilePicture, searchFilters, searchValue, searchKindIn, searchDateIn, searchTextIn, searchFound, searchCount, searchScope from "./model.contract"

component App
  members "./tools.contract"

  state book: Ledger = ledger(startValues(), agentTools(), answerWords())
  // Which screen fills the window (navigation, not data: no ledger, no record).
  state shown = "MediaViewer"

  // MediaViewer: an album; the picture shown is a value in the ledger, by key.
  derive pictureKey = valueOf(book, "picture")
  derive pictureIndex = albumKeys().indexOf(pictureKey)
  derive albumText = album().map(m => `${m.key}\t${m.caption}${m.key == pictureKey ? "\tshown" : ""}`).join("\n")

  // MailScreen: an inbox; each message's flag is a value in the ledger, so the rows, the open message's Flag and
  // the agent's mark all read it.
  derive mailMessages = mailBase().map(m => Message(m, flagged=isOn(book, flagKey(m.key))))
  derive mailMarkedKey = mailKeys().filter(k => isMarked(book, flagKey(k))).slice(0, 1).join("")
  derive mailText = mailMessages.map(m => `${m.key}\t${m.from}\t${m.subject}${m.flagged ? "\tflagged" : ""}${m.key == mailLetter().key ? "\topen" : ""}`).join("\n")

  // The person's door: Previous, Next and a thumbnail all choose a picture by key.
  action previousByPerson
    book = personSet(book, "picture", stepKey(valueOf(book, "picture"), -1))
  action nextByPerson
    book = personSet(book, "picture", stepKey(valueOf(book, "picture"), 1))
  action chooseByPerson(key: string)
    book = personSet(book, "picture", key)
  // The person's door on MailScreen: Flag on the open message turns its flag on or off.
  action flagByPerson
    book = personSet(book, flagKey(mailLetter().key), isOn(book, flagKey(mailLetter().key)) ? "off" : "on")
  action undoByPerson
    book = undoLatest(book)
  // ListDetail: the project open beside the list is a value in the ledger, by key. On a phone the list or the
  // detail fills the window (`opened`: navigation, not data, so no ledger and no record).
  state opened = false
  derive projectKey = valueOf(book, "project")
  derive projectsText = projects().map(p => `${p.key}\t${p.title}${p.key == projectKey ? "\topen" : ""}`).join("\n")
  // The person's door: a tap on a row opens its project by key; Back shows the list on a phone.
  action openProjectByPerson(key: string)
    book = personSet(book, "project", key)
    opened = true
  action backByPerson
    opened = false

  // OnboardingScreen: a workspace setup; the step the person is on and every answer are values in the ledger, so
  // the fields, the step list and the agent's marks all read them. Its answers are this step's, filled from it.
  derive setupStep = valueOf(book, "setup-step")
  derive setupAt = setupStepKeys().indexOf(setupStep)
  derive setupFields = setupAnswers().filter(a => setupStepOf(a.key) == setupStep).map(a => OnboardingAnswer(a, value=valueOf(book, setupKey(a.key)), byAgent=isMarked(book, setupKey(a.key))))
  derive setupMarked = setupKeys().filter(k => isMarked(book, k)).length > 0
  derive setupText = [`step\t${setupStep}`].concat(setupAnswers().map(a => `${a.key}\t${a.label}\t${valueOf(book, setupKey(a.key))}${isMarked(book, setupKey(a.key)) ? "\tfilled by you" : ""}`)).join("\n")
  // The person's door: typing in a field writes its answer; Continue, Skip and Back move the step by key.
  action answerByPerson(key: string, value: string)
    book = personSet(book, setupKey(key), value)
  action continueByPerson
    book = personSet(book, "setup-step", setupStepFrom(valueOf(book, "setup-step"), 1))
  action setupBackByPerson
    book = personSet(book, "setup-step", setupStepFrom(valueOf(book, "setup-step"), -1))
  // AppShell: the search's words are a value in the ledger, by key; the rows it keeps follow. The phone's menu is
  // the person's view (`menuOpen`: navigation, not data, so no ledger and no record).
  state menuOpen = false
  derive shellQuery = valueOf(book, "shell-search")
  derive shellRows = shellFound(shellQuery)
  derive shellText = shellRows.map(r => `${r.key}\t${r.title}\t${r.detail}`).join("\n")
  // The person's door: what they type in the search; the menu button and the scrim open and close the sheet.
  action searchByPerson(text: string)
    book = personSet(book, "shell-search", text)
  action openMenuByPerson
    menuOpen = true
  action closeMenuByPerson
    menuOpen = false

  // SettingsScreen: an account's settings. The section shown is the person's view (navigation, not data: no
  // ledger, no record); each switch is a value in the ledger, so the switch, the section's dot and the agent's mark
  // all read it.
  state settingsAt = "notifications"
  derive settingsGroups = settingsGroupsOf(settingsAt).map(g => SettingsScreenGroup(g, rows=g.rows.map(r => r.kind == "switch" ? Setting(r, on=isOn(book, settingKey(r.key))) : r)))
  derive settingsMarkedKey = settingsSwitchKeys().filter(k => isMarked(book, settingKey(k))).slice(0, 1).join("")
  derive settingsText = [`section\t${settingsAt}`].concat(settingsSwitches().map(r => `${r.key}\t${settingSectionOf(r.key)}\t${r.label}\t${isOn(book, settingKey(r.key)) ? "on" : "off"}`)).join("\n")
  // The person's door: a place in the list shows its section; a switch turns its setting on or off.
  action pickSectionByPerson(key: string)
    settingsAt = key
  action toggleSettingByPerson(key: string)
    book = personSet(book, settingKey(key), isOn(book, settingKey(key)) ? "off" : "on")

  // EntryScreen: the way in, terms before authentication. The step is a value in the ledger (`entry-step`), so the
  // person's Accept and Back and the agent's openEntry move the same value; the agent's acceptTerms and authenticate are
  // off in the tool list, so only the person's door moves it on. While the agent's openEntry stands in the record,
  // the screen says that the assistant brought the person here and waits for their own acts.
  derive entryStep = valueOf(book, "entry-step")
  derive entryOpenedByAgent = book.changes.filter(c => c.tool == "openEntry").length > 0
  // The person's door: Accept takes the terms and moves on to the way in; Back returns to the terms.
  action acceptTermsByPerson
    book = personSet(book, "entry-step", "authenticate")
  action entryBackByPerson
    book = personSet(book, "entry-step", "terms")
  // DashboardScreen: a shop's numbers; the period shown is a value in the ledger, by key, so the Segments, the
  // numbers and the agent's mark all read it.
  derive dashPeriod = valueOf(book, "dash-period")
  derive dashText = dashPeriods().map(p => `${p.key}\t${p.label}${p.key == dashPeriod ? "\tshown" : ""}`).join("\n")
  // The person's door: a tap on a period's Segment shows it, by key.
  action choosePeriodByPerson(key: string)
    book = personSet(book, "dash-period", key)

  // ProfileScreen: the person's own details, each a value in the ledger, so the rows, the person's Save and the
  // agent's mark all read it. Which row is open and what the person has typed are the person's view (no ledger,
  // no record) until Save writes the value; a refused Save keeps the draft and says why, in the sentence of the word
  // the agent's tool would answer.
  state profileEditing = ""
  state profileOpen = false
  state profileDraft = ""
  state profileOutcome = "none"
  state profileProblemWord = ""
  state sessionEnded = false
  derive profileDetails = profileBase().map(d => ProfileDetail(d, value=valueOf(book, profileKey(d.key))))
  derive profileWaitKey = profileDetailKeys().filter(k => waitingId(book, profileKey(k)) != "").slice(0, 1).join("")
  derive profileMarkedKey = profileDetailKeys().filter(k => isMarked(book, profileKey(k))).slice(0, 1).join("")
  derive profileAgent = profileWaitKey != "" ? "proposed" : profileMarkedKey != "" ? "changed" : "none"
  derive profileText = profileDetails.map(d => `${d.key}\t${d.label}\t${d.value}${waitingId(book, profileKey(d.key)) != "" ? "\twaiting for the person" : isMarked(book, profileKey(d.key)) ? "\tchanged by you" : ""}`).join("\n")
  // The person's door: Edit opens a row with its saved value; the field writes the draft; Save writes the value or
  // keeps the draft and says why; Cancel closes the row; Accept and Not now answer the agent's proposal.
  action editDetailByPerson(key: string)
    profileEditing = key
    profileOpen = true
    profileDraft = valueOf(book, profileKey(key))
    profileOutcome = "none"
    profileProblemWord = ""
  action typeDetailByPerson(value: string)
    profileDraft = value
  action saveDetailByPerson
    let word = profileProblem(profileEditing, profileDraft)
    profileProblemWord = word
    profileOutcome = word == "" ? "success" : "error"
    profileOpen = word != ""
    book = word == "" ? personSet(book, profileKey(profileEditing), profileDraft.trim()) : book
  action cancelDetailByPerson
    profileOpen = false
    profileOutcome = "none"
    profileProblemWord = ""
  action acceptDetailByPerson
    book = answerKey(book, profileKey(profileWaitKey), true, "person")
  action rejectDetailByPerson
    book = answerKey(book, profileKey(profileWaitKey), false, "person")
  // Ending the session is the person's own act: no tool reaches it.
  action endSessionByPerson
    sessionEnded = true

  // SearchScreen: the whole search (kind, date, words) is one value in the ledger, so the field, the Segments, the
  // results and the agent's mark all read it, and the agent's runSearch writes the same value.
  derive searchNow = valueOf(book, "search")
  derive searchKind = searchKindIn(searchNow)
  derive searchDate = searchDateIn(searchNow)
  derive searchQuery = searchTextIn(searchNow)
  derive searchResults = searchFound(searchNow)
  derive searchAgent = waitingId(book, "search") != "" ? "proposed" : isMarked(book, "search") ? "changed" : "none"
  derive searchText = [`kind\t${searchKind}`, `date\t${searchDate}`, `words\t${searchQuery}`].concat(searchResults.map(r => `${r.key}\t${r.title}\t${r.place}`)).join("\n")
  // The person's door: each change in the field, a Segment's press by key, and the empty state's way on.
  action searchTypeByPerson(text: string)
    book = personSet(book, "search", searchValue(searchKindIn(valueOf(book, "search")), searchDateIn(valueOf(book, "search")), text))
  action searchKindByPerson(key: string)
    book = personSet(book, "search", searchValue(key, searchDateIn(valueOf(book, "search")), searchTextIn(valueOf(book, "search"))))
  action searchDateByPerson(key: string)
    book = personSet(book, "search", searchValue(searchKindIn(valueOf(book, "search")), key, searchTextIn(valueOf(book, "search"))))
  action searchClearFiltersByPerson
    book = personSet(book, "search", searchValue("all", "any", searchTextIn(valueOf(book, "search"))))
  action searchClearByPerson
    book = personSet(book, "search", searchValue(searchKindIn(valueOf(book, "search")), searchDateIn(valueOf(book, "search")), ""))
  action searchAcceptByPerson
    book = answerKey(book, "search", true, "person")
  action searchRejectByPerson
    book = answerKey(book, "search", false, "person")

  // A retry and a proposal's answers: this use has none.
  action ignore
    book = book
  action ignoreKey(key: string)
    book = book

  // The agent's door. Answer words: saved, delayed, proposed, off, unknown-id.
  tool openScreen writes idempotent closed "Show one screen of these journeys: MediaViewer, ListDetail, MailScreen, OnboardingScreen, AppShell, SettingsScreen, EntryScreen, DashboardScreen, ProfileScreen or SearchScreen. Answers its name." = openScreen
    returns shown
  tool readAlbum reads "The album's pictures, one per line: id, caption, and shown on the one on screen, tab-separated." = readAlbum
    returns albumText
  tool showPicture writes idempotent closed "Show a picture of the album, by id from readAlbum. Answers saved or unknown-id." = showPicture
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"
  tool readMail reads "The inbox's messages, one per line: id, sender, subject, then flagged and open where they are, tab-separated." = readMail
    returns mailText
  tool flagMessage writes idempotent closed "Flag or unflag a message, by id from readMail. Answers saved or unknown-id." = flagMessage
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"
  tool readProjects reads "The projects, one per line: id, title, and open on the one shown beside the list, tab-separated." = readProjects
    returns projectsText
  tool openProject writes idempotent closed "Open a project beside the list, by id from readProjects. Answers saved or unknown-id." = openProject
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"
  tool readSetup reads "The workspace setup: the step the person is on (workspace, team or invite), then each answer, one per line: id, label, value, and filled by you where you wrote it, tab-separated." = readSetup
    returns setupText
  tool fillAnswer writes idempotent closed "Fill in an answer of the workspace setup, by id from readSetup, with the value to write. Answers saved or unknown-id." = fillAnswer
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"
  tool readSettings reads "The settings: first the section shown (account, notifications or privacy), then each setting that turns on or off, one per line: id, section, label, on or off, tab-separated." = readSettings
    returns settingsText
  tool showSettingsSection writes idempotent closed "Show a section of the settings: account, notifications or privacy. Answers its id." = showSettingsSection
    returns settingsAt
  tool setSetting writes idempotent closed "Turn a setting on or off, by id from readSettings. Answers saved or unknown-id." = setSetting
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"

  tool readProjectList reads "The projects the console's search keeps, one per line: id, title and detail, tab-separated." = readProjectList
    returns shellText
  tool searchProjects writes idempotent closed "Search the console's projects by words in their title or detail; empty text clears the search. Answers saved." = searchProjects
    returns book.answer
    fails when book.answer == "off"
  tool readPeriods reads "The dashboard's periods, one per line: id, label, and shown on the one on screen, tab-separated." = readPeriods
    returns dashText
  tool setPeriod writes idempotent closed "Show the dashboard's numbers for a period, by id from readPeriods. Answers saved or unknown-id." = setPeriod
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off"

  tool readEntry reads "The way in: the step the person is on, terms or authenticate. Accepting the terms and authenticating are the person's own." = readEntry
    returns entryStep
  tool openEntry writes idempotent closed "Open the way in at its terms, for the person to accept them and authenticate. Answers saved." = openEntry
    returns book.answer
    fails when book.answer == "off"
  tool acceptTerms writes idempotent closed "Accept the terms for the person. Always refused: accepting the terms is the person's own act. Answers off." = acceptTerms
    returns book.answer
    fails when book.answer == "off"
  tool authenticate writes idempotent closed "Authenticate the person. Always refused: authenticating (the face check or passkey) is the person's own act. Answers off." = authenticate
    returns book.answer
    fails when book.answer == "off"

  tool readProfile reads "The person's profile, one detail per line: id (name, email, phone or language), label, value, then waiting for the person or changed by you where you acted, tab-separated. Ending the session and authenticating are the person's own." = readProfile
    returns profileText
  tool changeDetail writes idempotent closed "Change a detail of the person's profile, by id from readProfile, to a new value; it waits until the person accepts on the screen. Answers proposed, unknown-id, empty, not-an-address, no-country-code or unknown-language." = changeDetail
    returns book.answer
    fails when book.answer == "unknown-id" or book.answer == "off" or book.answer == "empty" or book.answer == "not-an-address" or book.answer == "no-country-code" or book.answer == "unknown-language"

  tool readSearch reads "The search on the search screen: its kind, its date and its words, then each result it finds, one per line: id, title and where it lives, tab-separated. Kinds: all, pages, files, people; dates: any, week, month." = readSearch
    returns searchText
  tool runSearch writes idempotent closed "Search the workspace's pages, files and people for words, narrowed by kind (all, pages, files or people) and by when each last changed (any, week or month); it shows the search screen with the results. Empty text shows all of that kind and date. Answers saved or unknown-filter." = runSearch
    returns book.answer
    fails when book.answer == "unknown-filter" or book.answer == "off"

  view
    main testId="app" width="100%" height="100%"
      if shown == "MediaViewer"
        MediaViewer(title="Lisbon in spring", positionText=`${pictureIndex + 1} of ${albumKeys().length}`, previousLabel="Previous", nextLabel="Next", stripTitle="In this album", loadingText="", failedText="", retryLabel="", proposedNote="", acceptLabel="", rejectLabel="", changedNote=latestAbout(book, ["picture"]), undoLabel="Undo", currentKey=pictureKey, items=album(), data="many", agent=(isMarked(book, "picture") ? "changed" : "none"), previous=previousByPerson, next=nextByPerson, choose=chooseByPerson, retry=ignore, accept=ignore, reject=ignore, undo=undoByPerson)
      else if shown == "ListDetail"
        ListDetail(title="Studio", listTitle="Projects", loadingText="", detailLoadingText="", emptyText="", createLabel="", failedText="", retryLabel="", backLabel="Projects", pickText="Choose a project to see its details.", factsTitle="Details", factsEmptyText="No details yet.", notesTitle="Notes", activityTitle="Activity", activityEmptyText="No activity yet.", primaryLabel="Edit project", secondaryLabel="Share", proposedNote="", acceptLabel="", rejectLabel="", proposedMark="", changedNote=latestAbout(book, ["project"]), changedMark="Opened by your assistant", undoLabel="Undo", chosenKey=projectKey, items=projects(), facts=projectFacts(projectKey), notes="", events=[], data="many", agent=(isMarked(book, "project") ? "changed" : "none"), pane=(opened ? "detail" : "list"), primaryPress=ignore, secondaryPress=ignore, back=backByPerson, choose=openProjectByPerson, create=ignore, retry=ignore, accept=ignore, reject=ignore, undo=undoByPerson)
      else if shown == "MailScreen"
        MailScreen(title="Mail", mark="M", navLabel="Mailboxes", foldersTitle="Mailboxes", folderTitle="Inbox", accountName="Ada Lovelace", accountDetail="ada@studio.example", composeLabel="Compose", backLabel="Back to", unreadLabel="unread", orderLabel="Newest first", paneLabel="Open message", paneEmptyText="Choose a message to read it here.", paneQuietText="When a message arrives, it opens here.", emptyText="No messages in your inbox.", failedText="Your messages did not load.", retryLabel="Try again", toolbarLabel="Message actions", toLabel="To", replyLabel="Reply", replyAllLabel="Reply all", forwardLabel="Forward", flagLabel="Flag", agentNote="Flagged by your assistant", proposedNote="", acceptLabel="", rejectLabel="", changedNote=latestAbout(book, flagKeys()), undoLabel="Undo", waitingNote="", waitingLabel="", folders=mailFolders(), folderKey="inbox", messages=mailMessages, letter=mailLetter(), agentKey=mailMarkedKey, data="many", agent=(mailMarkedKey != "" ? "changed" : "none"), which="message", compose=ignore, retry=ignore, reply=ignore, replyAll=ignore, forward=ignore, flag=flagByPerson, showFolders=ignore, showList=ignore, accept=ignore, reject=ignore, undo=undoByPerson, review=ignore)
      else if shown == "OnboardingScreen"
        OnboardingScreen(productName="Northwind", exitLabel="Save and exit", steps=setupStepsAt(setupStep), answers=setupFields, lead="A few details to set your workspace up. You can change any of them later.", countLabel="Setup progress", backLabel="Back", continueLabel="Continue", skipLabel="Skip for now", retryLabel="", errorText="", loadingText="", failedText="", listTitle="Your setup", listNote="Your answers are saved as you go. Leave at any time and pick up where you stopped.", doneWord="done", currentWord="in progress", nextWord="to come", markNote="Filled in by your assistant", proposedNote="", acceptLabel="", rejectLabel="", waitingNote="", data="many", interaction="idle", outcome="none", agent=(setupMarked ? "changed" : "none"), exit=ignore, back=setupBackByPerson, advance=continueByPerson, skip=continueByPerson, retry=ignore, accept=ignore, reject=ignore, edit=answerByPerson)
      else if shown == "AppShell"
        AppShell(title="Projects", searchLabel="Search projects", searchText=shellQuery, actionLabel="New project", menuLabel="Open the menu", closeLabel="Close the menu", productName="Acme Console", productMark="AC", navLabel="Main menu", entries=shellEntries(), accountName="Ada Lovelace", accountDetail="Workspace admin", sectionTitle="Active projects", footer="Projects you have not opened for 90 days move to the archive.", rows=shellRows, emptyText=`No project holds “${shellQuery.trim()}”. Clear the search or start a new project.`, loadingText="", failedText="", retryLabel="", proposedNote="", acceptLabel="", rejectLabel="", changedNote=latestAbout(book, ["shell-search"]), markNote="", undoLabel="Undo", agentKey="", menuOpen=menuOpen, data=(shellRows.length == 0 ? "empty" : "many"), agent=(isMarked(book, "shell-search") ? "changed" : "none"), search=searchByPerson, act=ignore, openMenu=openMenuByPerson, closeMenu=closeMenuByPerson, retry=ignore, accept=ignore, reject=ignore, undo=undoByPerson)
      else if shown == "SettingsScreen"
        SettingsScreen(title="Settings", navLabel="Settings sections", currentKey=settingsAt, sections=settingsSections(), groups=settingsGroups, groupEmptyText="Nothing to set here yet.", loadingText="", emptyTitle="", emptyText="", addLabel="", failedTitle="", failedText="", retryLabel="", agentSection=settingSectionOf(settingsMarkedKey), agentKey=settingsMarkedKey, proposalText="", acceptLabel="", declineLabel="", changedText=latestAbout(book, settingKeys()), waitingText="", waitingNote="", undoLabel="Undo", data="many", agent=(settingsMarkedKey != "" ? "changed" : "none"), pick=pickSectionByPerson, toggle=toggleSettingByPerson, choose=ignoreKey, open=ignoreKey, remove=ignoreKey, accept=ignore, decline=ignore, retry=ignore, add=ignore, undo=undoByPerson)
      else if shown == "EntryScreen"
        EntryScreen(productName="Northwind", stepsLabel="Steps to get in", termsStepName="Terms", authStepName="Authenticate", termsTitle="Before you start", termsLead="Read Northwind's terms of service. Accepting them is yours to do, and comes before you authenticate.", termsFrameLabel="Northwind terms of service", acceptLabel="Accept and continue", declineLabel="Decline", authTitle="Authenticate to Northwind", authLead="Use the passkey on this device. Your face, fingerprint or screen lock stays on it.", acceptedNote="You accepted the terms.", backLabel="Read the terms again", choiceTitle="Passkey", choiceNote="This device asks for your face, fingerprint or screen lock.", choiceActionLabel="Authenticate with a passkey", outcomeText="", busyText="", agentNote="Your assistant opened this for you. Accepting the terms and authenticating are yours alone.", step=(entryStep == "authenticate" ? "authenticate" : "terms"), interaction="idle", outcome="none", agent=(entryOpenedByAgent ? "waiting" : "none"), accept=acceptTermsByPerson, decline=ignore, back=entryBackByPerson, authenticate=ignore)
          if entryStep == "terms"
            Words(text="Northwind terms of service: the relying party's own capture page takes this place in a real app.", kind="body", outcome="none", level=0, testId="entry-terms-page")
      else if shown == "DashboardScreen"
        DashboardScreen(title="Overview", periodLabel="Period", chartTitle="Orders", chartNote=dashNote(dashPeriod), chartLabel="Orders in the period", recentTitle="Recent orders", recentEmptyText="No orders yet.", allLabel="View all", loadingText="", chartLoadingText="", emptyText="", emptyLabel="", failedText="", retryLabel="", proposedNote="", acceptLabel="", rejectLabel="", changedNote=latestAbout(book, ["dash-period"]), undoLabel="Undo", periodKey=dashPeriod, periods=dashPeriods(), stats=dashStats(dashPeriod), points=dashPoints(dashPeriod), items=dashItems(), data="many", agent=(isMarked(book, "dash-period") ? "changed" : "none"), choose=choosePeriodByPerson, showAll=ignore, start=ignore, retry=ignore, accept=ignore, reject=ignore, undo=undoByPerson)
      else if shown == "ProfileScreen"
