// The screens' own sizes; shipping a design holds this package to Exact's library rules.
forma screens

theme
  screens.column-max: length = 720px
  screens.onboarding-max: length = 960px  // the frame's width, the gap and the list's basis, with a little slack
  screens.onboarding-main: length = 640px  // the frame's own readable width (OnboardingSteps caps there too)
  screens.onboarding-aside: length = 280px
  screens.onboarding-dot: length = 6px
  screens.onboarding-glyph: length = 24px
  screens.onboarding-ring: length = 2px
  screens.onboarding-tick: length = 12px
  screens.onboarding-title-top: length = 2px  // a body line (21px) centred on the 24px glyph
  screens.onboarding-ghost-line: length = 12px
  screens.onboarding-ghost-field: length = 36px
  screens.onboarding-mark-line: length = 3px
  screens.onboarding-alert: length = 16px
  screens.media-max: length = 812px  // the stage (780 wide inside lg padding) is then exactly 3:2 at its full height
  screens.media-stage-max: length = 520px  // the stage's height on a desktop: the picture, caption, a proposal and the strip fit a 900px window
  screens.media-caption-min: length = 240px  // under this the caption takes its own line and Previous and Next wrap under it
  screens.media-thumb: length = 64px
  screens.media-ring: length = 2px
  screens.media-mark-line: length = 3px
  screens.media-glyph: length = 24px
  screens.media-note-max: length = 420px
  screens.media-bone-caption: length = 240px
  screens.media-bone-line: length = 12px
  screens.media-action-min: length = 44px  // ActionButton's least height (components.row-min): the caption centres on Previous and Next
  screens.media-wait-glyph: length = 48px
  screens.shell-rail: length = 272px  // the desktop's rail: the SideNav's places and counts at one line, the page keeps the rest
  screens.shell-sheet: length = 304px  // the phone's sheet (never wider than the window less theme.space.xxl)
  screens.shell-page-max: length = 880px  // the page's measure on a desktop: rows that stay readable, centred in the room the rail leaves
  screens.shell-bar-min: length = 60px  // the bar's height: a 44px control and theme.space.sm above and below
  screens.shell-search: length = 280px
  screens.shell-title-min: length = 160px  // under this the bar's action wraps to its own line, so the title never squeezes
  screens.shell-action-max: length = 240px  // a long action label wraps inside this, never across the bar
  screens.shell-tap: length = 44px  // the menu button: the least target a finger gets
  screens.shell-glyph: length = 20px
  screens.shell-band-min: length = 240px  // under this the band's answers wrap under its sentence
  screens.shell-mark-line: length = 3px
  screens.shell-row-min: length = 64px  // a LinkRow with its detail: its least height, held while the rows load
  screens.shell-ghost-line: length = 10px
  screens.shell-ghost-title: length = 220px
  screens.shell-ghost-short: length = 160px
  screens.shell-ghost-detail: length = 120px
  screens.settings-max: length = 1120px  // the list's 224 and the section's readable 864, with the xxl between them
  screens.settings-nav: length = 224px  // the list's width on a desktop
  screens.settings-fold: length = 320px  // narrower than this the list is a rail (one place a line); wider, a row of pills (a phone's full width)
  screens.settings-main-min: length = 320px  // the section's least width: a phone's column (358 at 390) holds it
  screens.settings-main-max: length = 864px  // a group's title column and its card, each at a width that reads in one glance
  screens.settings-panel-max: length = 640px  // StatePanel's own full width, so its card is not centred away from the heading's edge
  screens.settings-measure: length = 560px  // the lead under the heading: near 70 characters of body type a line
  screens.settings-place-min: length = 40px
  screens.settings-dot: length = 6px
  screens.settings-spin: length = 14px
  screens.settings-aside: length = 200px  // SettingsGroup's own title column's least width, so a ghost wraps where a group does
  screens.settings-card-min: length = 320px  // SettingsGroup's own card's least width
  screens.settings-aside-top: length = 10px  // SettingsGroup's own title inset, so a ghost title stands where the title will
  screens.settings-bone: length = 12px
  screens.settings-bone-thick: length = 16px
  screens.settings-bone-title: length = 120px
  screens.settings-bone-note: length = 180px
  screens.mail-rail: length = 304px  // the folders' rail on a desktop: SideNav's own least width (blocks.nav-min), so it lays out on one line and runs to the foot
  screens.mail-pane-max: length = 760px  // a phone layout's column on a window between a phone and a desktop
  screens.mail-band-min: length = 240px  // under this a band's sentence takes its own line and the answers wrap under it
  screens.mail-mark-line: length = 3px  // the band's start edge: the kit's agent mark (components.mark-line)
  screens.mail-glyph: length = 16px
  screens.mail-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
  screens.mail-avatar: length = 40px
  screens.mail-tap: length = 44px  // Back's least height, ActionButton's own (components.row-min)
  screens.mail-card-max: length = 1100px  // MessageList's own card width (blocks.mail-max), so the actions' layer shares its edges
  screens.mail-head: length = 51px  // MessageList's header band under the card's top line (blocks.bar-min less its rule)
  screens.mail-badge-max: length = 160px  // MessageList's unread badge's own most width (blocks.badge-max)
  screens.list-detail-list-min: length = 280px  // the list column never narrows below this on a desktop
  screens.list-detail-list-max: length = 400px  // a third of a 1200px window; wider windows give the room to the detail
  screens.list-detail-max: length = 880px  // the detail's measure: DetailPanel's own, so the proposal above it shares its edges
  screens.list-detail-rail: length = 3px
  screens.list-detail-dot: length = 6px
  screens.list-detail-chevron: length = 12px
  screens.list-detail-ghost-row: length = 64px  // a real row's height: md paddings, a label line, xs, a caption line
  screens.list-detail-bone: length = 10px
  screens.list-detail-note-min: length = 200px  // under this the changed sentence takes its own line and Undo wraps under it
  screens.list-detail-state-top: length = 56px
  screens.list-detail-line: length = 21px  // one body line (15px at 1.4): the changed note's dot centres on it
  screens.entry-max: length = 640px  // the column on a desktop: the terms frame at a reading width, EntryChoice and the way back on its edges
  screens.entry-frame-min: length = 320px  // the terms frame's least height: on a short window the page scrolls, the frame keeps this
  screens.entry-action-min: length = 200px  // each of Decline and Accept keeps this: side by side on a desktop, one a line on a phone (two would break "Accept and continue")
  screens.entry-track: length = 4px  // a part of the step track
  screens.entry-tick: length = 12px  // the tick in the track, on a caption line
  screens.entry-glyph: length = 16px  // the clock of the agent's note, the tick beside the accepted note
  screens.entry-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
  screens.entry-mark-line: length = 3px  // the agent note's start edge: the kit's agent mark (components.mark-line)
  screens.entry-dot: length = 8px  // the busy cue's pulsing dot, on a caption line
  screens.entry-note-min: length = 200px  // the accepted note keeps this; narrower, the way back wraps under it
  screens.dashboard-max: length = 1008px  // the content's width on a wide window, centred: StatTiles' own 960px cap (blocks.stat-max) plus the page's two xl insets (24px each), so tiles and panels share their edges
  screens.dashboard-chart-min: length = 320px  // the chart and the list sit side by side once both least widths fit
  screens.dashboard-list-min: length = 280px
  screens.dashboard-head-min: length = 160px  // under this a card's title takes its own line and its end wraps under it
  screens.dashboard-item-min: length = 200px  // a recent row's title keeps this much; a longer trailing word wraps under it
  screens.dashboard-bone: length = 10px
  screens.dashboard-ghost-row: length = 64px  // a real row's height: md paddings, a body line, xs, a caption line
  screens.dashboard-band-min: length = 240px  // under this a band's sentence takes its own line and the answers wrap under it
  screens.dashboard-mark-line: length = 3px  // the band's start edge: the kit's agent mark (components.mark-line)
  screens.dashboard-glyph: length = 16px
  screens.dashboard-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
  screens.profile-max: length = 1072px  // SettingsGroup's own widest (blocks.settings-max, 1040) and the page's lg insets, so its pairs and the profile's share their edges
  screens.profile-aside: length = 200px  // a pair's side column's least width: SettingsGroup's own (blocks.settings-aside)
  screens.profile-main: length = 320px  // a pair's card's least width: SettingsGroup's own (blocks.settings-main)
  screens.profile-name-min: length = 160px  // under this the name takes its own line under the picture
  screens.profile-row-min: length = 52px  // a detail at rest: ValueRow's line and its Edit with xs above and below
  screens.profile-action-min: length = 44px  // ActionButton's least height (components.row-min): its bone in the skeleton
  screens.profile-mark-line: length = 3px  // the kit's agent mark at a row's start (components.mark-line)
  screens.profile-dot: length = 6px
  screens.profile-dot-top: length = 8px  // a 6px dot centred on the body type's first line (21px)
  screens.profile-glyph: length = 16px
  screens.profile-band-min: length = 200px  // under this a band's sentence takes its own line and its answers wrap under it
  screens.profile-busy-min: length = 160px  // under this the busy words take their own line over Cancel and Save
  screens.profile-session-min: length = 200px  // under this End session wraps under the session's words
  screens.profile-bone: length = 12px
  screens.profile-bone-thick: length = 20px
  screens.profile-bone-name: length = 180px
  screens.profile-bone-about: length = 120px
  screens.profile-bone-label: length = 64px
  screens.profile-bone-value: length = 140px
  screens.profile-bone-action: length = 96px
  screens.chat-max: length = 1100px  // MessageList's own card width (blocks.mail-max), so the composer shares the card's edges
  screens.chat-text-min: length = 220px  // the text keeps this beside mic, plus and send; narrower, they wrap under it
  screens.chat-field-max: length = 160px  // the text grows with its lines up to this, then scrolls inside
  screens.chat-action: length = 44px  // ActionButton's least height (components.row-min): the reply's line centres on Stop
  screens.chat-band-min: length = 240px  // under this a band's sentence takes its own line and the answers wrap under it
  screens.chat-mark-line: length = 3px  // the band's start edge: the kit's agent mark (components.mark-line)
  screens.chat-glyph: length = 16px
  screens.chat-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
  screens.chat-dot: length = 6px
  screens.chat-compose-max: length = 240px  // the pasted pieces and the text grow to this, then scroll inside, so the messages keep their room
  screens.chat-action-max: length = 200px  // a long button label wraps inside this, never across the composer or the bar
  screens.chat-bubble-max: length = 560px  // a bubble's widest: near 70 characters of body type, so a long turn reads as lines, not a banner
  screens.chat-gutter: length = 48px  // the far side's room beside a bubble, so the person's and the agent's never share an edge
  screens.chat-ghost: length = 40px  // a one-line bubble's height while it loads (sm, a body line, sm, the line round it)
  screens.chat-ghost-tall: length = 61px  // a two-line bubble's height while it loads
  screens.chat-ghost-when: length = 40px
  screens.chat-ghost-line: length = 10px
  screens.chat-state-glyph: length = 32px
