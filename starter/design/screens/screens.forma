// The screens' own sizes; shipping a design holds this package to Exact's library rules.
forma screens

theme
  screens.column-max: length = 720px
  screens.media-max: length = 812px  // the stage (780 wide inside lg padding) is then exactly 3:2 at its full height
  screens.media-stage-max: length = 520px  // the stage's height on a desktop: the picture, caption, a proposal and the strip fit a 900px window
  screens.media-caption-min: length = 240px  // under this the caption takes its own line and Previous and Next wrap under it
  screens.media-thumb: length = 64px
  screens.media-ring: length = 2px
  screens.media-mark-line: length = 3px
  screens.media-glyph: length = 24px
  screens.media-note-max: length = 420px
  screens.media-bone-caption: length = 240px
  screens.media-bone-line: length = 12px
  screens.media-action-min: length = 44px  // ActionButton's least height (components.row-min): the caption centres on Previous and Next
  screens.media-wait-glyph: length = 48px
  screens.shell-rail: length = 272px  // the desktop's rail: the SideNav's places and counts at one line, the page keeps the rest
  screens.shell-sheet: length = 304px  // the phone's sheet (never wider than the window less theme.space.xxl)
  screens.shell-page-max: length = 880px  // the page's measure on a desktop: rows that stay readable, centred in the room the rail leaves
  screens.shell-bar-min: length = 60px  // the bar's height: a 44px control and theme.space.sm above and below
  screens.shell-search: length = 280px
  screens.shell-title-min: length = 160px  // under this the bar's action wraps to its own line, so the title never squeezes
  screens.shell-action-max: length = 240px  // a long action label wraps inside this, never across the bar
  screens.shell-tap: length = 44px  // the menu button: the least target a finger gets
  screens.shell-glyph: length = 20px
  screens.shell-band-min: length = 240px  // under this the band's answers wrap under its sentence
  screens.shell-mark-line: length = 3px
  screens.shell-row-min: length = 64px  // a LinkRow with its detail: its least height, held while the rows load
  screens.shell-ghost-line: length = 10px
  screens.shell-ghost-title: length = 220px
  screens.shell-ghost-short: length = 160px
  screens.shell-ghost-detail: length = 120px
