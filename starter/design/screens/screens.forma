// The screens' own sizes; shipping a design holds this package to Exact's library rules.
forma screens

theme
  screens.column-max: length = 720px
  screens.onboarding-max: length = 960px  // the frame's width, the gap and the list's basis, with a little slack
  screens.onboarding-main: length = 640px  // the frame's own readable width (OnboardingSteps caps there too)
  screens.onboarding-aside: length = 280px
  screens.onboarding-dot: length = 6px
  screens.onboarding-glyph: length = 24px
  screens.onboarding-ring: length = 2px
  screens.onboarding-tick: length = 12px
  screens.onboarding-title-top: length = 2px  // a body line (21px) centred on the 24px glyph
  screens.onboarding-ghost-line: length = 12px
  screens.onboarding-ghost-field: length = 36px
  screens.onboarding-mark-line: length = 3px
  screens.onboarding-alert: length = 16px
  screens.media-max: length = 812px  // the stage (780 wide inside lg padding) is then exactly 3:2 at its full height
  screens.media-stage-max: length = 520px  // the stage's height on a desktop: the picture, caption, a proposal and the strip fit a 900px window
  screens.media-caption-min: length = 240px  // under this the caption takes its own line and Previous and Next wrap under it
  screens.media-thumb: length = 64px
  screens.media-ring: length = 2px
  screens.media-mark-line: length = 3px
  screens.media-glyph: length = 24px
  screens.media-note-max: length = 420px
  screens.media-bone-caption: length = 240px
  screens.media-bone-line: length = 12px
  screens.media-action-min: length = 44px  // ActionButton's least height (components.row-min): the caption centres on Previous and Next
  screens.media-wait-glyph: length = 48px
  screens.mail-rail: length = 256px  // the folders' rail on a desktop: SideNav fills it (its basis is wider, so its spacer wraps away)
  screens.mail-pane-max: length = 760px  // a phone layout's column on a window between a phone and a desktop
  screens.mail-band-min: length = 240px  // under this a band's sentence takes its own line and the answers wrap under it
  screens.mail-mark-line: length = 3px  // the band's start edge: the kit's agent mark (components.mark-line)
  screens.mail-glyph: length = 16px
  screens.mail-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
  screens.mail-avatar: length = 40px
  screens.mail-tap: length = 44px  // Back's least height, ActionButton's own (components.row-min)
  screens.list-detail-list-min: length = 280px  // the list column never narrows below this on a desktop
  screens.list-detail-list-max: length = 400px  // a third of a 1200px window; wider windows give the room to the detail
  screens.list-detail-max: length = 880px  // the detail's measure: DetailPanel's own, so the proposal above it shares its edges
  screens.list-detail-rail: length = 3px
  screens.list-detail-dot: length = 6px
  screens.list-detail-chevron: length = 12px
  screens.list-detail-ghost-row: length = 64px  // a real row's height: md paddings, a label line, xs, a caption line
  screens.list-detail-bone: length = 10px
  screens.list-detail-note-min: length = 200px  // under this the changed sentence takes its own line and Undo wraps under it
  screens.list-detail-state-top: length = 56px
  screens.list-detail-line: length = 21px  // one body line (15px at 1.4): the changed note's dot centres on it
  screens.dashboard-max: length = 1120px  // the content's readable width on a wide window, centred
  screens.dashboard-tile-min: length = 148px  // two tiles share a phone's row (326px inside the card), four a desktop's
  screens.dashboard-chart-min: length = 320px  // the chart and the list sit side by side once both least widths fit
  screens.dashboard-list-min: length = 280px
  screens.dashboard-head-min: length = 160px  // under this a card's title takes its own line and its end wraps under it
  screens.dashboard-plot: length = 176px  // the plot's least height; it grows with a taller list beside it
  screens.dashboard-bar-max: length = 40px  // a bar's widest, so a desktop's bars stay bars, not blocks
  screens.dashboard-bar-least: length = 2px  // a zero still shows as a stub on the axis
  screens.dashboard-bone: length = 10px
  screens.dashboard-bone-value: length = 36px  // the display-compact step's own line (30px at 1.2)
  screens.dashboard-ghost-row: length = 64px  // a real row's height: md paddings, a body line, xs, a caption line
  screens.dashboard-tap: length = 44px  // a press's least height (components.row-min)
  screens.dashboard-band-min: length = 240px  // under this a band's sentence takes its own line and the answers wrap under it
  screens.dashboard-mark-line: length = 3px  // the band's start edge: the kit's agent mark (components.mark-line)
  screens.dashboard-glyph: length = 16px
  screens.dashboard-glyph-top: length = 2px  // a 16px glyph centred on the body type's first line (21px)
