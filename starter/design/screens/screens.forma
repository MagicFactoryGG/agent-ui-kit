// The screens' own sizes; shipping a design holds this package to Exact's library rules.
forma screens

theme
  screens.column-max: length = 720px
  screens.media-max: length = 812px  // the stage (780 wide inside lg padding) is then exactly 3:2 at its full height
  screens.media-stage-max: length = 520px  // the stage's height on a desktop: the picture, caption, a proposal and the strip fit a 900px window
  screens.media-caption-min: length = 240px  // under this the caption takes its own line and Previous and Next wrap under it
  screens.media-thumb: length = 64px
  screens.media-ring: length = 2px
  screens.media-mark-line: length = 3px
  screens.media-glyph: length = 24px
  screens.media-note-max: length = 420px
  screens.media-bone-caption: length = 240px
  screens.media-bone-line: length = 12px
  screens.media-action-min: length = 44px  // ActionButton's least height (components.row-min): the caption centres on Previous and Next
  screens.media-wait-glyph: length = 48px
