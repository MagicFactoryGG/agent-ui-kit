// SettingsScreen: a settings page. The bar names it (TopBar). Under it, on a desktop, a short list of the app's
// sections stands on the left and the chosen section on the right at a readable width (screens.settings-main-max):
// its name large, the line that says what it holds, then its groups, each the kit's SettingsGroup (its title and
// note beside its card when there is room, above it on a phone). On a phone the same pieces stack in one column:
// the sections become a wrapping row of pills under the bar, then the chosen section's groups.
//
// Width, with no breakpoint and no read of the host: the list and the section share a wrapping row, the list
// growing from screens.settings-nav and the section from screens.settings-main-min a thousand times as fast, so a
// desktop keeps the list at its width and gives the rest to the section (held to its readable width, the whole
// page held to screens.settings-max and centred); a phone wraps the section under the list. Each place in the list
// takes its basis from the list's own width: calc((screens.settings-fold - 100%) * 999) is huge while the list is
// narrower than the fold (a desktop's rail: one place a line, a vertical list) and nothing once it is wider (a
// phone's full width: each place as wide as its words, side by side, wrapping into rows of pills).
//
// States, declared once:
//   data   many | empty | loading | failed | long. The sections are the app's own list, known before its values,
//          so the list and the chosen section's name stand in every state; only the groups change. Loading puts
//          a skeleton in each group's place, the shape a loaded group takes (a ghost title and note where its
//          title will stand, SettingsGroup's own row-for-row skeleton where its card will), named for a screen
//          reader and read under the section's name by `loadingText`, beside an accent arc that turns (the state's one
//          moving, coloured mark). Empty is the kit's StatePanel: `emptyTitle`, `emptyText` and the way on,
//          `addLabel` (the state's one filled element). Failed is StatePanel's alert: `failedTitle`, `failedText`
//          in the muted ink on the surface, and `retryLabel`, the way back. Long is many with words that run
//          long: the list's places keep one line (each carries its whole name as its title), everything else
//          wraps.
//   agent  none | proposed | changed | waiting: an assistant's act on one setting (`agentKey` names its row,
//          `agentSection` its section). The group that holds the row shows it the kit's way (SettingsGroup:
//          proposed marks the row and asks under the group with `proposalText` and the two answer words;
//          changed keeps the accent edge, says `changedText` and offers `undoLabel`, the way back, under it;
//          waiting keeps the caution edge, says `waitingText` and puts `declineLabel` and `acceptLabel` under
//          it, so what waits for the person is answered where it is said). The section's place in the list
//          carries a dot of the same ink, so a person sees where an act is even from another section (a screen
//          reader hears the act's sentence after the place's name); while an act waits, the bar says
//          `waitingNote` under its title.
//
// Both doors: a person's press and an agent's tool reach the same actions, each by key: `pick` a section,
// `toggle`, `choose`, `open` and `remove` a setting (SettingsGroup's own), `accept` and `decline` a proposal or
// a waiting act, `undo` the agent's change, `retry`, `add`.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton from "__SCOPE__/components"
use TopBar, StatePanel, SettingsGroup, Setting from "__SCOPE__/blocks"

// One place in the list: its key, its name, and the line that says what it holds (shown under its name when
// chosen; "" for none).
shape SettingsSection
  key: string
  label: string
  detail: string

// One group of the chosen section: its key, its title, the note beside it ("" for none) and its rows.
shape SettingsScreenGroup
  key: string
  title: string
  footer: string
  rows: Setting[]

// The skeleton breathes, as SettingsGroup's own does, so the ghosts read as on their way.
keyframes settingsBreathe
  50% opacity=0.6

// The loading arc's turn.
keyframes settingsTurn
  100% rotate="360deg"

// True when the group holds the row the agent's act is about.
fn holdsRow(g: SettingsScreenGroup, key: string): bool = g.rows.filter(r => r.key == key).length > 0
// The dot's ink: the accent for an act a person can see or answer, the caution ink while it waits.
fn markInk(m: string): string = m == "waiting" ? "theme.color.caution" : "theme.color.accent"

// One place in the list: a button that picks its section by key. The chosen one is the list's one fill, in the
// label's heavier type and the ink; the rest sit back in the muted ink. Its name keeps one line and carries the
// whole of itself as its title. A dot after the name says an agent acted in that section; a screen reader hears
// the act's own sentence, `note`, after the name (the dot alone says nothing to it). Its insets are the lg the
// heading and SettingsGroup's titles take, so a pill's words on a phone start on the same edge as theirs.
component SettingsPlace
  props
    label: string
    note: string
    current: bool
    mark: string
    press: action
    testId: string
  view
    button press=press testId=testId aria-current=(current ? "page" : "false") aria-label=(note == "" ? label : `${label}. ${note}`) title=label display="flex" flex-direction="row" align-items="center" gap="theme.space.sm" flex-grow=0 flex-shrink=1 flex-basis="calc((screens.settings-fold - 100%) * 999)" max-width="100%" min-height="screens.settings-place-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" border-width=0 border-radius="theme.radius.control" text-align="start" background-color=(current ? "theme.color.fill" : "transparent")
      :hover
        background-color="theme.color.hover"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      text label min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font=(current ? "theme.type.label" : "theme.type.body") color=(current ? "theme.color.ink" : "theme.color.ink-muted")
      if mark != "none"
        box testId=`${testId}-mark` width="screens.settings-dot" height="screens.settings-dot" flex-shrink=0 border-radius="theme.radius.pill" background-color=markInk(mark) aria-hidden=true

// A bar of the skeleton, the fill colour at a named length.
component SettingsBone
  props
    width: string
    height: string
  view
    box width=width max-width="100%" height=height border-radius="theme.radius.pill" background-color="theme.color.fill" animation="settingsBreathe 1.6s ease-in-out infinite"

// A group still loading, in a loaded group's own shape: a ghost title and note where SettingsGroup puts its title
// (the same least widths, so it wraps where a group wraps), and SettingsGroup's own skeleton where its card goes.
component SettingsGhost
  props
    loadingText: string
    testId: string
  view
    row flex-wrap="wrap" align-items="flex-start" column-gap="theme.space.xl" row-gap="theme.space.sm"
      column flex=1 min-width="screens.settings-aside" box-sizing="border-box" gap="theme.space.sm" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="screens.settings-aside-top" aria-hidden=true
        SettingsBone(width="screens.settings-bone-title", height="screens.settings-bone-thick")
        SettingsBone(width="screens.settings-bone-note", height="screens.settings-bone")
      column flex=2 min-width="screens.settings-card-min" box-sizing="border-box"
        SettingsGroup(title="", footer="", emptyText="", loadingText=loadingText, failedText="", failedDetail="", retryLabel="", proposalText="", proposalKey="", acceptLabel="", declineLabel="", changedText="", waitingText="", outcomeText="", data="loading", interaction="idle", outcome="none", agent="none", rows=[], toggle=still, choose=still, open=still, remove=still, retry=quiet, accept=quiet, decline=quiet, testId=testId)
  // A skeleton has no rows and no ask: nothing in it can be pressed, so its doors lead nowhere.
  action still(key: string)
  action quiet

component SettingsScreen
  props
    title: string
    navLabel: string
    currentKey: string
    sections: SettingsSection[]
    groups: SettingsScreenGroup[]
    groupEmptyText: string
    loadingText: string
    emptyTitle: string
    emptyText: string
    addLabel: string
    failedTitle: string
    failedText: string
    retryLabel: string
    agentSection: string
    agentKey: string
    proposalText: string
    acceptLabel: string
    declineLabel: string
    changedText: string
    waitingText: string
    waitingNote: string
    undoLabel: string
    data: enum<"many", "empty", "loading", "failed", "long">
    agent: enum<"none", "proposed", "changed", "waiting">
    pick: action
    toggle: action
    choose: action
    open: action
    remove: action
    accept: action
    decline: action
    retry: action
    add: action
    undo: action
  // SettingsGroup's doors, each passed on with the row's key.
  action flip(key: string)
    toggle(key)
  action chooseRow(key: string)
    choose(key)
  action openRow(key: string)
    open(key)
  action removeRow(key: string)
    remove(key)
  // The sentence of the agent's act, by its state, for the list's dot.
  derive actNote = agent == "proposed" ? proposalText : agent == "changed" ? changedText : agent == "waiting" ? waitingText : ""
  // The panel's one way on: back again when the load failed, forward when the section is empty.
  action wayOn
    if data == "failed"
      retry()
    else
      add()
  view
    column testId="settings-screen" position="absolute" inset=0 display="flex" flex-direction="column" background-color="theme.color.page" color="theme.color.ink"
      TopBar(title=title, agentNote=waitingNote, agent=(agent == "waiting" ? "waiting" : "none"))
      scroll id="settings-screen-scroll" flex=1 min-height=0
        row flex-wrap="wrap" align-items="flex-start" column-gap="theme.space.xxl" row-gap="theme.space.xl" width="100%" max-width="screens.settings-max" margin-left="auto" margin-right="auto" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.xl" padding-bottom="theme.space.xxl"
          if sections.length > 0
            column testId="settings-screen-nav" role="navigation" aria-label=navLabel flex=1 min-width="screens.settings-nav" box-sizing="border-box"
              row flex-wrap="wrap" gap="theme.space.xs"
                for s in sections key=s.key
                  SettingsPlace(label=s.label, note=(s.key == agentSection ? actNote : ""), current=(s.key == currentKey), mark=(s.key == agentSection ? agent : "none"), press=pick(s.key), testId=`settings-screen-place-${s.key}`)
          column testId="settings-screen-main" flex=1000 min-width="screens.settings-main-min" max-width="screens.settings-main-max" box-sizing="border-box" gap="theme.space.xxl"
            for s in sections.filter(x => x.key == currentKey) key=s.key
              column gap="theme.space.xs" padding-left="theme.space.lg" padding-right="theme.space.lg"
                text s.label testId="settings-screen-heading" role="heading" aria-level=2 padding-top="theme.space.xs" padding-bottom="theme.space.xs" overflow-wrap="break-word" font="theme.type.display-compact" letter-spacing="theme.type.display-compact-tracking" color="theme.color.ink"
                if s.detail != ""
                  column max-width="screens.settings-measure"
                    Words(text=s.detail, kind="body", outcome="cancelled", level=0, testId="settings-screen-lead")
                if data == "loading"
                  // Loading says so in words a person can read, beside the one moving mark: an accent arc.
                  row role="status" align-items="center" gap="theme.space.sm" margin-top="theme.space.sm"
                    svg viewBox="0 0 16 16" width="screens.settings-spin" height="screens.settings-spin" fill="none" aria-hidden=true flex-shrink=0 animation="settingsTurn 1s linear infinite"
                      circle cx=8 cy=8 r=6 stroke="theme.color.fill" stroke-width=2
                      path d="M8 2a6 6 0 0 1 6 6" stroke="theme.color.accent" stroke-width=2 stroke-linecap="round"
                    text loadingText testId="settings-screen-loading" min-width=0 font="theme.type.caption" color="theme.color.ink-muted"
            if data == "many" or data == "long"
              for g in groups key=g.key
                column gap="theme.space.sm"
                  SettingsGroup(title=g.title, footer=g.footer, emptyText=groupEmptyText, loadingText=loadingText, failedText=failedText, failedDetail="", retryLabel=retryLabel, proposalText=proposalText, proposalKey=agentKey, acceptLabel=acceptLabel, declineLabel=declineLabel, changedText=changedText, waitingText=waitingText, outcomeText="", data=(g.rows.length == 0 ? "empty" : "many"), interaction="idle", outcome="none", agent=(holdsRow(g, agentKey) ? agent : "none"), rows=g.rows, toggle=flip, choose=chooseRow, open=openRow, remove=removeRow, retry=retry, accept=accept, decline=decline, testId=`settings-${g.key}`)
                  if (agent == "changed" or agent == "waiting") and holdsRow(g, agentKey)
                    // The person's answer, under the group's own words about the act, on the card's edge: Undo for
                    // what the agent changed; for an act that waits, the two answer words (the waiting act is held
                    // for the person, so the person can let it through or stop it here). An empty title column of
                    // SettingsGroup's own least width and insets holds the card's place on a desktop and wraps
                    // away, zero tall, on a phone. Named by the act's own sentence.
                    row flex-wrap="wrap" column-gap="theme.space.xl"
                      box flex=1 min-width="screens.settings-aside" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" aria-hidden=true
                      column flex=2 min-width="screens.settings-card-min" box-sizing="border-box"
                        // The inset is the wrapper's, not the flex item's: a basis-0 item's own padding takes part in
                        // sharing the width out, and the button had stood 11px off the card's edge.
                        row role="group" aria-label=(agent == "changed" ? changedText : waitingText) flex-wrap="wrap" gap="theme.space.sm" padding-left="theme.space.lg"
                          if agent == "changed"
                            ActionButton(label=undoLabel, kind="plain", interaction="idle", outcome="none", press=undo, testId="settings-screen-undo")
                          else
                            ActionButton(label=declineLabel, kind="plain", interaction="idle", outcome="none", press=decline, testId="settings-screen-stop")
                            ActionButton(label=acceptLabel, kind="primary", interaction="idle", outcome="none", press=accept, testId="settings-screen-let")
            else if data == "loading"
              SettingsGhost(loadingText=loadingText, testId="settings-screen-loading-1")
              SettingsGhost(loadingText=loadingText, testId="settings-screen-loading-2")
            else
              column width="100%" max-width="screens.settings-panel-max"
                StatePanel(title=(data == "failed" ? failedTitle : emptyTitle), message=emptyText, failedText=failedText, agentNote="", actionLabel=addLabel, retryLabel=retryLabel, data=(data == "failed" ? "failed" : "empty"), agent="none", size="full", press=wayOn, testId=`settings-screen-${data}`)
