// The playground's frame. A generated app (tools/matrix.mjs) places every piece inside these; nobody writes the
// playground's app by hand. Its look is neutral on purpose: only the cells show the Theme.
use Swatch from "__SCOPE__/theme"

// The window: the controls across the top, the page below. The bar wraps, so a phone keeps the page's full width.
component Shell
  props
    title: string
  slot
  view
    column testId="playground" position="absolute" inset=0 background-color="frame.ground" color="frame.ink" aria-label=title
      children

// The controls across the top: the title, then each control in a NavField; it wraps on a narrow window.
component NavList
  props
    title: string
  slot
  view
    row flex-shrink=0 flex-wrap="wrap" align-items="flex-end" gap="frame.gap" padding="frame.pad" background-color="frame.panel" border-bottom-width=1 border-bottom-style="solid" border-bottom-color="frame.line"
      text title role="heading" aria-level=1 font="frame.type-head" color="frame.ink" padding-bottom="frame.small" white-space="nowrap"
      children

// One control in the bar, with its label above it.
component NavField
  props
    label: string
  slot
  view
    column gap="frame.small" width="frame.field-width"
      text label font="frame.type-small" color="frame.ink-muted" white-space="nowrap"
      children

// One page in the list: a group's heading when `press` is never needed is a NavHeading.
component NavItem
  props
    label: string
    on: bool
    press: action
    testId: string
  view
    button press=press testId=testId aria-current=(on ? "page" : "false") text-align="start" padding-left="frame.gap" padding-right="frame.gap" padding-top="frame.small" padding-bottom="frame.small" border-radius="frame.corner" border-width=0 background-color=(on ? "frame.on" : "transparent") color="frame.ink"
      :hover
        background-color="frame.on"
      text label font="frame.type-item" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

component NavHeading
  props
    label: string
  view
    text label role="heading" aria-level=2 font="frame.type-small" color="frame.ink-muted" padding-top="frame.gap" padding-left="frame.gap"

// The page beside the list: its title, a line, then the rows of cells.
component Page
  props
    title: string
    note: string
  slot
  view
    scroll flex=1 min-height=0 scrollbar-width="none"
      column padding="frame.pad" gap="frame.gap"
        text title role="heading" aria-level=2 font="frame.type-title" color="frame.ink"
        text note font="frame.type-small" color="frame.ink-muted"
        children

// The window's look, compact enough for the list: the frame's own control, not the brand's.
component ModeChoice
  props
    scheme: enum<"system", "light", "dark">
    lightLabel: string
    darkLabel: string
    systemLabel: string
    groupLabel: string
    light: action
    dark: action
    system: action
  view
    row role="group" aria-label=groupLabel gap="frame.small" padding="frame.small" background-color="frame.on" border-radius="frame.corner"
      ModeButton(label=lightLabel, on=(scheme == "light"), press=light, testId="mode-light")
      ModeButton(label=darkLabel, on=(scheme == "dark"), press=dark, testId="mode-dark")
      ModeButton(label=systemLabel, on=(scheme == "system"), press=system, testId="mode-system")

component ModeButton
  props
    label: string
    on: bool
    press: action
    testId: string
  view
    button press=press testId=testId aria-pressed=on flex=1 min-width=0 padding-top="frame.small" padding-bottom="frame.small" border-radius="frame.corner" border-width=0 background-color=(on ? "frame.panel" : "transparent") color=(on ? "frame.ink" : "frame.ink-muted")
      text label font="frame.type-small" white-space="nowrap"

// The colour tokens, side by side in as many columns as the page holds.
component TokenGrid
  slot
  view
    row flex-wrap="wrap" gap="frame.small" align-items="flex-start"
      children

// One colour token on one line: the colour in light and in dark, then its name.
component TokenRow
  props
    name: string
    testId: string
  slot
  view
    row testId=testId align-items="center" gap="frame.gap" width="frame.row-max" padding-left="frame.small" padding-right="frame.gap" padding-top="frame.small" padding-bottom="frame.small" border-radius="frame.corner"
      :hover
        background-color="frame.on"
      children
      text name flex=1 min-width=0 font="frame.type-item" color="frame.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One token's colour in one mode, pinned to it.
component TokenSwatch
  props
    scheme: enum<"light", "dark">
    testId: string
  slot
  view
    row testId=testId color-scheme=(scheme == "dark" ? "dark" : "light") flex-shrink=0
      children

// One state: its name, then its cells (light, then dark), side by side.
component MatrixRow
  props
    label: string
    testId: string
  slot
  view
    column gap="frame.small" testId=testId
      text label font="frame.type-small" color="frame.ink-muted" font-variant-numeric="tabular-nums"
      row gap="frame.gap" align-items="stretch" flex-wrap="wrap"
        children

// One cell: the piece in one mode, on the Theme's page colour. The pin holds the scheme whatever the window's.
component MatrixCell
  props
    scheme: enum<"light", "dark">
    testId: string
  slot
  view
    column testId=testId color-scheme=(scheme == "dark" ? "dark" : "light") flex=1 min-width="frame.cell-min" padding="frame.pad" background-color="theme.color.page" color="theme.color.ink" border-radius="frame.corner" border-width=1 border-style="solid" border-color="frame.line"
      children

// A screen's cell: a window-sized box the screen fills (a screen lays itself out at inset 0).
component ScreenCell
  props
    scheme: enum<"light", "dark">
    testId: string
  slot
  view
    column testId=testId color-scheme=(scheme == "dark" ? "dark" : "light") position="relative" width=480 max-width="100%" height=640 flex-shrink=1 box-sizing="border-box" overflow="hidden" background-color="theme.color.page" color="theme.color.ink" border-radius="frame.corner" border-width=1 border-style="solid" border-color="frame.line"
      children
