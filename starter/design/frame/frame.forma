// The frame's own neutral colours and sizes (the pieces inside show the Theme's).
forma frame

theme
  frame.ground = light-dark(#eeeef0, #111113)
  frame.panel = light-dark(#fafafa, #1a1a1d)
  frame.ink = light-dark(#1c1c1f, #ededef)  pair=frame.panel
  frame.ink-muted = light-dark(#5f5f66, #a0a0a8)  pair=frame.panel
  frame.line = light-dark(#dcdce0, #2c2c31)
  frame.on = light-dark(#e2e2e6, #2a2a2f)
  frame.nav-width: length = 220px
  frame.pad: length = 16px
  frame.gap: length = 12px
  frame.small: length = 4px
  frame.corner: length = 8px
  frame.cell-min: length = 280px
  // Fixed px type, so the frame itself looks the same on every host and a whole-window comparison is fair.
  frame.type-title: type = 600 22px/1.2 system-ui
  frame.type-head: type = 600 15px/1.3 system-ui
  frame.type-item: type = 400 14px/1.3 system-ui
  frame.type-small: type = 400 12px/1.3 system-ui
