// StatTiles: a row of the numbers a person checks first, as many as the app brings. Each tile is one stat on a
// card of the kit's language — the raised surface with a hairline line and the card's corner, Section's card,
// not a new idea — with a narrow slot at its start for the agent's mark, transparent when no agent touched it
// (the mark never breaks the corner, and every tile's words start at one edge): its label in the caption ink,
// the value in the title type with tabular figures (the group's largest words, its one focal point), and the
// change pinned to the tile's bottom edge beside a drawn glyph in the positive or critical ink the trend names
// — the sign and the glyph say the direction, a flat line its rest, never the colour alone. The tiles share one
// rhythm: flex tiles that wrap at blocks.stat-tile-min with box-sizing="border-box" (the responsive-columns
// pattern without its literal, which a package may not hold), two by two on a phone, four across on a desktop,
// and the row centres itself at blocks.stat-max — EntryGate's own habit — so a wide window keeps the group
// composed and an app's column caps the app's way.
//
// - data many|loading|failed. Loading keeps the group's shape: its words with the platform's own activity bar
//   right after them (EntryGate's busy line), above ghost tiles of the resting shape drawn in the fill token
//   and hidden from a reader. Failed stands in the tiles' place as one banner of the tiles' own shell, capped
//   at blocks.stat-fail-max so the words and the way on read as one line: a mark in the error's ink, the words
//   in the same ink (role="alert"), `retryLabel`'s button at the end. No tile lies with a stale number in
//   either state.
// - agent none|proposed|changed|waiting: `agentKey` names the stat the agent touched; that tile's slot takes
//   the kit's mark (the accent, caution while the person is waited on), and `agentNote`'s sentence stands under
//   the row with the same mark beside it — TopBar's note under its title, said once for the group, naming the
//   stat itself (a voice has no screen). Nothing is marked when no key matches.
//
// States:
//   data   many|loading|failed
//   agent  none|proposed|changed|waiting
use Words, ActionButton from "__SCOPE__/components"

// One number the person checks: its key, what it is called, the value, the change with its sign, and the trend's
// way ("up" positive ink, "down" critical ink, "flat" the caption ink).
shape Stat
  key: string
  label: string
  value: string
  change: string
  trend: enum<"up", "down", "flat">

// The change's ink: positive going up, critical going down, muted at flat.
fn trendInk(t: string): string = t == "up" ? "theme.color.positive-text" : t == "down" ? "theme.color.critical-text" : "theme.color.ink-muted"

// One stat on the card: the mark slot, then the label, the value large, the change with its glyph pinned to the
// bottom edge (a delta is a footnote, and the row of tiles then shares its bottom line).
component StatTile
  props
    label: string
    value: string
    change: string
    trend: enum<"up", "down", "flat">
    marked: bool
    waiting: bool
    testId: string
  view
    row testId=testId role="listitem" flex=1 min-width="blocks.stat-tile-min" box-sizing="border-box" gap="theme.space.xs" padding="theme.space.lg" background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line"
      box align-self="stretch" width="blocks.stat-mark-line" border-radius="theme.radius.pill" background-color=(marked ? (waiting ? "theme.color.caution" : "theme.color.accent") : "transparent") aria-hidden=true
      column flex=1 min-width=0 gap="theme.space.xs"
        Words(text=label, kind="caption", outcome="none", level=0, testId=`${testId}-label`)
        text value testId=`${testId}-value` font="theme.type.title" color="theme.color.ink" font-variant-numeric="tabular-nums"
        row align-items="center" gap="theme.space.xs" margin-top="auto"
          svg viewBox="0 0 12 12" width="blocks.stat-trend" height="blocks.stat-trend" fill="none" stroke=trendInk(trend) aria-hidden=true flex-shrink=0
            path d=(trend == "up" ? "M3 9 L9 3 M5.5 3 H9 V6.5" : trend == "down" ? "M3 3 L9 9 M5.5 9 H9 V5.5" : "M3 6 H9") stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
          text change testId=`${testId}-change` flex=1 min-width=0 font="theme.type.caption" color=trendInk(trend) font-variant-numeric="tabular-nums"

// A tile still coming: the resting shape's card with fill bars where the label, the value and the change will
// be. Drawn in the loading row only, hidden from a reader.
component StatGhost
  view
    column flex=1 min-width="blocks.stat-tile-min" box-sizing="border-box" gap="theme.space.xs" padding="theme.space.lg" background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" aria-hidden=true
      box width="blocks.stat-ghost-label" height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill"
      box width="blocks.stat-ghost-value" height="theme.space.xl" background-color="theme.color.fill" border-radius="theme.radius.pill"
      box width="blocks.stat-ghost-change" height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-top="auto"

component StatTiles
  props
    title: string
    stats: Stat[]
    data: enum<"many", "loading", "failed">
    loadingText: string
    failedText: string
    retryLabel: string
    retry: action
    agent: enum<"none", "proposed", "changed", "waiting">
    agentKey: string
    agentNote: string
    testId: string
  view
    column testId=testId gap="theme.space.sm" width="100%" max-width="blocks.stat-max" margin-left="auto" margin-right="auto"
      if title != ""
        Words(text=title, kind="label", outcome="none", level=2, testId=`${testId}-title`)
      if data == "failed"
        row role="alert" align-items="center" gap="theme.space.md" padding="theme.space.lg" background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" max-width="blocks.stat-fail-max"
          box background-color="theme.color.critical-text" border-radius="theme.radius.pill" align-self="stretch" width="blocks.stat-mark-line" aria-hidden=true
          column flex=1 min-width=0
            Words(text=failedText, kind="body", outcome="error", level=0, testId=`${testId}-failed`)
          if retryLabel != ""
            ActionButton(label=retryLabel, kind="plain", interaction="idle", outcome="none", press=retry, testId=`${testId}-retry`)
      else if data == "loading"
        column gap="theme.space.md"
          row role="status" align-items="center" gap="theme.space.sm"
            Words(text=loadingText, kind="caption", outcome="cancelled", level=0, testId=`${testId}-loading`)
            progress aria-label=loadingText width="blocks.stat-bar" flex-shrink=0
          row flex-wrap="wrap" gap="theme.space.md" aria-hidden=true
            for i in [0, 1, 2, 3] key=i
              StatGhost()
      else
        row role="list" flex-wrap="wrap" gap="theme.space.md"
          for s in stats key=s.key
            StatTile(label=s.label, value=s.value, change=s.change, trend=s.trend, marked=(agent != "none" and s.key == agentKey), waiting=(agent == "waiting"), testId=`${testId}-${s.key}`)
        if agent != "none" and agentNote != ""
          row role="status" align-items="center" gap="theme.space.xs"
            box width="blocks.stat-mark-line" height="theme.space.md" background-color=(agent == "waiting" ? "theme.color.caution" : "theme.color.accent") border-radius="theme.radius.pill" aria-hidden=true flex-shrink=0
            text agentNote testId=`${testId}-note` font="theme.type.caption" color=(agent == "waiting" ? "theme.color.caution-text" : "theme.color.accent")
