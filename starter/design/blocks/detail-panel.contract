// The detail of one record, alone or inside a screen's column: a header (the title with its status tag beside it,
// up to two actions), the record's facts as label-value rows, a notes paragraph, and its activity at the end. The
// panel keeps one measure (`blocks.detail-max`) so its rows and prose read at one rhythm at every width; a phone
// stacks the same groups unchanged. Under the title sits the panel's status line: the work in flight first (while
// `interaction` is busy the platform's own progress turns with `busyNote`, the app's words for the write; while
// `data` is loading it turns with `loadingText`), then the agent's marked line — `changedNote` for a changed value
// (the ledger's "did" sentence), `waitingNote` for a proposal the person must answer (its "asks" sentence). The
// buttons hold their words through every state, and their `interaction` is the app's: busy while a write is in
// flight, disabled when it means to refuse them. Loading claims nothing: quiet bars hold each group's shape, each
// standing where the rows it stands in for sit. The record that failed says so at the panel's own scale, one alert
// with the kit's severity mark and the way on: `retryLabel` naming it, `retryPress` being the app's own action.
// A fact's short value sits at the end of its line; a long one reads as prose under its label. Every word is a
// prop; rows arrive by shape (Fact, Event).
use Swatch from "__SCOPE__/theme"
use Words, ActionButton, Tag from "__SCOPE__/components"

// One fact of the record: its key, the label it reads as, and its value.
shape Fact
  key: string
  label: string
  value: string

// One entry in the record's activity: who did what, and when.
shape Event
  key: string
  who: string
  what: string
  when: string

// A value past one short line no longer reads as a column but as prose: such a fact stacks its value under its
// label (the value keeps the row's full width) instead of squeezing the pair into ragged halves.
fn factStacks(v: string): bool = v.length > 22

component DetailPanel
  props
    testId: string
    title: string
    statusLabel: string
    status: enum<"none", "success", "error", "blocked", "cancelled">
    primaryLabel: string
    primaryPress: action
    secondaryLabel: string
    secondaryPress: action
    interaction: enum<"idle", "busy", "disabled">
    busyNote: string
    changedNote: string
    waitingNote: string
    retryLabel: string
    retryPress: action
    factsTitle: string
    facts: Fact[]
    factsEmptyText: string
    notesTitle: string
    notes: string
    activityTitle: string
    events: Event[]
    activityEmptyText: string
    loadingText: string
    failedText: string
    data: enum<"one", "loading", "failed", "long">
    agent: enum<"none", "changed", "waiting">
  view
    column testId=testId width="100%" max-width="blocks.detail-max" margin-left="auto" margin-right="auto" box-sizing="border-box" gap="theme.space.xl"
      row flex-wrap="wrap" align-items="flex-start" gap="theme.space.md"
        column flex=1 min-width="blocks.header-min" box-sizing="border-box" gap="theme.space.xs"
          row flex-wrap="wrap" align-items="baseline" gap="theme.space.sm"
            Words(text=title, kind="title", outcome="none", level=2, testId=`${testId}-title`)
            if statusLabel != ""
              Tag(text=statusLabel, outcome=status)
          if data == "loading" or (interaction == "busy" and busyNote != "") or agent == "changed" or agent == "waiting"
            row flex-wrap="wrap" align-items="center" gap="theme.space.sm"
              if data == "loading"
                // The record on its way, said as a chip beside the tag. (The spinner keeps the platform's grey:
                // NSProgressIndicator takes no tint.)
                row role="status" gap="theme.space.xs" align-items="center" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-radius="theme.radius.pill" padding-left="theme.space.sm" padding-right="theme.space.sm" testId=`${testId}-loading`
                  progress aria-label=loadingText width="blocks.spin" height="blocks.spin" testId=`${testId}-loading-progress`
                  text loadingText testId=`${testId}-loading-text` font="theme.type.caption" color="theme.color.ink"
              if interaction == "busy" and busyNote != ""
                // Work in flight, the same chip, so it never moves with the buttons' widths.
                row gap="theme.space.xs" align-items="center" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-radius="theme.radius.pill" padding-left="theme.space.sm" padding-right="theme.space.sm"
                  progress aria-label=busyNote width="blocks.spin" height="blocks.spin" testId=`${testId}-busy`
                  text busyNote testId=`${testId}-busy-note` font="theme.type.caption" color="theme.color.ink"
              if agent == "changed" or agent == "waiting"
                row min-width=0 gap="theme.space.sm" padding-left="theme.space.sm" border-left-width="components.mark-line" border-left-style="solid" border-left-color=(agent == "waiting" ? "theme.color.caution" : "theme.color.accent")
                  text (agent == "waiting" ? waitingNote : changedNote) testId=`${testId}-agent` font="theme.type.caption" color=(agent == "waiting" ? "theme.color.caution-text" : "theme.color.accent")
        if primaryLabel != "" or secondaryLabel != ""
          row flex-wrap="wrap" align-items="center" gap="theme.space.sm"
            if secondaryLabel != ""
              ActionButton(label=secondaryLabel, kind="plain", interaction=interaction, outcome="none", press=secondaryPress, testId=`${testId}-secondary`)
            if primaryLabel != ""
              ActionButton(label=primaryLabel, kind="primary", interaction=interaction, outcome="none", press=primaryPress, testId=`${testId}-primary`)
      if data == "failed"
        // The failure is the record's, not one section's: one alert, with the kit's severity mark at the message's
        // side and the way on. What did not arrive says nothing.
        column testId=`${testId}-failed` role="alert" gap="theme.space.md" padding="theme.space.lg" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="blocks.alert-line" border-style="solid" border-color="theme.color.critical"
          row gap="theme.space.sm" align-items="flex-start"
            svg viewBox="0 0 12 12" width="components.chevron" height="components.chevron" fill="none" stroke="theme.color.critical" aria-hidden=true margin-top="theme.space.xs" flex-shrink=0
              circle cx=6 cy=6 r=5 stroke-width=1.2
              path d="M6 3.2L6 6.8" stroke-width=1.2 stroke-linecap="round"
              circle cx=6 cy=9.4 r=0.8 fill="theme.color.critical" stroke="none"
            Words(text=failedText, kind="body", outcome="error", level=0, testId=`${testId}-failed-text`)
          if retryLabel != ""
            row
              ActionButton(label=retryLabel, kind="plain", interaction=interaction, outcome="none", press=retryPress, testId=`${testId}-retry`)
      else
        column gap="theme.space.sm"
          if factsTitle != ""
            column padding-left="theme.space.lg" padding-right="theme.space.lg"
              Words(text=factsTitle, kind="heading", outcome="none", level=3, testId=`${testId}-facts-title`)
          column testId=`${testId}-facts` role=(data == "loading" ? "none" : facts.length == 0 ? "status" : "list") background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden"
            if data == "loading"
              // The bars stand where a short fact's label and value sit, so the card keeps the shape of its rows.
              for n in [1, 2, 3, 4] key=n
                row aria-hidden=true min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" align-items="center" gap="theme.space.md" border-top-width=(n > 1 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                  box height="theme.space.md" flex=1 background-color="theme.color.fill" border-radius="theme.radius.pill"
                  box flex=1
                  box height="theme.space.md" flex=1 background-color="theme.color.fill" border-radius="theme.radius.pill"
            else
              if facts.length == 0
                text factsEmptyText testId=`${testId}-facts-empty` padding="theme.space.lg" font="theme.type.body" color="theme.color.ink-muted"
              // A short pair shares the line, label to value, each wrapping in its half; a value without a share
              // of the flex is squeezed to one word a line, so a long one stacks under its label instead.
              for f, i in facts key=f.key
                if factStacks(f.value)
                  column role="listitem" justify-content="center" gap="theme.space.xs" min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    text f.label testId=`${testId}-fact-${f.key}` font="theme.type.body" color="theme.color.ink"
                    text f.value font="theme.type.body" color="theme.color.ink"
                else
                  row role="listitem" align-items="baseline" gap="theme.space.md" min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    text f.label testId=`${testId}-fact-${f.key}` flex=1 min-width=0 font="theme.type.body" color="theme.color.ink"
                    text f.value flex=1 min-width=0 font="theme.type.body" color="theme.color.ink" text-align="end"
        if notes != ""
          column gap="theme.space.sm"
            if notesTitle != ""
              column padding-left="theme.space.lg" padding-right="theme.space.lg"
                Words(text=notesTitle, kind="heading", outcome="none", level=3, testId=`${testId}-notes-title`)
            column testId=`${testId}-notes` background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden"
              if data == "loading"
                // Quiet lines hold the paragraph's place while the record is on its way.
                column aria-hidden=true padding="theme.space.lg" gap="theme.space.sm"
                  box height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill"
                  box height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill"
                  box height="theme.space.md" max-width="blocks.notes-last" background-color="theme.color.fill" border-radius="theme.radius.pill"
              else
                text notes testId=`${testId}-notes-text` padding="theme.space.lg" font="theme.type.body" color="theme.color.ink"
        column gap="theme.space.sm"
          if activityTitle != ""
            column padding-left="theme.space.lg" padding-right="theme.space.lg"
              Words(text=activityTitle, kind="heading", outcome="none", level=3, testId=`${testId}-activity-title`)
          column testId=`${testId}-activity` role=(data == "loading" ? "none" : events.length == 0 ? "status" : "list") background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden"
            if data == "loading"
              // Each row mirrors the one it stands in for: the what's line, then the who's line with the when's
              // short stamp at the end edge.
              for n in [1, 2, 3] key=n
                row aria-hidden=true min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(n > 1 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                  column flex=1 gap="theme.space.xs"
                    box height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill"
                    row align-items="center" gap="theme.space.md"
                      box height="theme.space.xs" flex=1 background-color="theme.color.fill" border-radius="theme.radius.pill"
                      box width="blocks.stamp" height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0
            else
              if events.length == 0
                text activityEmptyText testId=`${testId}-activity-empty` padding="theme.space.lg" font="theme.type.body" color="theme.color.ink-muted"
              for e, i in events key=e.key
                // What happened on its own line, then who and when on one meta line, the when at the row's end
                // edge where the facts' values sit.
                row role="listitem" min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                  column flex=1 min-width=0 gap="theme.space.xs"
                    text e.what testId=`${testId}-event-${e.key}` font="theme.type.body" color="theme.color.ink"
                    row align-items="baseline" gap="theme.space.md"
                      text e.who font="theme.type.caption" color="theme.color.ink-muted" flex=1 min-width=0
                      text e.when font="theme.type.caption" color="theme.color.ink-muted" text-align="end" flex-shrink=0
