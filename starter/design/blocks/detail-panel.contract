// The detail of one record, alone or inside a screen's column: a header (the title with its status tag beside it,
// up to two actions), the record's facts as definition rows, a notes paragraph, and its activity at the end. The
// panel keeps one measure (`blocks.detail-max`) and groups by space, not by frames: facts and activity are rows,
// divided by the one meaningful line, their labels one quiet step above; the notes sit on the fill ground as prose;
// the record's own work (loading, a save in flight) says itself as a chip on the same fill ground beside the tag.
// The one filled focal element is the primary action; the rest is quiet. Wide, the record's groups hold the left
// column and the activity stands beside them at the end (columns that wrap at `blocks.detail-min`, so a phone
// stacks them); every label, term and row starts at the column's left edge, and time stamps end at its right.
//
// States: `data` one record, loading, failed and long content; `agent` none, changed (a changed value carries the
// kit's mark with `changedNote`, the ledger's "did" sentence) and waiting (`waitingNote`, its "asks" sentence, is
// the calm line the person must answer). The buttons' `interaction` is the app's: busy while a write is in flight
// (the chip turning with `busyNote`, the platform's own progress), disabled when it means to refuse them. Loading
// claims nothing: quiet bars stand where the facts' terms and values and the activity's lines sit, and the notes'
// ground holds the paragraph's place, so completing a load moves nothing. The record that failed says so with the
// kit's severity language - one semantic border in the critical ink, the message in the error's own ink, a warning
// triangle at its side - and offers the way on: `retryLabel` naming it, `retryPress` being the app's own action;
// what did not arrive says nothing. A fact reads as a definition - its term in a fixed column, its value one type
// step stronger flowing after it; a value long enough to be a paragraph reads as prose under its term. Every word is
// a prop; rows arrive by shape (Fact, Event), and the rows themselves are the small local components below
// (FactRow, EventRow, their quiet stand-ins, the chip), each drawn once.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton, Tag from "__SCOPE__/components"

// One fact of the record: its key, the label it reads as, and its value.
shape Fact
  key: string
  label: string
  value: string

// One entry in the record's activity: who did what, and when.
shape Event
  key: string
  who: string
  what: string
  when: string

// A value long enough to be a paragraph no longer reads as a column but as prose: such a fact stacks its
// value under its term (the value keeps the row's full width).
fn factStacks(v: string): bool = v.length > 60

// A section's label: one quiet step above its rows, at the panel's left rail.
component GroupLabel
  props
    text: string
    testId: string
  view
    Words(text=text, kind="heading", outcome="none", level=3, testId=testId)

// The record's own work said as a chip: the platform's progress turning with the app's words, on the fill ground
// with no frame. (The spinner keeps the platform's grey: NSProgressIndicator takes no tint.)
component StatusChip
  props
    text: string
    testId: string
    speak: bool
  view
    row role=(speak ? "status" : "none") gap="theme.space.xs" align-items="center" background-color="theme.color.fill" border-radius="theme.radius.pill" padding-left="theme.space.sm" padding-right="theme.space.sm" margin-left="theme.space.sm" testId=testId
      progress aria-label=text width="blocks.spin" height="blocks.spin"
      text text testId=`${testId}-text` font="theme.type.caption" color="theme.color.ink"

// One fact as a definition's row: the term in a fixed column at the left rail, the value flowing after it,
// one type step stronger; a long value reads as prose under its term.
component FactRow
  props
    fact: Fact
    testId: string
    first: bool
  view
    if factStacks(fact.value)
      column role="listitem" justify-content="center" gap="theme.space.xs" min-height="components.row-min" box-sizing="border-box" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(first ? "0" : "theme.line.width") border-top-style="solid" border-top-color="theme.color.line"
        text fact.label testId=`${testId}-label` font="theme.type.body" color="theme.color.ink"
        text fact.value font="theme.type.body" color="theme.color.ink"
    else
      row role="listitem" align-items="baseline" gap="theme.space.md" min-height="components.row-min" box-sizing="border-box" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(first ? "0" : "theme.line.width") border-top-style="solid" border-top-color="theme.color.line"
        text fact.label testId=`${testId}-label` width="blocks.term" font="theme.type.body" color="theme.color.ink"
        text fact.value flex=1 min-width=0 font="theme.type.label" color="theme.color.ink"

// One entry of the activity as a row: what happened on its own line, then who and when on one meta line, the when
// at the panel's right rail where the facts' values sit.
component EventRow
  props
    event: Event
    testId: string
    first: bool
  view
    row role="listitem" min-height="components.row-min" box-sizing="border-box" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(first ? "0" : "theme.line.width") border-top-style="solid" border-top-color="theme.color.line"
      column flex=1 min-width=0 gap="theme.space.xs"
        text event.what testId=`${testId}-what` font="theme.type.body" color="theme.color.ink"
        row align-items="baseline" gap="theme.space.md"
          text event.who font="theme.type.caption" color="theme.color.ink-muted" flex=1 min-width=0
          text event.when font="theme.type.caption" color="theme.color.ink-muted" text-align="end" flex-shrink=0

// The quiet stand-in for a fact's row while the record is on its way: a bar the term's width, a bar where the
// value flows.
component GhostFact
  view
    row aria-hidden=true min-height="components.row-min" box-sizing="border-box" padding-top="theme.space.md" padding-bottom="theme.space.md" align-items="center" gap="theme.space.md"
      box width="blocks.term" height="theme.space.md" background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill" flex-shrink=0
      box height="theme.space.md" flex=1 background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"

// The quiet stand-in for an activity row: the what's line, then the who's line with the when's stamp at the end.
component GhostEvent
  view
    row aria-hidden=true min-height="components.row-min" box-sizing="border-box" padding-top="theme.space.md" padding-bottom="theme.space.md"
      column flex=1 gap="theme.space.sm"
        box height="theme.space.md" background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"
        box height="theme.space.md" background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"

component DetailPanel
  props
    testId: string
    title: string
    statusLabel: string
    status: enum<"none", "success", "error", "blocked", "cancelled">
    primaryLabel: string
    primaryPress: action
    secondaryLabel: string
    secondaryPress: action
    interaction: enum<"idle", "busy", "disabled">
    busyNote: string
    changedNote: string
    waitingNote: string
    retryLabel: string
    retryPress: action
    factsTitle: string
    facts: Fact[]
    factsEmptyText: string
    notesTitle: string
    notes: string
    activityTitle: string
    events: Event[]
    activityEmptyText: string
    loadingText: string
    failedText: string
    data: enum<"one", "loading", "failed", "long">
    agent: enum<"none", "changed", "waiting">
  view
    column testId=testId width="100%" max-width="blocks.detail-max" margin-left="auto" margin-right="auto" box-sizing="border-box" gap="theme.space.xl"
      row flex-wrap="wrap" align-items="flex-start" gap="theme.space.lg"
        column flex=1 min-width="blocks.header-min" box-sizing="border-box" gap="theme.space.xs"
          row flex-wrap="wrap" align-items="baseline" gap="theme.space.md"
            Words(text=title, kind="title", outcome="none", level=2, testId=`${testId}-title`)
            if statusLabel != ""
              Tag(text=statusLabel, outcome=status)
            if data == "loading"
              StatusChip(text=loadingText, testId=`${testId}-loading`, speak=true)
            if interaction == "busy" and busyNote != ""
              StatusChip(text=busyNote, testId=`${testId}-busy`, speak=false)
          if agent == "changed" or agent == "waiting"
            row flex-wrap="wrap" align-items="center" gap="theme.space.sm"
              row min-width=0 gap="theme.space.sm" padding-left="theme.space.sm" border-left-width="components.mark-line" border-left-style="solid" border-left-color=(agent == "waiting" ? "theme.color.caution" : "theme.color.accent")
                text (agent == "waiting" ? waitingNote : changedNote) testId=`${testId}-agent` font="theme.type.caption" color=(agent == "waiting" ? "theme.color.caution-text" : "theme.color.accent")
        if primaryLabel != "" or secondaryLabel != ""
          row flex-wrap="wrap" align-items="center" gap="theme.space.sm"
            if secondaryLabel != ""
              ActionButton(label=secondaryLabel, kind="plain", interaction=interaction, outcome="none", press=secondaryPress, testId=`${testId}-secondary`)
            if primaryLabel != ""
              ActionButton(label=primaryLabel, kind="primary", interaction=interaction, outcome="none", press=primaryPress, testId=`${testId}-primary`)
      if data == "failed"
        // The failure is the record's, said the way the kit's notice says an act: one block lifted on the surface
        // ground, the one semantic border in the critical ink, a warning triangle at the message's side, the words
        // in the error's ink filling the line - and the way on at its end, a quiet button of the app's own words.
        // What did not arrive says nothing.
        row testId=`${testId}-failed` role="alert" flex-wrap="wrap" align-items="center" gap="theme.space.md" padding="theme.space.lg" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.critical"
          row flex=1 min-width=0 gap="theme.space.sm" align-items="center"
            svg viewBox="0 0 16 16" width="blocks.spin" height="blocks.spin" fill="none" stroke="theme.color.critical" aria-hidden=true flex-shrink=0
              path d="M8 2.5L14.5 13.5H1.5Z" stroke-width=1.3 stroke-linejoin="round"
              path d="M8 6.5L8 9.5" stroke-width=1.3 stroke-linecap="round"
              circle cx=8 cy=11.6 r=0.7 fill="theme.color.critical" stroke="none"
            Words(text=failedText, kind="body", outcome="error", level=0, testId=`${testId}-failed-text`)
          if retryLabel != ""
            row
              ActionButton(label=retryLabel, kind="plain", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=retryPress, testId=`${testId}-retry`)
      else
        // Wide, the record's own groups sit in the left column and its activity beside them at the end; a phone
        // stacks the two columns unchanged. The columns are bare rows, so the shorter one ends on the page, not
        // in the air.
        row flex-wrap="wrap" align-items="flex-start" gap="theme.space.xl"
          column flex=1 min-width="blocks.detail-min" box-sizing="border-box" gap="theme.space.xl"
            column gap="theme.space.sm"
              if factsTitle != ""
                GroupLabel(text=factsTitle, testId=`${testId}-facts-title`)
              column testId=`${testId}-facts` role=(data == "loading" ? "none" : facts.length == 0 ? "status" : "list")
                if data == "loading"
                  for n in [1, 2, 3, 4] key=n
                    GhostFact()
                else
                  if facts.length == 0
                    text factsEmptyText testId=`${testId}-facts-empty` padding-top="theme.space.md" padding-bottom="theme.space.md" font="theme.type.body" color="theme.color.ink-muted"
                  for f, i in facts key=f.key
                    FactRow(fact=f, testId=`${testId}-fact-${f.key}`, first=(i == 0))
            if notes != ""
              column gap="theme.space.sm"
                if notesTitle != ""
                  GroupLabel(text=notesTitle, testId=`${testId}-notes-title`)
                if data == "loading"
                  // The fill ground holds the paragraph's place, cut out where its lines will sit.
                  column aria-hidden=true min-height="blocks.notes-hold" background-color="theme.color.fill" border-radius="theme.radius.card" padding="theme.space.lg" gap="theme.space.sm" testId=`${testId}-notes-hold`
                    box height="theme.space.md" flex=1 background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"
                    box height="theme.space.md" flex=1 background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"
                    box width="blocks.term" height="theme.space.md" background-color="theme.color.ink" opacity=0.12 border-radius="theme.radius.pill"
                else
                  text notes testId=`${testId}-notes-text` padding="theme.space.lg" background-color="theme.color.fill" border-radius="theme.radius.card" font="theme.type.body" color="theme.color.ink"
          column flex=1 min-width="blocks.detail-min" box-sizing="border-box"
            column gap="theme.space.sm"
              if activityTitle != ""
                GroupLabel(text=activityTitle, testId=`${testId}-activity-title`)
              column testId=`${testId}-activity` role=(data == "loading" ? "none" : events.length == 0 ? "status" : "list")
                if data == "loading"
                  for n in [1, 2, 3] key=n
                    GhostEvent()
                else
                  if events.length == 0
                    text activityEmptyText testId=`${testId}-activity-empty` padding-top="theme.space.md" padding-bottom="theme.space.md" font="theme.type.body" color="theme.color.ink-muted"
                  for e, i in events key=e.key
                    EventRow(event=e, testId=`${testId}-event-${e.key}`, first=(i == 0))
