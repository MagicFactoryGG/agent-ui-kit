// A data table of records: a header row of column labels, the sorted column marked (its label in ink, an arrow,
// `aria-sort`), a status as a filled pill in the record's own `tone` (a colour a person can scan: the theme's
// status tokens, not one grey for everything), a checkbox a row (a name of `selectLabel` and the record's title;
// the app owns the selection, `toggle` gets the row's key, `toggleAll` the whole set) and a select-all checkbox in
// the header. A long title wraps where it is (never cut: Exact's check reads a cut as clipped content, and the
// person keeps every word). Cells sit edge to edge (`border-spacing=0`: the separated model's own gap would stripe a washed
// row), so a checked row takes one fill band and the rules run the card's width. Rows an agent changed carry
// the accent mark at their start while `agentNote` says so under the table. On a desktop row the title is the
// one affordance (its own link); a chevron would spend a column to say what the link already says, so the
// chevron belongs to the compact phone row alone. The card centres on a wide window up to `blocks.table-max`,
// and the fixed columns hug what they hold, so the title column takes the width that is left and a title wraps
// only when the card is truly full — a table that wraps its titles while air sits locked in over-wide columns
// lies about its room. The status column centres its pills under its label (a chip reads from its middle; the
// skeleton holds the same axis, so nothing jumps when the rows arrive). On a window narrower than 640px (the
// table's comfortable floor) the table becomes a list of compact rows — the title across the card's full
// width (it wraps only when the card is truly full), then the status pill opening the meta line with owner and
// date after it — and the table never scrolls sideways. While empty, loading or failed the table keeps its
// frame — the select-all step is simply absent while there is nothing to select (a waiting box would imply a
// bulk act that cannot happen) — and the state holds `blocks.state-max` at the card's middle: the failed
// state's warning mark above its message and the retry, the empty state's message and its `create`, both the
// primary act of a contentless state. While loading four quiet rows hold the loaded rows' own slots and rules
// (no invented data, still under the person's motion preference), so the frame does not move when the rows
// arrive, and the app's loading line sits under them in the card's foot (a status, seen and said, in both
// layouts). The foot carries the agent's mark too, at the same edge as the rows it marks, so the note and the
// rows read as one sign. States: data
// many|one|empty|loading|failed|long, interaction idle|busy (the card says it, and the checkboxes wait),
// agent none|changed. Every word is a prop.
use Words, ActionButton from "__SCOPE__/components"

// One record: its key, what it says, a status word in a tone a person can scan, who owns it, when it changed,
// where it opens. The tone is the app's (or its agent's) reading of its own status vocabulary: neutral sits
// quiet, progress is moving, done is finished, attention asks for an eye.
shape Record
  key: string
  title: string
  status: string
  tone: enum<"neutral", "progress", "done", "attention">
  owner: string
  updated: string
  href: string

// The rows the person has checked, by key (the compiler owns the name `Selection`). The app owns this value;
// a person's checkbox and an agent's tool write it with the same function.
shape Checked
  keys: string[]

// The rows an agent changed, by key: while `agent` says "changed", these rows carry the mark.
shape Marks
  keys: string[]

// The window's width, and the person's motion preference: the facts this block reads to lay itself out.
shape Viewport
  width: number
  prefersReducedMotion: bool

keyframes breathe
  50% opacity=0.4

fn marked(agent: string, marks: Marks, key: string): bool = agent == "changed" and marks.keys.includes(key)
fn markInk(on: bool): string = on ? "theme.color.accent" : "transparent"

// The theme's status tokens, one per tone: the word in the ink that reads on a wash (`-text` for the statuses,
// the accent for progress), the dot in the fill a shape may carry. The neutral's own grey says "nothing to see"
// without breaking the pill's shape.
fn toneInk(t: string): string = t == "progress" ? "theme.color.accent" : t == "done" ? "theme.color.positive-text" : t == "attention" ? "theme.color.caution-text" : "theme.color.ink-muted"
fn toneDot(t: string): string = t == "progress" ? "theme.color.accent" : t == "done" ? "theme.color.positive" : t == "attention" ? "theme.color.caution" : "theme.color.ink-muted"

// The small arrow that marks the sorted column, in the ink its header carries.
component SortArrow
  props
    dir: enum<"ascending", "descending">
    ink: string
  view
    svg viewBox="0 0 12 12" width="blocks.glyph" height="blocks.glyph" fill="none" stroke=ink aria-hidden=true flex-shrink=0
      path d="M6 2.5V9.5" stroke-width=1.5 stroke-linecap="round"
      if dir == "ascending"
        path d="M3.5 5L6 2.5L8.5 5" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
      else
        path d="M3.5 7L6 9.5L8.5 7" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

// A record's status as a filled pill: the tone's dot (the neutral's is grey — one component, not a pill with a
// piece missing) and word on the page's own wash, the lightest ground the theme names and the one every status
// ink clears 4.5:1 on in both modes (the done ink reads 4.4:1 on the hover wash). A fill, not a border, so it
// holds on any row background — a checked row's own fill included — and on any party's Theme, for every name it
// reads is a token the theme tool requires of every theme. It never shrinks (a table cell grows its column
// instead, a phone title wraps instead), and it is drawn twice (the desktop column, the phone title line), so
// it lives here as the block's one local piece.
component StatusPill
  props
    text: string
    tone: enum<"neutral", "progress", "done", "attention">
  view
    row align-items="center" gap="theme.space.xs" padding-left="theme.space.sm" padding-right="theme.space.sm" background-color="theme.color.page" border-radius="theme.radius.pill" flex-shrink=0
      box width="blocks.tone-dot" height="blocks.tone-dot" border-radius="theme.radius.pill" background-color=toneDot(tone)
      text text font="theme.type.caption" color=toneInk(tone)

// The failed state's own mark: a small warning triangle in the theme's critical colour, above the message, so
// a glance tells failed from empty before a word is read. Drawn in both layouts, so it lives here too.
component StateGlyph
  props
    ink: string
  view
    svg viewBox="0 0 20 20" width="blocks.state-glyph" height="blocks.state-glyph" fill="none" stroke=ink aria-hidden=true
      path d="M10 3.5L17.5 16.5H2.5Z" stroke-width=1.8 stroke-linejoin="round"
      path d="M10 8.5V11.5" stroke-width=1.8 stroke-linecap="round"
      path d="M10 14H10.01" stroke-width=1.8 stroke-linecap="round"

component DataTable
  props
    records: Record[]
    checked: Checked
    marks: Marks
    titleLabel: string
    statusLabel: string
    ownerLabel: string
    updatedLabel: string
    selectLabel: string
    selectAllLabel: string
    emptyText: string
    loadingText: string
    failedText: string
    busyText: string
    agentNote: string
    retryLabel: string
    createLabel: string
    sort: enum<"none", "title", "status", "owner", "updated">
    sortDir: enum<"ascending", "descending">
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    interaction: enum<"idle", "busy">
    agent: enum<"none", "changed">
    toggle: action
    toggleAll: action
    retry: action
    create: action
    testId: string
  // The checkbox events become by-key acts: the same `toggle` a person's checkbox runs, an agent's tool runs.
  action pick(key: string, on: bool)
    toggle(key)
  action pickAll(on: bool)
    toggleAll()
  resource viewport = exactViewport() as shape Viewport
  derive narrow = viewport.width < 640
  derive still = viewport.prefersReducedMotion
  derive noRows = data == "empty" or data == "loading" or data == "failed"
  derive allOn = records.length > 0 and checked.keys.length == records.length
  derive pulse = still ? "none" : "breathe 1.6s ease-in-out infinite"
  derive note = data == "empty" ? emptyText : data == "loading" ? loadingText : failedText
  view
    column testId=testId aria-busy=(interaction == "busy") width="100%" max-width="blocks.table-max" margin-left="auto" margin-right="auto" box-sizing="border-box" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden"
      if narrow
        if data == "loading"
          for n in [0, 1, 2, 3] key=n
            row align-items="center" gap="theme.space.md" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
              box width="blocks.skel-check" height="blocks.skel-check" background-color="theme.color.fill" border-radius="calc(theme.radius.control / 2)" animation=pulse
              column flex=1 min-width=0 gap="theme.space.xs"
                box width="60%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.control" animation=pulse
                box width="35%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.control" animation=pulse
        else
          if noRows
            column padding="theme.space.lg" gap="theme.space.md" role=(data == "failed" ? "alert" : "status") align-items="center" text-align="center" max-width="blocks.state-max" margin-left="auto" margin-right="auto" box-sizing="border-box"
              if data == "failed"
                StateGlyph(ink="theme.color.critical")
              Words(text=note, kind="body", outcome=(data == "failed" ? "error" : "cancelled"), level=0, testId=`${testId}-${data}`)
              if data == "failed" and retryLabel != ""
                row
                  ActionButton(label=retryLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=retry, testId=`${testId}-retry`)
              if data == "empty" and createLabel != ""
                row
                  ActionButton(label=createLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=create, testId=`${testId}-create`)
          else
            if sort != "none"
              row align-items="center" gap="theme.space.xs" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
                text (sort == "title" ? titleLabel : sort == "status" ? statusLabel : sort == "owner" ? ownerLabel : updatedLabel) font="theme.type.caption" color="theme.color.ink-muted"
                SortArrow(dir=sortDir, ink="theme.color.ink-muted")
            for r, i in records key=r.key
              row align-items="center" gap="theme.space.md" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" background-color=(checked.keys.includes(r.key) ? "theme.color.fill" : "transparent") border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color=markInk(marked(agent, marks, r.key))
                input type="checkbox" checked=checked.keys.includes(r.key) change=pick(r.key) disabled=(interaction == "busy") aria-label=`${selectLabel} ${r.title}` flex-shrink=0 testId=`${testId}-check-${r.key}`
                column flex=1 min-width=0 gap="theme.space.xs"
                  link href=r.href color="theme.color.ink" testId=`${testId}-link-${r.key}`
                    :hover
                      color="theme.color.accent"
                    text r.title font="theme.type.label"
                  row align-items="center" gap="theme.space.sm"
                    StatusPill(text=r.status, tone=r.tone)
                    text `${r.owner} · ${r.updated}` font="theme.type.caption" color="theme.color.ink-muted" flex=1 min-width=0
                svg viewBox="0 0 12 12" width="blocks.glyph" height="blocks.glyph" fill="none" stroke="theme.color.ink-muted" aria-hidden=true flex-shrink=0
                  path d="M4.5 2.5L8 6l-3.5 3.5" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
      else
        table testId=`${testId}-table` width="100%" border-spacing=0
          thead
            tr
              th scope="col" width="blocks.select-col" box-sizing="border-box" text-align="start" padding-left="theme.space.lg" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color="transparent"
                if not noRows
                  input type="checkbox" checked=allOn change=pickAll disabled=(interaction == "busy") aria-label=selectAllLabel testId=`${testId}-check-all`
              th scope="col" aria-sort=(sort == "title" ? sortDir : "none") text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
                row align-items="center" gap="theme.space.xs"
                  text titleLabel font="theme.type.caption" color=(sort == "title" ? "theme.color.ink" : "theme.color.ink-muted")
                  if sort == "title"
                    SortArrow(dir=sortDir, ink="theme.color.ink")
              th scope="col" width="blocks.col-status" aria-sort=(sort == "status" ? sortDir : "none") text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
                row align-items="center" gap="theme.space.xs" justify-content="center"
                  text statusLabel font="theme.type.caption" color=(sort == "status" ? "theme.color.ink" : "theme.color.ink-muted")
                  if sort == "status"
                    SortArrow(dir=sortDir, ink="theme.color.ink")
              th scope="col" width="blocks.col-owner" aria-sort=(sort == "owner" ? sortDir : "none") text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
                row align-items="center" gap="theme.space.xs"
                  text ownerLabel font="theme.type.caption" color=(sort == "owner" ? "theme.color.ink" : "theme.color.ink-muted")
                  if sort == "owner"
                    SortArrow(dir=sortDir, ink="theme.color.ink")
              th scope="col" width="blocks.col-updated" aria-sort=(sort == "updated" ? sortDir : "none") text-align="end" padding-left="theme.space.md" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
                row align-items="center" gap="theme.space.xs" justify-content="flex-end"
                  text updatedLabel font="theme.type.caption" color=(sort == "updated" ? "theme.color.ink" : "theme.color.ink-muted")
                  if sort == "updated"
                    SortArrow(dir=sortDir, ink="theme.color.ink")
          if data == "loading"
            tbody
              for n in [0, 1, 2, 3] key=n
                tr
                  td height="blocks.row-min" text-align="start" padding-left="theme.space.lg" padding-right="theme.space.md" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color="transparent"
                    box width="blocks.skel-check" height="blocks.skel-check" background-color="theme.color.fill" border-radius="calc(theme.radius.control / 2)" animation=pulse
                  td height="blocks.row-min" padding-left="theme.space.md" padding-right="theme.space.md" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    box width="55%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.control" animation=pulse
                  td height="blocks.row-min" padding-left="theme.space.md" padding-right="theme.space.md" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    row justify-content="center"
                      box width="80%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
                  td height="blocks.row-min" padding-left="theme.space.md" padding-right="theme.space.md" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    box width="50%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.control" animation=pulse
                  td height="blocks.row-min" text-align="end" padding-left="theme.space.md" padding-right="theme.space.lg" border-top-width=(n > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                    row justify-content="flex-end"
                      box width="40%" height="blocks.skel-bar" background-color="theme.color.fill" border-radius="theme.radius.control" animation=pulse
          else
            if noRows
              tbody
                tr
                  td colspan=5 text-align="center" height="blocks.state-min" padding-left="theme.space.lg" padding-right="theme.space.lg" role=(data == "failed" ? "alert" : "status")
                    column gap="theme.space.md" align-items="center" max-width="blocks.state-max" margin-left="auto" margin-right="auto" box-sizing="border-box"
                      if data == "failed"
                        StateGlyph(ink="theme.color.critical")
                      Words(text=note, kind="body", outcome=(data == "failed" ? "error" : "cancelled"), level=0, testId=`${testId}-${data}`)
                      if data == "failed" and retryLabel != ""
                        row
                          ActionButton(label=retryLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=retry, testId=`${testId}-retry`)
                      if data == "empty" and createLabel != ""
                        row
                          ActionButton(label=createLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=create, testId=`${testId}-create`)
            else
              tbody
                for r, i in records key=r.key
                  tr background-color=(checked.keys.includes(r.key) ? "theme.color.fill" : "transparent")
                    td text-align="start" padding-left="theme.space.lg" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color=markInk(marked(agent, marks, r.key))
                      input type="checkbox" checked=checked.keys.includes(r.key) change=pick(r.key) disabled=(interaction == "busy") aria-label=`${selectLabel} ${r.title}` testId=`${testId}-check-${r.key}`
                    td text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                      link href=r.href color="theme.color.ink" testId=`${testId}-link-${r.key}`
                        :hover
                          color="theme.color.accent"
                        text r.title font="theme.type.body"
                    td text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                      row justify-content="center"
                        StatusPill(text=r.status, tone=r.tone)
                    td text-align="start" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                      text r.owner font="theme.type.body" color="theme.color.ink-muted"
                    td text-align="end" padding-left="theme.space.md" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                      text r.updated font="theme.type.body" color="theme.color.ink-muted" font-variant-numeric="tabular-nums"
      if agent == "changed" or interaction == "busy" or data == "loading"
        column gap="theme.space.xs" border-top-width="theme.line.width" border-top-style="solid" border-top-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color=markInk(agent == "changed") padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md"
          if agent == "changed"
            text agentNote font="theme.type.caption" color="theme.color.accent" testId=`${testId}-agent`
          if data == "loading"
            text loadingText role="status" font="theme.type.caption" color="theme.color.ink-muted" testId=`${testId}-loading`
          if interaction == "busy"
            text busyText role="status" font="theme.type.caption" color="theme.color.ink-muted" testId=`${testId}-busy`
