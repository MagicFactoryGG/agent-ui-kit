// CommandMenu: a command menu's panel, the kind a key opens: the search field on top, then the results in
// titled groups, the highlighted one filled, each command's shortcut as small keys at its end. Every command is a
// tool an agent can call too (packages/commands' rule): a person's press on a row and the agent's call run the same
// act in the app, and what the agent ran is marked on its row and said once above the results, with Undo.
//
// - The panel is a named region, not a dialog: the app presents it (a sheet, a route with a modal presentation),
//   which gives Escape, a kept focus and the platform's own sheet; `role="dialog"` on a column would only name one
//   (Exact's lower-dialog-role).
// - The app owns the query and the results: it filters (the person's typing is view state, an agent acts on
//   commands by key, never on the query) and passes the commands that match, the highlighted key and `data`.
// - Width: a phone takes the whole width and the results take the height left under the field (their own
//   scroll); on a desktop the panel holds a command menu's measure (blocks.command-menu-max), centred, so a
//   row's label and its keys stay within one glance instead of across the screen.
// - Grouping is by space and type: a group's name is a muted heading over its rows, theme.space.md between
//   groups; the only lines are the panel's frame and the hairline that closes the search band.
// - One filled element per state: the highlighted row (many, one, long, changed); while an agent's proposal
//   waits, its Run instead (no row is filled, the proposed row wears the accent line); empty's Clear search;
//   failed's Try again. Loading fills nothing: ghost rows breathe in the rows' own geometry.
// - Status words sit on the surface, never on a tint: empty and loading in the muted ink, failed in the
//   critical ink, each with the way on beside its words.
// - Long labels wrap whole inside their row (the keys keep their place at the end).
//
// States:
//   data   many|one|empty|loading|failed|long
//   agent  none|proposed|changed
use Words, ActionButton, Field, PressRow from "__SCOPE__/components"

// One command: `group` titles the results it sits in (first-seen order), `hint` says what it does, `shortcut` its
// keys, separated by spaces ("⌘ K"; "" for none).
shape Command
  key: string
  group: string
  label: string
  hint: string
  shortcut: string

fn commandMenuKeys(shortcut: string): string[] = shortcut.split(" ").filter(k => k != "")

// A state's words and its one way on, in the results' own place: on the surface, at the rows' inset.
component CommandMenuState
  props
    text: string
    actionLabel: string
    failed: bool
    press: action
    testId: string
  view
    column testId=testId role=(failed ? "alert" : "status") gap="theme.space.md" align-items="flex-start" padding="theme.space.md"
      Words(text=text, kind="body", outcome=(failed ? "error" : "cancelled"), level=0, testId=`${testId}-text`)
      if actionLabel != ""
        ActionButton(label=actionLabel, kind="primary", interaction="idle", outcome="none", press=press, testId=`${testId}-action`)

// A command still coming: the row's own height and inset, a bar for its label and one for its keys.
component CommandMenuGhost
  props
    wide: bool
  view
    row align-items="center" gap="theme.space.md" min-height="blocks.command-menu-row" box-sizing="border-box" padding-left="theme.space.md" padding-right="theme.space.md" aria-hidden=true
      column flex=1 min-width=0
        box width=(wide ? "blocks.command-menu-ghost-wide" : "blocks.command-menu-ghost") max-width="100%" height="blocks.command-menu-bone" background-color="theme.color.ink-muted" opacity=0.5 border-radius="theme.radius.pill"
      box width="blocks.command-menu-ghost-keys" height="blocks.command-menu-bone" flex-shrink=0 background-color="theme.color.ink-muted" opacity=0.5 border-radius="theme.radius.pill"

// A group's name, over its rows.
component CommandMenuHeading
  props
    text: string
    testId: string
  view
    row padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.xs" padding-bottom="theme.space.xs"
      Words(text=text, kind="heading", outcome="none", level=2, testId=testId)

component CommandMenu
  props
    title: string
    searchLabel: string
    placeholder: string
    query: string
    hint: string
    commands: Command[]
    highlight: string
    emptyText: string
    clearLabel: string
    loadingText: string
    failedText: string
    retryLabel: string
    agentKey: string
    agentNote: string
    undoLabel: string
    proposalText: string
    acceptLabel: string
    rejectLabel: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    agent: enum<"none", "proposed", "changed">
    search: action
    run: action
    clear: action
    retry: action
    undo: action
    accept: action
    reject: action
    testId: string
  derive names = commands.map(c => c.group)
  derive groups = names.filter((g, i) => names.indexOf(g) == i)
  derive shows = data == "many" or data == "one" or data == "long"
  view
    row flex=1 width="100%" justify-content="center" align-items="stretch"
      column testId=testId role="region" aria-label=title flex=1 min-width=0 max-width="blocks.command-menu-max" box-sizing="border-box" background-color="theme.color.surface" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-radius="theme.radius.card" overflow="hidden"
        column padding="theme.space.lg" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
          Field(id=`${testId}-search`, label=searchLabel, hint=hint, error="", outcome="none")
            input type="search" value=query input=search placeholder=placeholder aria-label=searchLabel testId=`${testId}-search` width="100%" min-width=0 min-height="blocks.command-menu-row" box-sizing="border-box" padding-left="theme.space.md" padding-right="theme.space.md" font="theme.type.body" color="theme.color.ink" background-color="theme.color.page" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-radius="theme.radius.control"
        if agent == "proposed"
          column testId=`${testId}-proposal` role="status" gap="theme.space.md" padding="theme.space.lg" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line" border-left-width="blocks.command-menu-mark" border-left-style="solid" border-left-color="theme.color.accent"
            Words(text=proposalText, kind="body", outcome="none", level=0, testId=`${testId}-proposal-text`)
            row gap="theme.space.sm" flex-wrap="wrap" justify-content="flex-end"
              ActionButton(label=rejectLabel, kind="plain", interaction="idle", outcome="none", press=reject, testId=`${testId}-reject`)
              ActionButton(label=acceptLabel, kind="primary", interaction="idle", outcome="none", press=accept, testId=`${testId}-accept`)
        if agent == "changed"
          row testId=`${testId}-changed` role="status" align-items="center" flex-wrap="wrap" gap="theme.space.md" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.sm" padding-bottom="theme.space.sm" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line" border-left-width="blocks.command-menu-mark" border-left-style="solid" border-left-color="theme.color.accent"
            column flex=1 min-width="blocks.command-menu-note-min"
              Words(text=agentNote, kind="body", outcome="none", level=0, testId=`${testId}-changed-text`)
            ActionButton(label=undoLabel, kind="plain", interaction="idle", outcome="none", press=undo, testId=`${testId}-undo`)
        column flex=1 min-height=0 overflow-y="auto" padding="theme.space.sm" gap="theme.space.md"
          if data == "loading"
            column role="status" aria-busy=true gap="theme.space.xs"
              row padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.xs" padding-bottom="theme.space.xs"
                Words(text=loadingText, kind="caption", outcome="none", level=0, testId=`${testId}-loading`)
              CommandMenuGhost(wide=true)
              CommandMenuGhost(wide=false)
              CommandMenuGhost(wide=true)
          if data == "empty"
            CommandMenuState(text=emptyText, actionLabel=clearLabel, failed=false, press=clear, testId=`${testId}-empty`)
          if data == "failed"
            CommandMenuState(text=failedText, actionLabel=retryLabel, failed=true, press=retry, testId=`${testId}-failed`)
          if shows
            for g in groups key=g
              column role="group" aria-label=g gap="theme.space.xs"
                CommandMenuHeading(text=g, testId=`${testId}-group-${groups.indexOf(g)}`)
                for c in commands.filter(c => c.group == g) key=c.key
                  PressRow(label=c.label, detail=c.hint, keys=commandMenuKeys(c.shortcut), on=(agent != "proposed" and c.key == highlight), agentNote="", interaction="idle", agent=(c.key == agentKey and agent == "proposed" ? "proposed" : c.key == agentKey and agent == "changed" ? "changed" : "none"), press=run(c.key), testId=`${testId}-${c.key}`)
