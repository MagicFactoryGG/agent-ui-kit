// One block for a whole area's empty, loading and failed states: a calm centred panel, its card, shape and type
// all Theme tokens (no image file). The drawn shape says the state: a blank card holding one unwritten line
// (empty), a broken arc in the accent, the one active colour (loading), a filled alert form (failed). Loading
// keeps the title (so a reader hears what loads, role=status) and stands in three stepped skeleton lines for the
// rest; the one action is primary whenever it shows, the retry in failed as in empty. `size` "full" is the whole
// area's panel; "compact" keeps the type and claims less width, for a card's body or a side panel. No agent axis,
// as Section: nothing here for an agent to change or wait on; the app's notice says it.
use Words, ActionButton from "__SCOPE__/components"

component StatePanel
  props
    title: string
    message: string
    actionLabel: string
    data: enum<"empty", "loading", "failed">
    size: enum<"full", "compact">
    press: action
    testId: string
  view
    column testId=testId role=(data == "failed" ? "alert" : data == "loading" ? "status" : "none") width="100%" max-width=(size == "full" ? "blocks.panel-max" : "blocks.panel-compact") margin-left="auto" margin-right="auto" box-sizing="border-box" padding=(size == "full" ? "theme.space.xxl" : "theme.space.xl") align-items="center" text-align="center" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line"
      svg viewBox="0 0 24 24" width=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") height=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") aria-hidden=true flex-shrink=0 margin-bottom=(size == "full" ? "theme.space.xl" : "theme.space.lg")
        if data == "failed"
          circle cx=12 cy=12 r=11 fill="theme.color.critical"
          line x1=12 y1=6.75 x2=12 y2=13 stroke="theme.color.critical-ink" stroke-width=2 stroke-linecap="round"
          circle cx=12 cy=16.75 r=1.3 fill="theme.color.critical-ink"
        else if data == "loading"
          circle cx=12 cy=12 r=10 fill="none" stroke="theme.color.accent" stroke-width=2.5 stroke-linecap="round" stroke-dasharray="47 16" transform="rotate(-90 12 12)"
        else
          rect x=4.5 y=4.5 width=15 height=15 rx=3.5 fill="none" stroke="theme.color.ink-muted" stroke-width=2
          line x1=8.5 y1=12 x2=15.5 y2=12 stroke="theme.color.ink-muted" stroke-width=2 stroke-linecap="round"
      column margin-bottom="theme.space.sm"
        Words(text=title, kind="title", outcome="none", level=2, testId=`${testId}-title`)
      if data == "loading"
        column testId=`${testId}-loading` width="100%" max-width="blocks.measure" gap="theme.space.md" align-items="center"
          box height="blocks.bone" width="100%" background-color="theme.color.fill" border-radius="theme.radius.pill"
          box height="blocks.bone" width="85%" background-color="theme.color.fill" border-radius="theme.radius.pill"
          box height="blocks.bone" width="60%" background-color="theme.color.fill" border-radius="theme.radius.pill"
      else
        column margin-bottom=(size == "full" ? "theme.space.xl" : "theme.space.lg")
          Words(text=message, kind="caption", outcome="none", level=0, testId=`${testId}-message`)
        if actionLabel != ""
          ActionButton(label=actionLabel, kind="primary", interaction="idle", outcome="none", press=press, testId=`${testId}-action`)
