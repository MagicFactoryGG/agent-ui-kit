// One block for a whole area's empty, loading and failed states: a calm centred panel, its card, shape and type
// all Theme tokens (no image file). The drawn shape says the state: an empty tray (empty), an arc in the accent,
// the one active colour (loading), a filled alert form (failed). The state line follows Section's own
// convention — body size, muted for empty and loading, the error's ink for failed — and shows in every state, so
// the panel always says in words what its area is (role=status speaks title and line while loading, role=alert in
// failed). Loading then stands the content in three stepped bones below the line, one per line at the body's
// rhythm (a bone and its gap are a 21px line), centred as the wrapped lines of a centred sentence are: real
// words above, placeholders below, nothing half-loaded. The card lifts by its raised ground alone, as
// SheetBody's does — space and surface, not a line around every box — and its ring is always 1px so no state
// change resizes the card; only failed takes the ring's colour, the critical hue, as Proposal's card takes the
// accent's (the failed signal is carried by the filled alert form and the error's ink; the ring is a whisper).
// The one action is primary whenever it shows, the retry in failed as in empty (red would say a destructive act,
// and a retry is the way on). `agent` "changed" marks a load an agent started — its tool calls the same action
// the button does, one ledger, two doors — and `agentNote` says so under the title in the accent ink, as TopBar
// says a waiting act under its own: a person's eye meets it at the heading, never among the placeholders.
// `size` "full" is the whole area's panel; "compact" claims less width and a tighter frame (padding, shape, the
// gap before the action), for a card's body or a side panel. The three bones are one small local component:
// markup drawn twice or more is drawn once.
use Words, ActionButton from "__SCOPE__/components"

// One skeleton line of the loading state: a bar of the fill colour at `share` of the measure.
component Bone
  props
    share: string
  view
    box height="blocks.bone" width=share background-color="theme.color.fill" border-radius="theme.radius.pill"

component StatePanel
  props
    title: string
    message: string
    agentNote: string
    actionLabel: string
    data: enum<"empty", "loading", "failed">
    agent: enum<"none", "changed">
    size: enum<"full", "compact">
    press: action
    testId: string
  view
    column testId=testId role=(data == "failed" ? "alert" : data == "loading" ? "status" : "none") width="100%" max-width=(size == "full" ? "blocks.panel-max" : "blocks.panel-compact") margin-left="auto" margin-right="auto" box-sizing="border-box" padding=(size == "full" ? "theme.space.xxl" : "theme.space.lg") align-items="center" text-align="center" background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color=(data == "failed" ? "theme.color.critical" : "transparent")
      svg viewBox="0 0 24 24" width=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") height=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") aria-hidden=true flex-shrink=0 margin-bottom=(size == "full" ? "theme.space.lg" : "theme.space.md")
        if data == "failed"
          circle cx=12 cy=12 r=11 fill="theme.color.critical"
          line x1=12 y1=6.75 x2=12 y2=13 stroke="theme.color.critical-ink" stroke-width=2 stroke-linecap="round"
          circle cx=12 cy=16.75 r=1.3 fill="theme.color.critical-ink"
        else if data == "loading"
          circle cx=12 cy=12 r=10 fill="none" stroke="theme.color.accent" stroke-width=2.5 stroke-linecap="round" stroke-dasharray="47 16" transform="rotate(-90 12 12)"
        else
          rect x=4.5 y=4.5 width=15 height=15 rx=3.5 fill="none" stroke="theme.color.ink-muted" stroke-width=2
          path d="M4.5 13h4.25l1.75 2.75h3L15.25 13h4.25" fill="none" stroke="theme.color.ink-muted" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      column width="100%" gap="theme.space.sm"
        Words(text=title, kind="title", outcome="none", level=2, testId=`${testId}-title`)
        if agent == "changed"
          text agentNote testId=`${testId}-agent` font="theme.type.caption" color="theme.color.accent"
        if message != ""
          Words(text=message, kind="body", outcome=(data == "failed" ? "error" : "cancelled"), level=0, testId=`${testId}-message`)
        if data == "loading"
          column testId=`${testId}-loading` width="100%" max-width="blocks.measure" align-items="center" gap="theme.space.sm"
            Bone(share="100%")
            Bone(share="85%")
            Bone(share="60%")
      if data != "loading" and actionLabel != ""
        column margin-top=(size == "full" ? "theme.space.xl" : "theme.space.md")
          ActionButton(label=actionLabel, kind="primary", interaction="idle", outcome="none", press=press, testId=`${testId}-action`)
