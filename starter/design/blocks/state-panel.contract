// One block for a whole area's empty, loading and failed states: a calm centred panel, its card, shape and type
// all Theme tokens (no image file). The drawn shape says the state: a ring held open (empty), a broken arc
// (loading), a filled alert form (failed). Loading keeps the title (so a reader hears what loads, role=status) and
// stands in three skeleton lines for the rest; failed says its one line in the error's ink (role=alert) with the
// same one action as the retry. `size` "full" is the whole area's panel (its own max width, the larger shape);
// "compact" is for a card's body or a side panel. No agent axis, as Section: nothing in this panel for an agent to
// change or wait on; the app's own notice says an act.
use Words, ActionButton from "__SCOPE__/components"

component StatePanel
  props
    title: string
    message: string
    actionLabel: string
    data: enum<"empty", "loading", "failed">
    size: enum<"full", "compact">
    press: action
    testId: string
  view
    column testId=testId role=(data == "failed" ? "alert" : data == "loading" ? "status" : "none") width="100%" max-width=(size == "full" ? "blocks.panel-max" : "blocks.panel-compact") margin-left="auto" margin-right="auto" box-sizing="border-box" padding=(size == "full" ? "theme.space.xxl" : "theme.space.xl") gap=(size == "full" ? "theme.space.lg" : "theme.space.md") align-items="center" text-align="center" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line"
      svg viewBox="0 0 24 24" width=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") height=(size == "full" ? "blocks.shape-full" : "blocks.shape-compact") aria-hidden=true flex-shrink=0
        if data == "failed"
          circle cx=12 cy=12 r=11 fill="theme.color.critical"
          line x1=12 y1=6.75 x2=12 y2=13 stroke="theme.color.critical-ink" stroke-width=2 stroke-linecap="round"
          circle cx=12 cy=16.75 r=1.3 fill="theme.color.critical-ink"
        else if data == "loading"
          circle cx=12 cy=12 r=10 fill="none" stroke="theme.color.ink-muted" stroke-width=2.5 stroke-linecap="round" stroke-dasharray="47 16" transform="rotate(-90 12 12)"
        else
          circle cx=12 cy=12 r=10 fill="none" stroke="theme.color.ink-muted" stroke-width=2 stroke-dasharray="3.5 3.5"
      Words(text=title, kind=(size == "full" ? "title" : "label"), outcome="none", level=2, testId=`${testId}-title`)
      if data == "loading"
        column testId=`${testId}-loading` width="100%" gap="theme.space.sm"
          box height="blocks.bone" background-color="theme.color.fill" border-radius="theme.radius.pill"
          box height="blocks.bone" background-color="theme.color.fill" border-radius="theme.radius.pill"
          box height="blocks.bone" background-color="theme.color.fill" border-radius="theme.radius.pill"
      else
        Words(text=message, kind="caption", outcome=(data == "failed" ? "error" : "none"), level=0, testId=`${testId}-message`)
        if actionLabel != ""
          ActionButton(label=actionLabel, kind=(data == "failed" ? "plain" : "primary"), interaction="idle", outcome="none", press=press, testId=`${testId}-action`)
