// OnboardingSteps: a step-by-step frame — where the person is (a count beside numbered steps joined by one
// connector each, the track spanning the frame, the current step accent-filled and ringed, done steps carrying a
// drawn tick; a lone step keeps the count and shows its node as that tick, for a lone active node read as a bar
// that had lost its siblings; count and steps together stay one compact bar on a phone), the current step's title
// and lead line, the slot for the step's content, then the way on: Back (hidden on the first step), an optional
// Skip ("" hides it) and Continue, which right-clusters at a named width on a desktop (a Gutter takes the spare
// width, so the space between the zones reads as deliberate, not a stretched slab) and fills its own row on a
// phone; the frame's one filled element a state is the way on, and it carries the busy state in whichever branch
// draws it; a state with no steps and one way on fills the row, so the hairline it sits under reads as the
// footer's edge. The frame groups by surface and space: one raised panel whose line edge is lifted a tenth toward
// the muted ink, so the edge holds on a near-black page (a fill alone can vanish in a theme that paints page and
// surface one colour), one gap token between every zone, one hairline above the actions that bounds the slot.
// States: data many|one|empty|loading|failed|long (loading says itself over a breathing skeleton of the frame
// whose dots and connectors mirror the resting bar's own sizes — no count ghost: a pill there read as a stray
// mark — and whose text lines hold the title's and lead's own heights and left edges, so the swap moves nothing;
// empty answers with a completed tick row where the bar stood, then its own title and lead, and keeps the way on;
// failed says itself in a tinted alert that carries the status colour as a drawn warning and a left accent — the
// tint and the marks are the signal, the words take ink, for status ink is promised on the page and surface, not
// on a tint — and offers its way back), interaction idle|busy (the way on busy), outcome none|error (an error line
// a footer's gap above the actions), agent none|proposed (an agent filled this step in: a calm note, two answer
// words, both quiet buttons so the way on stays the one filled control). Every word is the app's; every value is a
// Theme token or a blocks.* size, so a party's own Theme restyles the whole frame.

use Words, ActionButton from "__SCOPE__/components"

// One step: its key, what it is called, and where it stands. `state` is "done", "current" or "next".
shape Step
  key: string
  title: string
  state: enum<"done", "current", "next">

// The skeleton breathes, so loading reads as in progress, not as drawn shapes.
keyframes breathe
  50% opacity=0.55

// Where the current step sits (0 when none is marked); its title ("" when none is marked).
fn currentAt(steps: Step[]): number = match first(steps.map((s, i) => s.state == "current" ? i : -1).filter(x => x != -1)) { case some(i) => i, case none => 0 }
fn currentTitle(steps: Step[]): string = match first(steps.filter(s => s.state == "current")) { case some(s) => s.title, case none => "" }

// A node's fill and edge by where its step stands. A lone step reads as the whole track done (a lone active
// node read as a bar that had lost its siblings), so it takes the done node's quiet fill and positive edge.
fn dotFill(s: Step, lone: bool): string = lone or s.state == "done" ? "theme.color.fill" : s.state == "current" ? "theme.color.accent" : "theme.color.surface"
fn dotEdge(s: Step, lone: bool): string = lone or s.state == "done" ? "theme.color.positive-text" : s.state == "current" ? "theme.color.accent" : "color-mix(in srgb, theme.color.ink-muted 45%, theme.color.raised)"

// A step's dot: filled by where it stands, edged when it is a step to come (a fill alone can vanish on a dark
// card), ringed when current; the slot holds its number or the drawn tick.
component StepDot
  props
    fill: string
    edge: string
    ring: bool
    testId: string
  slot
  view
    box testId=testId min-width="blocks.step-dot" min-height="blocks.step-dot" flex-shrink=0 display="flex" align-items="center" justify-content="center" border-radius="theme.radius.pill" border-width="theme.line.width" border-style="solid" border-color=edge background-color=fill box-shadow=(ring ? "0 0 0 2px theme.color.focus" : "none")
      children

// The tick a completed node carries, drawn once for the done steps and the empty state's completed row.
component Tick
  view
    svg viewBox="0 0 12 12" width="blocks.step-tick" height="blocks.step-tick" fill="none" stroke="theme.color.positive-text" aria-hidden=true
      path d="M2.5 6.5L5 9l4.5-5" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"

// One gap of the track between two dots: a passed step colours it, a step to come leaves it quiet.
component StepSeg
  props
    ink: string
  view
    box flex=1 height="blocks.step-line" background-color=ink

// The gutter between the secondary and primary zones: it takes nearly all the spare width (1000 to the
// primary's 1), so on one line the primary keeps its basis; once the primary wraps to its own line (a phone)
// the gutter stays behind and the primary fills that line alone.
component Gutter
  view
    box flex="1000 1 0"

// A bar of text still loading: breathing, never a control. It takes `share` of its line's width against
// `rest` (a width share in a row: a flex share inside the column would size its height, and drew nothing).
component SkBar
  props
    share: string
    rest: string
    height: string
  view
    row
      box flex=share height=height background-color="color-mix(in srgb, theme.color.ink-muted 30%, theme.color.raised)" border-radius="theme.radius.pill"
      box flex=rest

// A bar the shape of a button still loading; `max` caps it where the real button is capped.
component SkBtn
  props
    basis: string
    max: string
  view
    box flex=basis max-width=max min-width="blocks.skel-btn" min-height="blocks.skel-btn-tall" background-color="color-mix(in srgb, theme.color.ink-muted 30%, theme.color.raised)" border-radius="theme.radius.control"

// The frame's ghost: the steps that have not arrived, breathing, never a control. Its nodes mirror the resting
// bar's own geometry — the same dot sizes, the same connectors between them, spanning one row (no count ghost: a
// pill there read as a stray mark) — and its text lines hold the title's and lead's own heights and left edges at
// fixed shares, so the swap from loading to loaded moves nothing and no line runs at the card's edge.
component SkTrack
  view
    column gap="theme.space.md" aria-hidden=true animation="breathe 1.8s ease-in-out infinite"
      row min-height="blocks.step-dot" align-items="center"
        for j in [0, 1, 2, 3] key=j
          StepDot(fill="color-mix(in srgb, theme.color.ink-muted 45%, theme.color.raised)", edge="color-mix(in srgb, theme.color.ink-muted 45%, theme.color.raised)", ring=false, testId="")
          if j < 3
            StepSeg(ink="color-mix(in srgb, theme.color.ink-muted 45%, theme.color.raised)")
      column gap="theme.space.sm"
        SkBar(share="3 1 0", rest="2 1 0", height="blocks.skel-head")
        SkBar(share="17 1 0", rest="3 1 0", height="blocks.skel-line")

component OnboardingSteps
  props
    steps: Step[]
    lead: string
    countLabel: string
    backLabel: string
    continueLabel: string
    skipLabel: string
    errorText: string
    emptyText: string
    completeText: string
    loadingText: string
    failedText: string
    retryLabel: string
    agentNote: string
    acceptLabel: string
    rejectLabel: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    interaction: enum<"idle", "busy">
    outcome: enum<"none", "error">
    agent: enum<"none", "proposed">
    testId: string
    back: action
    advance: action
    skip: action
    retry: action
    accept: action
    reject: action
  slot
  derive at = currentAt(steps)
  derive heading = currentTitle(steps)
  derive lone = steps.length == 1
  derive hasSteps = steps.length > 0 and data != "empty" and data != "loading" and data != "failed"
  view
    column testId=testId width="100%" max-width="blocks.steps-max" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="theme.space.xl" gap="theme.space.lg" background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="color-mix(in srgb, theme.color.line 90%, theme.color.ink-muted 10%)"
      if data == "loading"
        if countLabel != ""
          Words(text=countLabel, kind="title", outcome="none", level=2, testId=`${testId}-heading`)
        text loadingText testId=`${testId}-loading` role="status" font="theme.type.body" color="theme.color.ink-muted"
        SkTrack()
      else if data == "failed"
        if countLabel != ""
          Words(text=countLabel, kind="title", outcome="none", level=2, testId=`${testId}-heading`)
        row gap="theme.space.sm" align-items="center" padding="theme.space.xl" border-radius="theme.radius.control" background-color="color-mix(in srgb, theme.color.critical 12%, theme.color.raised)" border-width="theme.line.width" border-style="solid" border-color="color-mix(in srgb, theme.color.critical 30%, theme.color.raised)" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color="theme.color.critical"
          svg viewBox="0 0 16 16" width="blocks.alert" height="blocks.alert" fill="none" stroke="theme.color.critical" aria-hidden=true flex-shrink=0
            path d="M8 2.5L14.5 13.5H1.5Z" stroke-width=1.5 stroke-linejoin="round"
            path d="M8 6.5v3.2" stroke-width=1.5 stroke-linecap="round"
            path d="M8 11.4v0.01" stroke-width=1.5 stroke-linecap="round"
          text failedText testId=`${testId}-failed` role="alert" flex=1 min-width=0 font="theme.type.label" color="theme.color.ink"
      else if not hasSteps
        row testId=`${testId}-done` align-items="center" gap="theme.space.md"
          StepDot(fill="theme.color.fill", edge="theme.color.positive-text", ring=false, testId=`${testId}-done-dot`)
            Tick()
          if completeText != ""
            text completeText testId=`${testId}-complete` font="theme.type.label" color="theme.color.ink"
        column gap="theme.space.xs"
          if countLabel != ""
            Words(text=countLabel, kind="title", outcome="none", level=2, testId=`${testId}-heading`)
          if emptyText != ""
            text emptyText testId=`${testId}-empty` role="status" font="theme.type.caption" color="theme.color.ink-muted"
      else
        row testId=`${testId}-bar` role="status" aria-label=countLabel align-items="center" gap="theme.space.lg"
          box min-height="blocks.step-dot" flex-shrink=0 display="flex" align-items="center"
            text `${at + 1}/${steps.length}` testId=`${testId}-count` font="theme.type.label" color="theme.color.ink" font-variant-numeric="tabular-nums"
          row flex=1 min-width=0 align-items="center" aria-hidden=true
            for s, i in steps key=s.key
              StepDot(fill=dotFill(s, lone), edge=dotEdge(s, lone), ring=(s.state == "current" and not lone), testId=`${testId}-step-${s.key}`)
                if lone or s.state == "done"
                  Tick()
                else
                  text `${i + 1}` font="theme.type.caption" color=(s.state == "current" ? "theme.color.accent-ink" : "theme.color.ink-muted")
              if i + 1 < steps.length
                StepSeg(ink=(s.state == "done" ? "theme.color.positive" : "color-mix(in srgb, theme.color.ink-muted 45%, theme.color.raised)"))
        column gap="theme.space.xs"
          if heading != ""
            Words(text=heading, kind="title", outcome="none", level=2, testId=`${testId}-title`)
          if lead != ""
            Words(text=lead, kind="caption", outcome="none", level=0, testId=`${testId}-lead`)
      if agent == "proposed"
        column testId=`${testId}-note` role="status" gap="theme.space.sm" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color="theme.color.accent" padding-left="theme.space.md"
          text agentNote testId=`${testId}-sentence` font="theme.type.caption" color="theme.color.accent"
          row gap="theme.space.sm" flex-wrap="wrap"
            if rejectLabel != ""
              ActionButton(label=rejectLabel, kind="plain", interaction="idle", outcome="none", press=reject, testId=`${testId}-reject`)
            if acceptLabel != ""
              ActionButton(label=acceptLabel, kind="plain", interaction="idle", outcome="none", press=accept, testId=`${testId}-accept`)
      column
        children
      if data == "loading" and outcome != "error"
        column border-top-width="theme.line.width" border-top-style="solid" border-top-color="theme.color.line" padding-top="theme.space.md" aria-hidden=true
          row gap="theme.space.lg" align-items="center" flex-wrap="wrap"
            row gap="theme.space.sm" align-items="center"
              SkBtn(basis="none", max="none")
              SkBtn(basis="none", max="none")
            Gutter()
            SkBtn(basis="1 1 blocks.primary-max", max="none")
      if data != "loading" or outcome == "error"
        column gap="theme.space.md" border-top-width="theme.line.width" border-top-style="solid" border-top-color="theme.color.line" padding-top="theme.space.md"
          if outcome == "error"
            text errorText testId=`${testId}-error` role="alert" font="theme.type.caption" color="theme.color.critical-text"
          if data == "failed"
            row gap="theme.space.lg" align-items="center" flex-wrap="wrap"
              if skipLabel != ""
                ActionButton(label=skipLabel, kind="plain", interaction="idle", outcome="none", press=skip, testId=`${testId}-skip`)
              Gutter()
              if retryLabel != ""
                column flex="1 1 blocks.primary-max"
                  ActionButton(label=retryLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=retry, testId=`${testId}-retry`)
          else if not hasSteps
            ActionButton(label=continueLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=advance, testId=`${testId}-continue`)
          else
            row gap="theme.space.lg" align-items="center" flex-wrap="wrap"
              row gap="theme.space.sm" align-items="center"
                if at > 0
                  ActionButton(label=backLabel, kind="plain", interaction="idle", outcome="none", press=back, testId=`${testId}-back`)
                if skipLabel != ""
                  ActionButton(label=skipLabel, kind="plain", interaction="idle", outcome="none", press=skip, testId=`${testId}-skip`)
              Gutter()
              column flex="1 1 blocks.primary-max"
                ActionButton(label=continueLabel, kind="primary", interaction=(interaction == "busy" ? "busy" : "idle"), outcome="none", press=advance, testId=`${testId}-continue`)
