// SideNav: an app's side navigation, drawn as its own panel. Width: the panel fills the column a shell gives it
// and never grows past blocks.nav-max (the shell decides the column's real width — a side column at a desktop,
// the window at a phone; a shell wanting a narrow rail gives it a narrower column, and the rows' own truncation
// holds). Height is the shell's too: given a definite height the account pins to the panel's bottom (a spacer
// takes what is left); alone in a window the panel is as tall as what it holds. The shell decides when the
// panel shows at all.
//
// One gutter holds everything: the panel pads by theme.space.sm and every row inside pads its words by
// theme.space.md, so the brand, a group's heading, each place's label, the states' words and the account all
// start on one edge, while a row's fill (the current place's, a hover's) spans the panel's own width. Grouping
// is by space — a heading, then its rows, one rhythm (theme.space.xs between every one of them; the air
// between groups, theme.space.lg, the only larger gap) — not by frames; the line token draws the rail, the
// hairline that closes the brand and the one above the account. While the menu is one place, empty, loading or
// failed its spacer keeps the menu's home (blocks.nav-places-min, half of it on each side of the empty line),
// so a short state sits in stable room instead of collapsing to a sliver and the account stays where the
// shell put it.
//
// - The brand is its own region, the same height in every state: the product's mark and name (each optional by
//   being empty, the name the panel's largest words) and the hairline that closes it. The slot (the app's
//   control: a switch, a search) opens the places' area under the hairline, where a sidebar's search lives — so
//   the brand's height never depends on what the app puts there, and the slot's content never reads as the
//   name's second line.
// - The places: NavEntry rows grouped by `group` in first-seen order ("" no heading); a group's own name is its
//   heading. The current place is the panel's one filled thing, and selection is one device: the fill, the
//   label's heavier type in the accent, aria-current="page". A badge counts, as a fill pill (surface on the
//   current row's fill): no border, so it holds on any row and in both schemes, and a truncating label keeps a
//   whole gap (theme.space.lg) before its count.
// - An agent that added or reordered an entry (agent "changed"): the entry `agentKey` names gets an accent edge
//   at its start and `agentNote`'s words under its label (the kit's LinkRow language).
// - The states that stand where the places stand speak where the rows speak — no heading of their own, so a
//   state never reads as a copy change: loading's drawn cue beside its words at a heading's place (role=status),
//   over ghost rows in the places' own anatomy — the row's own height and insets, a fill bar where the label
//   will be and a fill pill where the count sits — so what arrives does not jump. Empty centres its line and
//   its way on in the menu's home (a quiet text action when the app gives `emptyLabel`: the emptier state
//   keeps the lighter gesture). Failed is the kit's outcome language, as ActionButton draws it: a raised panel
//   ringed by the critical's hair and washed with the critical at a breath (8%, the same opacity shading the
//   kit's own buttons), the drawn mark beside the words in the error's ink, `retryLabel`'s compact bordered
//   button below.
// - The landmark's name, `navLabel`, is what a reader hears; the words a person sees above the rows are the
//   data's own group names.
// - Long: everything the panel draws holds one line with an ellipsis; the slot's content is the app's.
//
// States:
//   data   many|empty|loading|failed|long|one
//   agent  none|changed
use Words, ActionButton from "__SCOPE__/components"

// One place in the navigation: `group` names the section it sits in ("" for none), `badge` counts what it holds
// (0 hides the pill), `current` marks the place the person is on.
shape NavEntry
  key: string
  label: string
  href: string
  group: string
  badge: number
  current: bool

// A group's heading, at the rows' own inset: the places' sections, and the only section words the panel shows.
component NavHeading
  props
    text: string
    testId: string
  view
    text text testId=testId font="theme.type.heading" color="theme.color.ink-muted" padding-left="theme.space.md" padding-right="theme.space.md" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One place: its label on one line (an ellipsis a whole gap before its count), the current place's fill and
// weight, an agent's edge and note.
component NavItem
  props
    label: string
    href: string
    badge: number
    current: bool
    marked: bool
    note: string
    testId: string
  view
    link href=href testId=testId aria-current=(current ? "page" : "false") position="relative" display="flex" flex-direction="row" align-items="center" gap="theme.space.lg" min-height="blocks.nav-row-min" box-sizing="border-box" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.xs" padding-bottom="theme.space.xs" border-radius="theme.radius.control" color="theme.color.ink" text-decoration-line="none" background-color=(current ? "theme.color.fill" : "transparent")
      :hover
        background-color="theme.color.hover"
      :active
        background-color="theme.color.fill"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      if marked
        box position="absolute" left=0 top="theme.space.sm" bottom="theme.space.sm" width="blocks.nav-mark-line" background-color="theme.color.accent" border-radius="theme.radius.pill" aria-hidden=true
      column flex=1 min-width=0
        text label font=(current ? "theme.type.label" : "theme.type.body") color=(current ? "theme.color.accent" : "theme.color.ink") white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if marked
          text note testId=`${testId}-mark` font="theme.type.caption" color="theme.color.accent" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      if badge > 0
        text `${badge}` testId=`${testId}-badge` flex-shrink=0 min-width="blocks.nav-badge-min" box-sizing="border-box" text-align="center" font="theme.type.caption" color=(current ? "theme.color.ink" : "theme.color.ink-muted") font-variant-numeric="tabular-nums" padding-left="theme.space.sm" padding-right="theme.space.sm" background-color=(current ? "theme.color.surface" : "theme.color.fill") border-radius="theme.radius.pill" white-space="nowrap"

// A place still coming: the row's own height and insets, a fill bar where the label will be and a fill pill where
// the count sits — every ghost reserves the row's whole anatomy, so what arrives does not jump.
component NavGhost
  view
    row align-items="center" gap="theme.space.lg" min-height="blocks.nav-row-min" box-sizing="border-box" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.xs" padding-bottom="theme.space.xs" aria-hidden=true
      box flex=1 height="theme.space.md" background-color="theme.color.fill" border-radius="theme.radius.pill"
      box width="blocks.nav-badge-min" height="theme.space.md" flex-shrink=0 background-color="theme.color.fill" border-radius="theme.radius.pill"

component SideNav
  props
    productName: string
    productMark: string
    navLabel: string
    entries: NavEntry[]
    data: enum<"many", "empty", "loading", "failed", "long", "one">
    emptyText: string
    emptyLabel: string
    empty: action
    loadingText: string
    failedText: string
    retryLabel: string
    retry: action
    accountName: string
    accountDetail: string
    agent: enum<"none", "changed">
    agentKey: string
    agentNote: string
    testId: string
  slot
  derive names = entries.map(e => e.group)
  derive groups = names.filter((g, i) => names.indexOf(g) == i)
  view
    column testId=testId role="navigation" aria-label=navLabel max-width="blocks.nav-max" box-sizing="border-box" gap="theme.space.lg" padding="theme.space.sm" background-color="theme.color.surface" border-right-width="theme.line.width" border-right-style="solid" border-right-color="theme.color.line"
      row align-items="center" gap="theme.space.sm" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.sm" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
        if productMark != ""
          column width="blocks.nav-mark" height="blocks.nav-mark" flex-shrink=0 background-color="theme.color.fill" border-radius="theme.radius.control" justify-content="center" overflow="hidden" aria-hidden=true
            text productMark.trim().slice(0, 2) font="theme.type.heading" color="theme.color.ink" text-align="center" white-space="nowrap"
        if productName != ""
          text productName testId=`${testId}-name` flex=1 min-width=0 font="theme.type.title" color="theme.color.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      column min-width=0 padding-left="theme.space.md" padding-right="theme.space.md"
        children
      if data == "failed"
        row role="alert" position="relative" background-color="theme.color.raised" border-width="theme.line.width" border-style="solid" border-color="theme.color.critical" border-radius="theme.radius.control" overflow="hidden"
          box position="absolute" inset=0 background-color="theme.color.critical" opacity=0.08 aria-hidden=true
          column position="relative" flex=1 min-width=0 gap="theme.space.md" padding="theme.space.md"
            row align-items="flex-start" gap="theme.space.sm"
              svg viewBox="0 0 24 24" width="blocks.nav-glyph" height="blocks.nav-glyph" fill="none" stroke="theme.color.critical-text" aria-hidden=true flex-shrink=0
                path d="M12 3.5 L21 19 h-18 z" stroke-width=1.75 stroke-linejoin="round"
                path d="M12 9.5 v4.5" stroke-width=1.75 stroke-linecap="round"
                path d="M12 16.6 v0.2" stroke-width=1.75 stroke-linecap="round"
              column flex=1 min-width=0
                Words(text=failedText, kind="body", outcome="error", level=0, testId=`${testId}-${data}`)
            row
              ActionButton(label=retryLabel, kind="plain", interaction="idle", outcome="none", press=retry, testId=`${testId}-retry`)
      else if data == "loading"
        column gap="theme.space.xs"
          row role="status" align-items="center" gap="theme.space.sm" padding-left="theme.space.md" padding-right="theme.space.md"
            svg viewBox="0 0 24 24" width="blocks.nav-glyph" height="blocks.nav-glyph" fill="none" aria-hidden=true flex-shrink=0
              path d="M12 3.5 A8.5 8.5 0 1 1 3.5 12" stroke="theme.color.ink-muted" stroke-width=2.5 stroke-linecap="round"
            column flex=1 min-width=0
              Words(text=loadingText, kind="heading", outcome="cancelled", level=0, testId=`${testId}-${data}`)
          column aria-hidden=true gap="theme.space.xs"
            NavGhost()
            NavGhost()
            NavGhost()
            NavGhost()
      else if data == "empty"
        column flex=1 min-height="blocks.nav-places-half"
        column role="status" gap="theme.space.sm" padding-left="theme.space.md" padding-right="theme.space.md"
          Words(text=emptyText, kind="body", outcome="cancelled", level=0, testId=`${testId}-${data}`)
          if emptyLabel != ""
            row
              button press=empty testId=`${testId}-add` min-height="blocks.nav-row-min" box-sizing="border-box" padding-left="0" padding-right="theme.space.md" padding-top="theme.space.xs" padding-bottom="theme.space.xs" background-color="transparent" border-width="0" border-radius="theme.radius.control"
                :hover
                  background-color="theme.color.hover"
                :focus-visible
                  box-shadow="inset 0 0 0 2px theme.color.focus"
                text emptyLabel font="theme.type.label" color="theme.color.accent"
      else
        column gap="theme.space.lg"
          for g in groups key=g
            column gap="theme.space.xs"
              if g != ""
                NavHeading(text=g, testId=`${testId}-group-${g}`)
              column gap="theme.space.xs"
                for e in entries.filter(e => e.group == g) key=e.key
                  NavItem(label=e.label, href=e.href, badge=e.badge, current=e.current, marked=(agent == "changed" and e.key == agentKey), note=agentNote, testId=`${testId}-entry-${e.key}`)
      column flex=1 min-height=(data == "empty" ? "blocks.nav-places-half" : data == "many" or data == "long" ? "0" : "blocks.nav-places-min")
      if accountName != ""
        row testId=`${testId}-account` align-items="center" gap="theme.space.md" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.md" padding-bottom="theme.space.xs" border-top-width="theme.line.width" border-top-style="solid" border-top-color="theme.color.line"
          column width="theme.space.xxl" height="theme.space.xxl" flex-shrink=0 background-color="theme.color.fill" border-radius="theme.radius.pill" align-items="center" justify-content="center" overflow="hidden" aria-hidden=true
            text accountName.trim().slice(0, 1) font="theme.type.label" color="theme.color.ink"
          column flex=1 min-width=0
            text accountName font="theme.type.label" color="theme.color.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
            if accountDetail != ""
              text accountDetail font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
