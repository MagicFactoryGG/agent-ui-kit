// A mailbox's list of messages, with the pane that reads the chosen one on a wide window, in one card. The
// card holds one height (its floor) and the split fills it, so a state changes what the panes hold, never the
// card's shape: the header carries the state's word (the unread count once the messages are in, the loading
// line while they arrive, an agent's note under the title when it filed or flagged one) and aligns with the
// rows' dot column; the list pane holds the rows — unread in the heavier type with a dot, sender and time on
// the first line, the subject then the snippet's one line under it; the chosen message is a filled tile with
// the accent edge at its start, tying it to the pane that reads it, and an agent's mark is the same edge, the
// kit's idiom (LinkRow); a flagged message carries a small caution flag in a fixed slot at the left of its
// time, so every row's time shares one right edge — and the reading pane, headed by a band the pane's own
// width in the header's rhythm, holds the chosen message: who and when on one line, the subject as the pane's
// title, the snippet wrapping under; with no message to choose it says nothing rather than invite a choice.
// Empty, loading and failed each say their own line in the list pane, one clear focal cluster (a glyph, the
// line at title size) with the way on: empty offers a quiet compose, failed offers the way back in the
// error's colour, loading breathes rows that mirror the real ones' grid. A phone draws the list alone, the
// platform's own idiom (a row pushes its detail): the split flips at the window's 640px floor (the
// responsive-columns recipe: "Else read exactViewport's width"); long words cut with an ellipsis in the rows
// and wrap in the pane. Every word is the app's.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton from "__SCOPE__/components"

// One message: its key (the app names the chosen one and the agent's by key), who it is from, its subject, the
// one line that previews it, when it arrived, and where it opens.
shape Message
  key: string
  from: string
  subject: string
  snippet: string
  when: string
  unread: bool
  flagged: bool
  href: string

// The window's width and the person's motion preference: the facts this block reads to lay itself out.
shape Viewport
  width: number
  prefersReducedMotion: bool

// The skeleton's quiet breathing, held still when the person prefers no motion.
keyframes breathe
  50% opacity=0.4

// Unread rows and the chosen one read in ink and the heavier type; read rows fall to the muted ink.
fn rowInk(strong: bool): string = strong ? "theme.color.ink" : "theme.color.ink-muted"

// One row: the dot's gutter (kept for read rows, so every row's words align), then sender and time on the
// first line with a fixed slot between them where a flagged message's flag sits (kept for unflagged rows, so
// every row's time shares one right edge), then the subject, then the snippet's one line. The chosen row is a
// filled tile in the heavier type with the accent edge at its start, tying it to the pane that reads it; an
// agent's mark is the same edge.
component MessageRow
  props
    message: Message
    chosen: bool
    marked: bool
    testId: string
  view
    link href=message.href testId=testId aria-current=(chosen ? "true" : "false") display="flex" flex-direction="row" align-items="flex-start" gap="theme.space.xs" min-height="components.row-min" margin-left="theme.space.sm" margin-right="theme.space.sm" border-radius="theme.radius.control" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" color="theme.color.ink" text-decoration-line="none" background-color=(chosen ? "theme.color.fill" : "transparent") border-left-width="components.mark-line" border-left-style="solid" border-left-color=(marked or chosen ? "theme.color.accent" : "transparent")
      :hover
        background-color="theme.color.hover"
      :active
        background-color="theme.color.fill"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      box width="blocks.dot-gutter" height="blocks.dot-line" flex-shrink=0 display="flex" align-items="center"
        if message.unread
          box width="blocks.dot" height="blocks.dot" background-color="theme.color.accent" border-radius="theme.radius.pill"
      column flex=1 min-width=0 gap="theme.space.xs"
        row align-items="center" gap="theme.space.lg"
          text message.from testId=`${testId}-from` min-width=0 flex=1 font=(message.unread or chosen ? "theme.type.label" : "theme.type.body") color=rowInk(message.unread or chosen) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          box width="blocks.icon" height="blocks.dot-line" flex-shrink=0 display="flex" align-items="center"
            if message.flagged
              svg viewBox="0 0 12 12" width="blocks.icon" height="blocks.icon" fill="none" aria-hidden=true
                path d="M3 2v8" stroke="theme.color.caution" stroke-width=1.5 stroke-linecap="round"
                path d="M3.5 2.5h5.5l-1.8 2 1.8 2H3.5z" fill="theme.color.caution"
          text message.when testId=`${testId}-when` min-width=0 flex-shrink=0 font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text message.subject testId=`${testId}-subject` font=(message.unread or chosen ? "theme.type.label" : "theme.type.body") color=rowInk(message.unread or chosen) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text message.snippet testId=`${testId}-snippet` font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One quiet row while the messages load, on the real row's own grid: the dot's gutter, a long line and a short
// one (sender and time, the time bar ending at the same right edge a real time does, the flag's slot kept
// empty between them), then the subject's line and the snippet's under it. It says "rows are coming", not
// "nothing is here", and it breathes only when the person has not asked for still.
component SkelRow
  props
    pulse: string
    lead: enum<"wide", "mid", "narrow">
  view
    row align-items="flex-start" gap="theme.space.xs" margin-left="theme.space.sm" margin-right="theme.space.sm" margin-top="theme.space.xs" margin-bottom="theme.space.xs" border-radius="theme.radius.control" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md"
      box width="blocks.dot-gutter" height="blocks.dot-line" flex-shrink=0 display="flex" align-items="center"
        box width="blocks.dot" height="blocks.dot" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
      column flex=1 min-width=0 gap="theme.space.xs"
        row gap="theme.space.sm" align-items="center"
          box flex=1 height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-right=(lead == "mid" ? "blocks.skel-when" : lead == "narrow" ? "blocks.skel-tail" : "0") animation=pulse
          box width="blocks.icon" height="blocks.skel-line" flex-shrink=0
          box width="blocks.skel-when" height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0 animation=pulse
        box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
        box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse

// The list's own pane: the messages as rows (one listitem each) with air below the header's line; empty,
// loading and failed say their own line here — one focal cluster, centred in the pane, with the way on — and
// stretch to fill the card, so its shape never changes with its state, only its content does.
component ListPane
  props
    messages: Message[]
    chosenKey: string
    agentKey: string
    marked: bool
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    emptyText: string
    failedText: string
    composeLabel: string
    retryLabel: string
    compose: action
    retry: action
    pulse: string
    testId: string
  view
    column flex=1 min-width=0
      if data == "empty"
        column flex=1 role="status" min-height="blocks.state-min" justify-content="center" align-items="center" gap="theme.space.md" padding="theme.space.xl"
          svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
            circle cx=12 cy=12 r=12 fill="theme.color.fill"
            rect x="4.5" y="6.75" width="15" height="10.5" rx="1.5" fill="none" stroke="theme.color.ink-muted" stroke-width=1.5
            path d="M5.25 7.75l6.75 4.6 6.75-4.6" fill="none" stroke="theme.color.ink-muted" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
          Words(text=emptyText, kind="title", outcome="cancelled", level=0, testId=`${testId}-empty`)
          ActionButton(label=composeLabel, kind="plain", interaction="idle", outcome="none", press=compose, testId=`${testId}-compose`)
      else
        if data == "failed"
          column flex=1 role="alert" min-height="blocks.state-min" justify-content="center" align-items="center" gap="theme.space.md" padding="theme.space.xl"
            svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
              circle cx=12 cy=12 r=12 fill="theme.color.critical"
              circle cx=12 cy=12 r="6.75" fill="none" stroke="theme.color.critical-ink" stroke-width=1.8
              path d="M12 8.2v4.2" stroke="theme.color.critical-ink" stroke-width=1.8 stroke-linecap="round"
              circle cx=12 cy="15.6" r=1 fill="theme.color.critical-ink"
            Words(text=failedText, kind="title", outcome="error", level=0, testId=`${testId}-failed`)
            ActionButton(label=retryLabel, kind="plain", interaction="idle", outcome="error", press=retry, testId=`${testId}-retry`)
        else
          if data == "loading"
            column margin-top="theme.space.sm"
              SkelRow(pulse=pulse, lead="wide")
              SkelRow(pulse=pulse, lead="mid")
              SkelRow(pulse=pulse, lead="narrow")
              SkelRow(pulse=pulse, lead="mid")
              SkelRow(pulse=pulse, lead="narrow")
              SkelRow(pulse=pulse, lead="mid")
          else
            column flex=1 role="list" margin-top="theme.space.sm"
              for m in messages key=m.key
                column role="listitem"
                  MessageRow(message=m, chosen=(m.key == chosenKey), marked=(marked and m.key == agentKey), testId=`${testId}-row-${m.key}`)

// The reading pane, drawn on the wide window beside the list: a band the pane's own width heads it, in the
// card header's rhythm, so its rule runs edge to edge as the header's does; under the band the chosen
// message — who and when on one line, the subject as the pane's title, the one focal point of a chosen
// message, and the snippet under it, wrapping. Nothing chosen, with messages to choose from, says so quietly
// over a small glyph; with no message to choose it says nothing, and while the messages load, quiet bars
// claim nothing.
component Reader
  props
    paneLabel: string
    paneEmptyText: string
    messages: Message[]
    chosenKey: string
    loading: bool
    pulse: string
    testId: string
  derive picked = first(messages.filter(m => m.key == chosenKey))
  view
    column flex=1 min-width=0 role="complementary" aria-label=paneLabel border-left-width="theme.line.width" border-left-style="solid" border-left-color="theme.color.line"
      if paneLabel != ""
        column min-height="blocks.bar-min" justify-content="center" padding-left="theme.space.lg" padding-right="theme.space.lg" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
          text paneLabel testId=`${testId}-pane-label` font="theme.type.caption" color="theme.color.ink-muted"
      if loading
        column gap="theme.space.sm" padding="theme.space.lg" aria-hidden=true
          row gap="theme.space.md" align-items="center"
            box flex=2 height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
            box width="blocks.skel-when" height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0 animation=pulse
          box height="blocks.skel-title" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-right="blocks.skel-tail" animation=pulse
          box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-right="blocks.skel-when" animation=pulse
          box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-right="blocks.skel-tail" animation=pulse
          box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" margin-right="blocks.skel-tail" animation=pulse
      else
        match picked
          case some(m)
            column gap="theme.space.md" padding="theme.space.lg"
              row align-items="center" gap="theme.space.md"
                text m.from testId=`${testId}-pane-from` min-width=0 flex=1 font="theme.type.label" color="theme.color.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                text m.when testId=`${testId}-pane-when` margin-left="auto" min-width=0 flex-shrink=0 font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              Words(text=m.subject, kind="title", outcome="none", level=3, testId=`${testId}-pane-subject`)
              text m.snippet testId=`${testId}-pane-snippet` font="theme.type.body" color="theme.color.ink-muted"
          case none
            if messages.length > 0
              column flex=1 gap="theme.space.md" align-items="center" justify-content="center" padding="theme.space.xl"
                svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
                  circle cx=12 cy=12 r=12 fill="theme.color.fill"
                  rect x="7.5" y="5.5" width="9" height="13" rx=1.5 fill="none" stroke="theme.color.ink-muted" stroke-width=1.5
                  path d="M9.5 9h5M9.5 12h5M9.5 15h3" stroke="theme.color.ink-muted" stroke-width=1.5 stroke-linecap="round"
                if paneEmptyText != ""
                  Words(text=paneEmptyText, kind="caption", outcome="cancelled", level=0, testId=`${testId}-pane-empty`)

// The mailbox: one card (it centres on a wide window up to its own max), the header, then the list — with the
// reading pane beside it when the window is wide, and alone on a phone, where the row's own way in (its href)
// opens the message, as the platform composes a list with its detail.
component MessageList
  props
    title: string
    unreadLabel: string
    emptyText: string
    loadingText: string
    failedText: string
    composeLabel: string
    retryLabel: string
    paneLabel: string
    paneEmptyText: string
    agentNote: string
    chosenKey: string
    agentKey: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    agent: enum<"none", "changed">
    messages: Message[]
    compose: action
    retry: action
    testId: string
  resource viewport = exactViewport() as shape Viewport
  derive narrow = viewport.width < 640
  derive pulse = viewport.prefersReducedMotion ? "none" : "breathe 1.6s ease-in-out infinite"
  derive unreadCount = messages.filter(m => m.unread).length
  view
    column testId=testId width="100%" max-width="blocks.mail-max" min-height="blocks.card-min" margin-left="auto" margin-right="auto" box-sizing="border-box" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden" aria-busy=(data == "loading")
      column justify-content="center" min-height="blocks.bar-min" padding-left="theme.space.xl" padding-right="theme.space.xl" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
        row align-items="baseline" gap="theme.space.md"
          if title != ""
            Words(text=title, kind="heading", outcome="none", level=2, testId=`${testId}-title`)
          if data == "loading"
            text loadingText testId=`${testId}-loading` role="status" margin-left="auto" min-width=0 font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          else
            if data != "failed"
              text `${unreadCount} ${unreadLabel}` testId=`${testId}-count` margin-left="auto" min-width=0 font="theme.type.caption" color="theme.color.ink-muted" font-variant-numeric="tabular-nums" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if agent == "changed"
          text agentNote testId=`${testId}-agent` font="theme.type.caption" color="theme.color.accent"
      if narrow
        ListPane(messages=messages, chosenKey=chosenKey, agentKey=agentKey, marked=(agent == "changed"), data=data, emptyText=emptyText, failedText=failedText, composeLabel=composeLabel, retryLabel=retryLabel, compose=compose, retry=retry, pulse=pulse, testId=testId)
      else
        row flex=1 align-items="stretch"
          ListPane(messages=messages, chosenKey=chosenKey, agentKey=agentKey, marked=(agent == "changed"), data=data, emptyText=emptyText, failedText=failedText, composeLabel=composeLabel, retryLabel=retryLabel, compose=compose, retry=retry, pulse=pulse, testId=testId)
          Reader(paneLabel=paneLabel, paneEmptyText=paneEmptyText, messages=messages, chosenKey=chosenKey, loading=(data == "loading"), pulse=pulse, testId=testId)
