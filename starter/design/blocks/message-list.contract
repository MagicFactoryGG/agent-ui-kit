// A mailbox's list of messages, with the pane that reads the chosen one on a wide window, in one card. The card
// holds one frame — the header, one full state cluster and the footer at the least, its content when the list
// outgrows that — and the whole window on a phone (a mailbox is the screen there), so a state changes what the
// panes hold, never the card's rhythm. The header stays one line in every state: the title, then the unread
// count as one badge in every state — a pill on the theme's fill, in the accent's ink while any message waits
// (it counts the accent dots, so the header's one live number shares their colour) and in the muted ink at
// zero, claiming no state that does not exist — and while the messages arrive, or fail to arrive, the badge's
// place holds a quiet breathing pill the badge's own size, so the slot never goes bare or jumps; and an
// agent's note under the title when it filed or flagged one, the one line that may appear, because an agent's
// act is worth a change of height.
//
// The list pane holds the rows, each a band that runs edge to edge: a status rail at the start — a dot when
// unread, a caution flag when flagged, both slots kept on every row so the words share one left edge — and
// the time alone at the end, so status and time never mix in one cluster; unread reads in the heavier type,
// sender and time on the first line, the subject then the snippet's one line under it. The chosen message is
// a filled band with the accent line at its start (selection is a surface plus the kit's mark line: the same
// line an agent's touch draws on LinkRow, here carried by the fill beneath it, so in either scheme the
// choice reads at a glance); an agent's mark is the same line on a quiet band — two actors, one grammar, told
// apart by the surface behind the line and the note that names the row. The list pane closes with a footer
// band pinned to its bottom in every state, the app's words for the list's order, so even one row reads as a
// whole list and the pane's chrome never rearranges itself under a person; loading keeps its peace: the rows
// breathe in the real row's own grid, every word swapped for a shimmer bar, a breathing dot in the unread's
// place, and the header's pill says the number is on its way — the state speaks once, in shimmer.
//
// The reading pane, headed by a band the pane's own width in the header's rhythm, holds the chosen message:
// who and when on one line, the subject as the pane's title, the snippet wrapping under; with nothing chosen
// it rests on its quiet glyph and the app's one line of why, and with no message at all it rests on the glyph
// alone, a placeholder that claims nothing, so the list's own word for its state is the one focal point;
// while the messages load, quiet bars in the message's own shape claim nothing either. Empty and failed speak
// one anatomy — a glyph in a circle, the state's line at title size, one plain button as the way on or the
// way back — so the two states read as a family; failed's colour lives on its glyph alone, the words stay
// level, and no element shouts twice. A phone draws the list alone, the platform's own idiom (a row pushes
// its detail): the split flips at the window's 640px floor (the responsive-columns recipe: "Else read
// exactViewport's width"); long words cut with an ellipsis in the rows and wrap in the pane. Every word is
// the app's.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton from "__SCOPE__/components"

// One message: its key (the app names the chosen one and the agent's by key), who it is from, its subject, the
// one line that previews it, when it arrived, and where it opens.
shape Message
  key: string
  from: string
  subject: string
  snippet: string
  when: string
  unread: bool
  flagged: bool
  href: string

// The window's width and the person's motion preference: the facts this block reads to lay itself out.
shape Viewport
  width: number
  prefersReducedMotion: bool

// The skeleton's quiet breathing, held still when the person prefers no motion.
keyframes breathe
  50% opacity=0.4

// Unread rows and the chosen one read in ink and the heavier type; read rows fall to the muted ink.
fn rowInk(strong: bool): string = strong ? "theme.color.ink" : "theme.color.ink-muted"

// One row: a status rail first (a dot when unread, a caution flag when flagged, each in its own fixed slot so
// every row's words share one left edge and the rail reads as the row's state at a glance — the flag's cloth
// hangs at mid-pole so its ink centres where the dot's does), then sender and time on the first line with the
// time alone at the right edge, then the subject, then the snippet's one line. The band runs edge to edge: the
// chosen row is a filled band with the accent line at its start (the fill carries the line, so the choice reads
// at a glance in either scheme); an agent's mark is the same line on a quiet band — LinkRow's grammar, told
// apart by the surface behind it.
component MessageRow
  props
    message: Message
    chosen: bool
    marked: bool
    note: string
    testId: string
  view
    link href=message.href testId=testId aria-current=(chosen ? "true" : "false") display="flex" flex-direction="row" align-items="flex-start" gap="theme.space.xs" min-height="components.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" color="theme.color.ink" text-decoration-line="none" background-color=(chosen ? "theme.color.fill" : "transparent") border-left-width="components.mark-line" border-left-style="solid" border-left-color=(marked or chosen ? "theme.color.accent" : "transparent")
      :hover
        background-color="theme.color.hover"
      :active
        background-color="theme.color.fill"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      row flex-shrink=0 align-items="flex-start"
        box width="blocks.dot-gutter" height="blocks.row-line" display="flex" align-items="center"
          if message.unread
            box width="blocks.dot" height="blocks.dot" background-color="theme.color.accent" border-radius="theme.radius.pill"
        box width="blocks.icon" height="blocks.row-line" display="flex" align-items="center"
          if message.flagged
            svg viewBox="0 0 12 12" width="components.chevron" height="components.chevron" fill="none" aria-hidden=true
              path d="M3 2v8" stroke="theme.color.caution" stroke-width=1.5 stroke-linecap="round"
              path d="M3.5 4h5.5l-1.8 2 1.8 2H3.5z" fill="theme.color.caution"
      column flex=1 min-width=0 gap="theme.space.xs"
        row align-items="center" gap="theme.space.lg" min-height="blocks.row-line"
          text message.from testId=`${testId}-from` min-width=0 flex=1 font=(message.unread or chosen ? "theme.type.label" : "theme.type.body") color=rowInk(message.unread or chosen) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          text message.when testId=`${testId}-when` min-width=0 flex-shrink=0 font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        row align-items="center" min-height="blocks.row-line"
          text message.subject testId=`${testId}-subject` min-width=0 flex=1 font=(message.unread or chosen ? "theme.type.label" : "theme.type.body") color=rowInk(message.unread or chosen) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text message.snippet testId=`${testId}-snippet` font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if marked and note != ""
          text note testId=`${testId}-agent` font="theme.type.caption" color="theme.color.accent"

// One quiet row while the messages load: the real row's own grid, exactly — the same padding, the same status
// rail with both slots drawn (a breathing dot in the unread's place, the flag's slot kept), the same gaps —
// with every word swapped for a shimmer bar: the name's bar running to the time bar's place at the right
// edge, then the subject's line and the snippet's under it. It says "rows are coming", not "nothing is
// here", and it breathes only when the person has not asked for still.
component SkelRow
  props
    pulse: string
  view
    row align-items="flex-start" gap="theme.space.xs" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md"
      row flex-shrink=0 align-items="flex-start"
        box width="blocks.dot-gutter" height="blocks.row-line" display="flex" align-items="center"
          box width="blocks.dot" height="blocks.dot" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
        box width="blocks.icon" height="blocks.row-line" display="flex" align-items="center"
      column flex=1 min-width=0 gap="theme.space.xs"
        row align-items="center" gap="theme.space.lg"
          box flex=1 height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
          box width="blocks.skel-when" height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0 animation=pulse
        box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
        box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse

// The list's own pane: the messages as bands (one listitem each) with air below the header's line; empty and
// failed say their own line here — one focal cluster, centred in the pane, with the way on — and loading
// breathes the rows it is waiting for; all of it stretches with the card, so the pane's shape never changes
// with its state, only its content does. A footer band with the app's words for the list's order pins the
// pane's bottom in every state, so even one row reads as a whole list.
component ListPane
  props
    messages: Message[]
    chosenKey: string
    agentKey: string
    marked: bool
    agentNote: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    emptyText: string
    failedText: string
    composeLabel: string
    retryLabel: string
    footerLabel: string
    compose: action
    retry: action
    pulse: string
    testId: string
  view
    column flex=1 min-width=0
      if data == "empty"
        column flex=1 role="status" min-height="blocks.state-min" justify-content="center" align-items="center" gap="theme.space.md" padding="theme.space.xl"
          svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
            circle cx=12 cy=12 r=12 fill="theme.color.fill"
            rect x="4.5" y="6.75" width="15" height="10.5" rx="1.5" fill="none" stroke="theme.color.ink-muted" stroke-width=1.5
            path d="M5.25 7.75l6.75 4.6 6.75-4.6" fill="none" stroke="theme.color.ink-muted" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
          Words(text=emptyText, kind="title", outcome="cancelled", level=0, testId=`${testId}-empty`)
          ActionButton(label=composeLabel, kind="plain", interaction="idle", outcome="none", press=compose, testId=`${testId}-compose`)
      else
        if data == "failed"
          column flex=1 role="alert" min-height="blocks.state-min" justify-content="center" align-items="center" gap="theme.space.md" padding="theme.space.xl"
            svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
              circle cx=12 cy=12 r=12 fill="theme.color.critical"
              circle cx=12 cy=12 r="6.75" fill="none" stroke="theme.color.critical-ink" stroke-width=1.8
              path d="M12 8.2v4.2" stroke="theme.color.critical-ink" stroke-width=1.8 stroke-linecap="round"
              circle cx=12 cy=15.6 r=1 fill="theme.color.critical-ink"
            Words(text=failedText, kind="title", outcome="none", level=0, testId=`${testId}-failed`)
            ActionButton(label=retryLabel, kind="plain", interaction="idle", outcome="none", press=retry, testId=`${testId}-retry`)
        else
          if data == "loading"
            column margin-top="theme.space.sm"
              SkelRow(pulse=pulse)
              SkelRow(pulse=pulse)
              SkelRow(pulse=pulse)
              SkelRow(pulse=pulse)
              SkelRow(pulse=pulse)
              SkelRow(pulse=pulse)
          else
            column flex=1 role="list" margin-top="theme.space.sm"
              for m in messages key=m.key
                column role="listitem"
                  MessageRow(message=m, chosen=(m.key == chosenKey), marked=(marked and m.key == agentKey), note=agentNote, testId=`${testId}-row-${m.key}`)
      if footerLabel != ""
        column min-height="blocks.bar-min" box-sizing="border-box" justify-content="center" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.sm" padding-bottom="theme.space.sm" border-top-width="theme.line.width" border-top-style="solid" border-top-color="theme.color.line"
          text footerLabel testId=`${testId}-footer` font="theme.type.caption" color="theme.color.ink-muted"

// The reading pane, drawn on the wide window beside the list: a band the pane's own width heads it, in the
// card header's rhythm, so its rule runs edge to edge as the header's does; under the band the chosen
// message — who and when on one line, the subject as the pane's title, the one focal point of a chosen
// message, and the snippet under it, wrapping. Nothing chosen, with messages to choose from, says so quietly
// over a small glyph; with no message at all it rests on the glyph alone, a placeholder that claims nothing,
// so the list's own word for its state is the one focal point; while the messages load, quiet bars in the
// message's own shape claim nothing either.
component Reader
  props
    paneLabel: string
    paneEmptyText: string
    messages: Message[]
    chosenKey: string
    loading: bool
    pulse: string
    testId: string
  derive picked = first(messages.filter(m => m.key == chosenKey))
  view
    column flex=1 min-width=0 role="complementary" aria-label=paneLabel border-left-width="theme.line.width" border-left-style="solid" border-left-color="theme.color.line"
      if paneLabel != ""
        column min-height="blocks.bar-min" box-sizing="border-box" justify-content="center" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.sm" padding-bottom="theme.space.sm" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
          text paneLabel testId=`${testId}-pane-label` font="theme.type.caption" color="theme.color.ink-muted"
      if loading
        column gap="theme.space.md" padding="theme.space.lg" aria-hidden=true
          row align-items="center" gap="theme.space.md"
            box flex=1 height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
            box width="blocks.skel-when" height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0 animation=pulse
          box height="blocks.skel-title" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
          box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
          box height="blocks.skel-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse
      else
        match picked
          case some(m)
            column gap="theme.space.md" padding="theme.space.lg"
              row align-items="center" gap="theme.space.md"
                text m.from testId=`${testId}-pane-from` min-width=0 flex=1 font="theme.type.label" color="theme.color.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                text m.when testId=`${testId}-pane-when` margin-left="auto" min-width=0 flex-shrink=0 font="theme.type.caption" color="theme.color.ink-muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              Words(text=m.subject, kind="title", outcome="none", level=3, testId=`${testId}-pane-subject`)
              text m.snippet testId=`${testId}-pane-snippet` font="theme.type.body" color="theme.color.ink-muted"
          case none
            column flex=1 gap="theme.space.md" align-items="center" justify-content="center" padding="theme.space.xl"
              svg viewBox="0 0 24 24" width="blocks.glyph" height="blocks.glyph" aria-hidden=true
                circle cx=12 cy=12 r=12 fill="theme.color.fill"
                rect x="7.5" y="5.5" width="9" height="13" rx=1.5 fill="none" stroke="theme.color.ink-muted" stroke-width=1.5
                path d="M9.5 9h5M9.5 12h5M9.5 15h3" stroke="theme.color.ink-muted" stroke-width=1.5 stroke-linecap="round"
              if messages.length > 0 and paneEmptyText != ""
                Words(text=paneEmptyText, kind="caption", outcome="cancelled", level=0, testId=`${testId}-pane-empty`)

// The mailbox: one card (it centres on a wide window up to its own max), the header, then the list — with the
// reading pane beside it whenever the window is wide, in every state, so the scaffold never rearranges itself
// under a person; and alone on a phone, where the row's own way in (its href) opens the message, as the
// platform composes a list with its detail. The card's floor is the window on a phone (a mailbox is the screen
// there) and its own on a desktop.
component MessageList
  props
    title: string
    unreadLabel: string
    emptyText: string
    failedText: string
    composeLabel: string
    retryLabel: string
    footerLabel: string
    paneLabel: string
    paneEmptyText: string
    agentNote: string
    chosenKey: string
    agentKey: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    agent: enum<"none", "changed">
    messages: Message[]
    compose: action
    retry: action
    testId: string
  resource viewport = exactViewport() as shape Viewport
  derive narrow = viewport.width < 640
  derive pulse = viewport.prefersReducedMotion ? "none" : "breathe 1.6s ease-in-out infinite"
  derive unreadCount = messages.filter(m => m.unread).length
  derive agentInList = (data == "many" or data == "one" or data == "long") and messages.filter(m => m.key == agentKey).length > 0
  view
    column testId=testId width="100%" max-width="blocks.mail-max" min-height=(narrow ? "blocks.mail-floor" : "blocks.mail-frame") margin-left="auto" margin-right="auto" box-sizing="border-box" background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" overflow="hidden" aria-busy=(data == "loading")
      column justify-content="center" min-height="blocks.bar-min" box-sizing="border-box" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-bottom-width="theme.line.width" border-bottom-style="solid" border-bottom-color="theme.color.line"
        row align-items="center" gap="theme.space.md"
          column flex=1 min-width=0 gap="theme.space.xs"
            if title != ""
              Words(text=title, kind="title", outcome="none", level=2, testId=`${testId}-title`)
            if agent == "changed" and not agentInList
              text agentNote testId=`${testId}-agent` font="theme.type.caption" color="theme.color.accent"
          if data == "loading"
            box width="blocks.skel-when" height="blocks.badge-line" flex-shrink=0 background-color="theme.color.fill" border-radius="theme.radius.pill" animation=pulse aria-hidden=true
          else
            if data != "failed"
              text `${unreadCount} ${unreadLabel}` testId=`${testId}-count` flex-shrink=0 max-width="blocks.badge-max" box-sizing="border-box" font="theme.type.caption" color=(unreadCount > 0 ? "theme.color.accent" : "theme.color.ink-muted") background-color="theme.color.fill" border-radius="theme.radius.pill" padding-top="theme.space.xs" padding-bottom="theme.space.xs" padding-left="theme.space.sm" padding-right="theme.space.sm" font-variant-numeric="tabular-nums" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      if narrow
        ListPane(messages=messages, chosenKey=chosenKey, agentKey=agentKey, marked=(agent == "changed"), agentNote=agentNote, data=data, emptyText=emptyText, failedText=failedText, composeLabel=composeLabel, retryLabel=retryLabel, footerLabel=footerLabel, compose=compose, retry=retry, pulse=pulse, testId=testId)
      else
        row flex=1 align-items="stretch"
          ListPane(messages=messages, chosenKey=chosenKey, agentKey=agentKey, marked=(agent == "changed"), agentNote=agentNote, data=data, emptyText=emptyText, failedText=failedText, composeLabel=composeLabel, retryLabel=retryLabel, footerLabel=footerLabel, compose=compose, retry=retry, pulse=pulse, testId=testId)
          Reader(paneLabel=paneLabel, paneEmptyText=paneEmptyText, messages=messages, chosenKey=chosenKey, loading=(data == "loading"), pulse=pulse, testId=testId)
