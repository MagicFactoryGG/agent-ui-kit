// A titled group of settings rows on one card, the way a settings page groups them: a switch row, a value row
// that opens a choice, a link row, and a destructive row at the end (in the critical ink, never a filled red
// block). The rows come in as data; the app owns every value and word. Both doors — the person's press and the
// agent's tool — reach the app's same actions, each with the row's key: `toggle` (a switch; the app flips its
// own value), `choose` (a value row's choice), `open` (a link row), `remove` (the destructive row; the app may
// confirm it in a sheet first), and `retry` when a load failed, with the app's own word.
//
// States, declared once as axes: `data` draws the rows, a skeleton in the rows' own shape while loading (its
// line says so under the card), or its own empty or failed line on the card (failed says its line and offers
// the retry); `interaction` (idle, disabled, busy) stills the group without dimming a word below what a person
// can read (disabled rows take the muted ink, the switch sleeps); `outcome` (success, error) says one line
// under the group; `agent` (proposed, changed, waiting) marks the card's start and says `agentNote` under it,
// the way LinkRow and TopBar do. The destructive row stands a hair off the last row above it, the way a
// settings page sets it apart. `blocks.settings-max` keeps the card a sensible width on a wide window and
// centres it there, the same width in every state; on a phone every label, detail and value wraps, so the
// edges stay aligned and nothing is cut off.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton from "__SCOPE__/components"

// One row of the group, drawn by its `kind`: a switch keeps its state in `on`; a value row shows `value` and
// opens a choice; a link row opens by its key; a danger row acts at once. `detail` is its second line, "" for
// none; `value` is "" on every other kind.
shape Setting
  key: string
  kind: enum<"switch", "value", "link", "danger">
  label: string
  detail: string
  value: string
  on: bool

// The mark an agent's act leaves on the card: accent for a change or a suggestion, caution while it waits.
fn agentLine(a: string): string = a == "proposed" or a == "changed" ? "theme.color.accent" : a == "waiting" ? "theme.color.caution" : "transparent"
// A stilled group keeps its words readable: the rows take the muted ink, never a dimmed one.
fn rowInk(i: string): string = i == "disabled" ? "theme.color.ink-muted" : "theme.color.ink"

component SettingsGroup
  props
    title: string
    footer: string
    emptyText: string
    loadingText: string
    failedText: string
    retryLabel: string
    agentNote: string
    outcomeText: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    interaction: enum<"idle", "disabled", "busy">
    outcome: enum<"none", "success", "error">
    agent: enum<"none", "proposed", "changed", "waiting">
    rows: Setting[]
    toggle: action
    choose: action
    open: action
    remove: action
    retry: action
    testId: string
  // The platform's switch says its new state; the app's `toggle` takes the row's key and flips its own value.
  action flip(key: string, on: bool)
    toggle(key)
  view
    column testId=testId role="group" aria-label=title gap="theme.space.sm" width="100%" max-width="blocks.settings-max" box-sizing="border-box" margin-left="auto" margin-right="auto"
      if title != ""
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          Words(text=title, kind="heading", outcome="none", level=2, testId=`${testId}-title`)
      column testId=`${testId}-card` aria-busy=(interaction == "busy") background-color="theme.color.surface" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color=agentLine(agent) overflow="hidden"
        if data == "empty"
          column padding="theme.space.lg" role="status"
            Words(text=emptyText, kind="body", outcome="cancelled", level=0, testId=`${testId}-empty`)
        else if data == "loading"
          column
            for j in [0, 1, 2] key=j
              column padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" gap="theme.space.xs" border-top-width=(j > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                row gap="theme.space.sm" align-items="center"
                  box flex=5 height="blocks.skeleton-line" background-color="theme.color.fill" border-radius="theme.radius.pill"
                  box flex=6
                row gap="theme.space.sm" align-items="center"
                  box flex=7 height="blocks.skeleton-line" background-color="theme.color.fill" border-radius="theme.radius.pill"
                  box flex=3
        else if data == "failed"
          column padding="theme.space.lg" gap="theme.space.md"
            column role="alert"
              Words(text=failedText, kind="body", outcome="error", level=0, testId=`${testId}-failed`)
            if retryLabel != ""
              row
                ActionButton(label=retryLabel, kind="primary", interaction=(interaction == "idle" ? "idle" : "disabled"), outcome="none", press=retry, testId=`${testId}-retry`)
        for r, i in rows key=r.key
          if r.kind == "switch"
            row align-items="center" gap="theme.space.md" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
              column flex=1 min-width=0 gap="theme.space.xs"
                text r.label font="theme.type.body" color=rowInk(interaction)
                if r.detail != ""
                  text r.detail font="theme.type.caption" color="theme.color.ink-muted"
              input type="checkbox" switch checked=r.on change=flip(r.key) disabled=(interaction != "idle") aria-label=r.label opacity=(interaction == "disabled" ? 0.5 : interaction == "busy" ? 0.6 : 1) testId=`${testId}-switch-${r.key}`
          else if r.kind == "value"
            button press=choose(r.key) disabled=(interaction != "idle") testId=`${testId}-value-${r.key}` display="flex" flex-direction="row" align-items="center" gap="theme.space.md" text-align="start" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" background-color="transparent"
              :hover
                background-color="theme.color.hover"
              :active
                background-color="theme.color.fill"
              :focus-visible
                box-shadow="inset 0 0 0 2px theme.color.focus"
              column flex=1 min-width=0 gap="theme.space.xs"
                row align-items="baseline" gap="theme.space.md"
                  text r.label flex=1 min-width=0 font="theme.type.body" color=rowInk(interaction)
                  if r.value != ""
                    text r.value min-width=0 font="theme.type.body" color=rowInk(interaction)
                if r.detail != ""
                  text r.detail font="theme.type.caption" color="theme.color.ink-muted"
              svg viewBox="0 0 12 12" width="blocks.chevron" height="blocks.chevron" fill="none" stroke="theme.color.ink-muted" aria-hidden=true flex-shrink=0
                path d="M4.5 2.5L8 6l-3.5 3.5" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
          else if r.kind == "link"
            button press=open(r.key) disabled=(interaction != "idle") testId=`${testId}-link-${r.key}` display="flex" flex-direction="row" align-items="center" gap="theme.space.md" text-align="start" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" background-color="transparent"
              :hover
                background-color="theme.color.hover"
              :active
                background-color="theme.color.fill"
              :focus-visible
                box-shadow="inset 0 0 0 2px theme.color.focus"
              column flex=1 min-width=0 gap="theme.space.xs"
                text r.label font="theme.type.body" color=rowInk(interaction)
                if r.detail != ""
                  text r.detail font="theme.type.caption" color="theme.color.ink-muted"
              svg viewBox="0 0 12 12" width="blocks.chevron" height="blocks.chevron" fill="none" stroke="theme.color.ink-muted" aria-hidden=true flex-shrink=0
                path d="M4.5 2.5L8 6l-3.5 3.5" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
          else
            button press=remove(r.key) disabled=(interaction != "idle") testId=`${testId}-danger-${r.key}` margin-top="theme.space.xs" display="flex" flex-direction="row" align-items="center" gap="theme.space.md" text-align="start" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line" background-color="transparent"
              :hover
                background-color="theme.color.hover"
              :active
                background-color="theme.color.fill"
              :focus-visible
                box-shadow="inset 0 0 0 2px theme.color.focus"
              column flex=1 min-width=0 gap="theme.space.xs"
                text r.label font="theme.type.body" color=(interaction == "disabled" ? "theme.color.ink-muted" : "theme.color.critical-text")
                if r.detail != ""
                  text r.detail font="theme.type.caption" color=(interaction == "disabled" ? "theme.color.ink-muted" : "theme.color.critical-text")
      if data == "loading"
        column padding-left="theme.space.lg" padding-right="theme.space.lg" role="status"
          Words(text=loadingText, kind="caption", outcome="none", level=0, testId=`${testId}-loading`)
      if agent != "none"
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          text agentNote testId=`${testId}-agent` font="theme.type.caption" color=(agent == "waiting" ? "theme.color.caution-text" : "theme.color.accent")
      if outcome != "none"
        column padding-left="theme.space.lg" padding-right="theme.space.lg" role=(outcome == "error" ? "alert" : "status")
          Words(text=outcomeText, kind="caption", outcome=(outcome == "success" ? "success" : "error"), level=0, testId=`${testId}-outcome`)
      if footer != ""
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          Words(text=footer, kind="caption", outcome="none", level=0, testId=`${testId}-footer`)
