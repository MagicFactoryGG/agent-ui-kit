// A titled group of settings rows on one card, the way a settings page groups them: a switch row, a value row
// that opens a choice, a link row, and a destructive row at the end (in the critical ink, never a filled red
// block). The rows come in as data; the app owns every value and word. Both doors — the person's press and the
// agent's tool — reach the app's same actions, each with the row's key: `toggle` (a switch; the app flips its
// own value), `choose` (a value row's choice), `open` (a link row), `remove` (the destructive row; the app may
// confirm it in a sheet first), and `retry` when a load failed, with the app's own word.
//
// States, declared once as axes: `data` draws the rows; while loading a skeleton predicts them — every row
// two lines with a trailing pill where a control will sit, one inset hairline between rows — and its bars
// breathe slowly so the card reads as working, never as empty (its line names the skeleton to a screen
// reader); empty takes the card's centre with room around it — a dashed mark, the muted line — the honest
// quiet of nothing to show; failed leads with its sentence beside an alert mark in the critical ink,
// `failedDetail` under it, and offers the app's retry as the one filled act on the card, while the standing
// footer stands down (a note about applying changes would argue with a load that changed nothing).
// `interaction` (idle, disabled, busy) stills the group without dimming a word below what a person can read
// (disabled rows take the muted ink, the switch sleeps). `outcome` (success, error) says one line under the
// group. `agent` (proposed, changed, waiting) marks the card's start and says `agentNote` under it, the way
// LinkRow and TopBar do. The card sits one surface step above the page (`raised`), so it holds the group's
// weight in dark as in light; the switch carries the Theme's own accent; a value row's chosen value sits on
// its title's line with the chevron beside it, so the two read as one affordance. Rows part on one kind of
// seam, an inset hairline; the destructive row ends the card behind the same seam with a little more space,
// and only its label carries the critical ink. `blocks.settings-max` matches the kit's reading column
// (`screens.column-max`), so the card fills the column a screen gives it and no more, the same width in
// every state; on a phone every label, detail and value wraps, so the edges stay aligned and nothing is cut
// off.
use Swatch from "__SCOPE__/theme"
use Words, ActionButton from "__SCOPE__/components"

// The skeleton's pulse: opacity alone, shallow enough that any frame still reads.
keyframes skeleton-breathe
  50% opacity=0.65

// One row of the group, drawn by its `kind`: a switch keeps its state in `on`; a value row shows `value` and
// opens a choice; a link row opens by its key; a danger row acts at once. `detail` is its second line, "" for
// none; `value` is "" on every other kind.
shape Setting
  key: string
  kind: enum<"switch", "value", "link", "danger">
  label: string
  detail: string
  value: string
  on: bool

// The mark an agent's act leaves on the card: accent for a change or a suggestion, caution while it waits.
fn agentLine(a: string): string = a == "proposed" or a == "changed" ? "theme.color.accent" : a == "waiting" ? "theme.color.caution" : "transparent"
// A stilled group keeps its words readable: the rows take the muted ink, never a dimmed one.
fn rowInk(i: string): string = i == "disabled" ? "theme.color.ink-muted" : "theme.color.ink"
// The destructive row carries the critical ink on its label alone; stilled, it reads like the rest.
fn dangerInk(i: string): string = i == "disabled" ? "theme.color.ink-muted" : "theme.color.critical-text"

// One row of the card that opens or acts — the value, link and danger kinds share it — so the row's chrome
// (padding, separators, hover, press, focus) is drawn once. Its leading column is `label` over `detail`; its
// trailing cluster is the chosen `value` beside the `chevron` that says it opens, so the two read as one
// affordance; a `danger` row has no trailing, carries the critical ink on its label alone, and sits below the
// inset break its caller draws above it. Not exported: only SettingsGroup draws it.
component SettingRow
  props
    label: string
    detail: string
    value: string
    chevron: bool
    danger: bool
    first: bool
    interaction: enum<"idle", "disabled", "busy">
    press: action
    testId: string
  view
    button press=press testId=testId disabled=(interaction != "idle") margin-top=(danger ? "theme.space.sm" : "0") display="flex" flex-direction="row" align-items="center" gap="theme.space.md" text-align="start" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(first or danger ? "0" : "theme.line.width") border-top-style="solid" border-top-color="theme.color.line" background-color="transparent"
      :hover
        background-color="theme.color.hover"
      :active
        background-color="theme.color.fill"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      column flex=1 min-width=0 gap="theme.space.xs"
        text label font="theme.type.body" color=(danger ? dangerInk(interaction) : rowInk(interaction))
        if detail != ""
          text detail font="theme.type.caption" color="theme.color.ink-muted"
      if chevron
        row align-items="center" gap="theme.space.md" min-width=0
          if value != ""
            text value min-width=0 font="theme.type.body" color=rowInk(interaction)
          svg viewBox="0 0 12 12" width="blocks.chevron" height="blocks.chevron" fill="none" stroke="theme.color.ink-muted" aria-hidden=true flex-shrink=0
            path d="M4.5 2.5L8 6l-3.5 3.5" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component SettingsGroup
  props
    title: string
    footer: string
    emptyText: string
    loadingText: string
    failedText: string
    failedDetail: string
    retryLabel: string
    agentNote: string
    outcomeText: string
    data: enum<"many", "one", "empty", "loading", "failed", "long">
    interaction: enum<"idle", "disabled", "busy">
    outcome: enum<"none", "success", "error">
    agent: enum<"none", "proposed", "changed", "waiting">
    rows: Setting[]
    toggle: action
    choose: action
    open: action
    remove: action
    retry: action
    testId: string
  // The platform's switch says its new state; the app's `toggle` takes the row's key and flips its own value.
  action flip(key: string, on: bool)
    toggle(key)
  // One act, one door: the row's kind decides which of the app's actions it reaches, always with its key.
  action act(kind: string, key: string)
    if kind == "value"
      choose(key)
    else if kind == "link"
      open(key)
    else
      remove(key)
  view
    column testId=testId role="group" aria-label=title gap="theme.space.sm" width="100%" max-width="blocks.settings-max" box-sizing="border-box" margin-left="auto" margin-right="auto"
      if title != ""
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          Words(text=title, kind="heading", outcome="none", level=2, testId=`${testId}-title`)
      column testId=`${testId}-card` aria-busy=(interaction == "busy") background-color="theme.color.raised" border-radius="theme.radius.card" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-left-width="blocks.mark-line" border-left-style="solid" border-left-color=agentLine(agent) overflow="hidden"
        if data == "empty"
          row padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" min-height="blocks.row-min" align-items="center" gap="theme.space.sm" role="status"
            svg viewBox="0 0 16 16" width="blocks.empty-mark" height="blocks.empty-mark" fill="none" stroke="theme.color.ink-muted" aria-hidden=true flex-shrink=0
              rect x="2" y="4" width="12" height="8" rx="2.5" stroke-width=1.5 stroke-dasharray="3 2"
            text emptyText testId=`${testId}-empty` font="theme.type.body" color="theme.color.ink-muted"
        else if data == "loading"
          column role="status" aria-label=loadingText
            for j in [0, 1, 2] key=j
              if j == 2
                box height="theme.line.width" background-color="theme.color.line" margin-left="theme.space.lg" margin-right="theme.space.lg" margin-top="theme.space.sm"
              row align-items="center" gap="theme.space.md" min-height="blocks.row-min" margin-top=(j == 2 ? "theme.space.sm" : "0") padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(j == 1 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
                column flex=1 min-width=0 gap="theme.space.xs"
                  row gap="theme.space.sm" align-items="center"
                    box flex=(j == 0 ? 5 : j == 1 ? 4 : 6) height="blocks.skeleton-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation="skeleton-breathe 1.6s ease-in-out infinite"
                    box flex=(j == 0 ? 3 : j == 1 ? 4 : 2)
                  row gap="theme.space.sm" align-items="center"
                    box flex=7 height="blocks.skeleton-line" background-color="theme.color.fill" border-radius="theme.radius.pill" animation="skeleton-breathe 1.6s ease-in-out infinite"
                    box flex=3
                if j < 2
                  box width="blocks.skeleton-blob" height="blocks.skeleton-line" background-color="theme.color.fill" border-radius="theme.radius.pill" flex-shrink=0 animation="skeleton-breathe 1.6s ease-in-out infinite"
        else if data == "failed"
          column padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" gap="theme.space.xs"
            text failedText testId=`${testId}-failed` role="alert" font="theme.type.body" color="theme.color.critical-text"
            if failedDetail != ""
              text failedDetail testId=`${testId}-failed-detail` font="theme.type.caption" color="theme.color.ink-muted"
            if retryLabel != ""
              row margin-top="theme.space.sm"
                ActionButton(label=retryLabel, kind="primary", interaction=(interaction == "idle" ? "idle" : "disabled"), outcome="none", press=retry, testId=`${testId}-retry`)
        for r, i in rows key=r.key
          if r.kind == "danger" and i > 0
            box height="theme.line.width" background-color="theme.color.line" margin-left="theme.space.lg" margin-right="theme.space.lg" margin-top="theme.space.sm"
          if r.kind == "switch"
            row align-items="center" gap="theme.space.md" min-height="blocks.row-min" padding-left="theme.space.lg" padding-right="theme.space.lg" padding-top="theme.space.md" padding-bottom="theme.space.md" border-top-width=(i > 0 ? "theme.line.width" : "0") border-top-style="solid" border-top-color="theme.color.line"
              column flex=1 min-width=0 gap="theme.space.xs"
                text r.label font="theme.type.body" color=rowInk(interaction)
                if r.detail != ""
                  text r.detail font="theme.type.caption" color="theme.color.ink-muted"
              input type="checkbox" switch checked=r.on change=flip(r.key) disabled=(interaction != "idle") aria-label=r.label accent-color="theme.color.accent" opacity=(interaction == "disabled" ? 0.5 : interaction == "busy" ? 0.6 : 1) testId=`${testId}-switch-${r.key}`
          else
            SettingRow(label=r.label, detail=r.detail, value=r.value, chevron=(r.kind == "value" or r.kind == "link"), danger=(r.kind == "danger"), first=(i == 0), interaction=interaction, press=act(r.kind, r.key), testId=`${testId}-${r.kind}-${r.key}`)
      if agent != "none"
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          text agentNote testId=`${testId}-agent` font="theme.type.caption" color=(agent == "waiting" ? "theme.color.caution-text" : "theme.color.accent")
      if outcome != "none"
        column padding-left="theme.space.lg" padding-right="theme.space.lg" role=(outcome == "error" ? "alert" : "status")
          Words(text=outcomeText, kind="caption", outcome=(outcome == "success" ? "success" : "error"), level=0, testId=`${testId}-outcome`)
      if footer != "" and data != "failed"
        column padding-left="theme.space.lg" padding-right="theme.space.lg"
          Words(text=footer, kind="caption", outcome="none", level=0, testId=`${testId}-footer`)
