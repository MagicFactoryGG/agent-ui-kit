// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.stat-max: length = 960px
  blocks.stat-fail-max: length = 480px
  blocks.stat-tile-min: length = 160px
  blocks.stat-trend: length = 12px
  blocks.stat-bar: length = 96px
  blocks.stat-mark-line: length = 3px
  blocks.stat-ghost-label: length = 96px
  blocks.stat-ghost-value: length = 128px
  blocks.stat-ghost-change: length = 72px
