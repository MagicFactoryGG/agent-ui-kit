// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.table-max: length = 920px
  blocks.row-min: length = 44px
  blocks.mark-line: length = 3px
  blocks.glyph: length = 12px
  blocks.select-col: length = 48px
  blocks.col-status: length = 110px
  blocks.col-owner: length = 150px
  blocks.col-updated: length = 130px
  blocks.skel-bar: length = 8px
  blocks.skel-check: length = 16px
