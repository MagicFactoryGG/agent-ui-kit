// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.settings-card: length = 720px
  blocks.label-min: length = 160px
  blocks.label-line: length = 18px
  blocks.trailing: length = 56px
  blocks.row-min: length = 44px
  blocks.mark-line: length = 3px
  blocks.chevron: length = 12px
  blocks.skeleton-label: length = 120px
  blocks.skeleton-detail: length = 200px
  blocks.skeleton-line: length = 12px
  blocks.skeleton-blob: length = 32px
  blocks.skeleton-value: length = 48px
  blocks.skeleton-pill: length = 18px
  blocks.danger-seam: length = 2px
  blocks.danger-gap: length = 16px
  blocks.empty-disc: length = 20px
  blocks.empty-mark: length = 12px
  blocks.alert-mark: length = 16px
  blocks.agent-dot: length = 6px
