// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.nav-max: length = 420px
  blocks.nav-row-min: length = 44px
  blocks.nav-mark: length = 28px
  blocks.nav-mark-line: length = 3px
  blocks.nav-slot-max: length = 160px
  blocks.nav-skel-head: length = 72px
  blocks.nav-glyph: length = 24px
  blocks.nav-heading-inset: length = 19px
