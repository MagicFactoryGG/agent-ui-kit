  blocks.plan-min: length = 256px
  blocks.plan-max: length = 400px
  blocks.lead-max: length = 560px
  blocks.point-line: length = 21px  // one body line's own height (15px at 1.4), so the tick sits level with a point's first line
  blocks.point-tick: length = 14px
  blocks.plan-head: length = 28px  // the tag's own height: a caption line, its xs paddings and hairlines
  blocks.ghost-line: length = 12px
  blocks.ghost-price: length = 20px
  blocks.price-line: length = 25px  // the title type's own line (20px at 1.25), where a price sits
  blocks.caption-line: length = 18px  // the caption type's own line (13px at 1.35)
  blocks.footer-max: length = 1120px
  blocks.footer-air: length = 48px
  blocks.footer-gap: length = 48px
  blocks.footer-brand-min: length = 240px
  blocks.footer-col-min: length = 150px  // two columns need 324px with their gap, inside a 390px phone's 358px; three need 498px, so a phone holds two; four fit a desktop's 800px
  blocks.footer-link-min: length = 32px
  blocks.footer-head-min: length = 17px  // the heading type's own line (13px at 1.3)
  blocks.footer-bone: length = 10px
  blocks.footer-dot: length = 6px
  blocks.footer-mark: length = 32px
  blocks.footer-mark-icon: length = 24px
  blocks.footer-alert: length = 16px
  blocks.footer-measure: length = 320px
  blocks.footer-rule: length = 3px
  blocks.faq-max: length = 992px  // the list column comes to 640px, StatePanel's own full width, so its card meets the seams
  blocks.faq-aside: length = 240px
  blocks.faq-main: length = 320px
  blocks.faq-measure: length = 560px  // near 70 characters of body type a line
  blocks.faq-glyph: length = 24px
  blocks.faq-glyph-lead: length = 3px  // the label's line (18px) centred on the glyph's 24px
  blocks.faq-row-min: length = 56px
  blocks.faq-mark: length = 3px
  blocks.faq-bone: length = 12px
  blocks.faq-bone-thin: length = 10px
  blocks.faq-line: length = 21px  // the body type's line (15px at 1.4): a ghost answer line holds it
  blocks.bar-chart-max: length = 880px  // the card's widest: six to eight columns at their own cap, centred
  blocks.bar-chart-compact-max: length = 560px  // horizontal bars read best at a measure, not across a desktop
  blocks.bar-chart-head-min: length = 200px  // the title's least width before the range switch wraps under it
  blocks.bar-chart-plot: length = 200px  // the wide chart's plot height, from the baseline to the tallest cap
  blocks.bar-chart-col-max: length = 112px  // a column's widest share of the card, so few columns stay a chart
  blocks.bar-chart-column: length = 32px  // a column's bar, thin: the rest of its slot is air
  blocks.bar-chart-row: length = 12px  // a horizontal bar's thickness
  blocks.bar-chart-cap: length = 4px  // the bar's rounded data end; the baseline end stays square
  blocks.bar-chart-sliver: length = 2px  // a zero still shows on the baseline
  blocks.bar-chart-dot: length = 8px
  blocks.bar-chart-glyph: length = 32px
  blocks.bar-chart-bone: length = 10px  // a ghost label's height, the caption's x-height and air
  blocks.bar-chart-measure: length = 420px  // a state's sentence, held to a short line
  blocks.command-menu-max: length = 640px  // a command menu's measure on a desktop: a label and its keys in one glance
  blocks.command-menu-row: length = 44px  // a row's least height (the field's too): the press target the kit holds
  blocks.command-menu-mark: length = 3px  // the agent's line at a band's start (LinkRow's mark)
  blocks.command-menu-note-min: length = 200px  // the agent's sentence keeps this much before Undo wraps under it
  blocks.command-menu-bone: length = 12px
  blocks.command-menu-ghost: length = 136px
  blocks.command-menu-ghost-wide: length = 208px
  blocks.command-menu-ghost-keys: length = 48px
