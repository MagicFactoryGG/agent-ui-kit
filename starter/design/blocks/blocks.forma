// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.detail-max: length = 880px
  blocks.notes-hold: length = 96px
  blocks.stamp: length = 80px
  blocks.spin: length = 16px
  blocks.alert-line: length = 2px
  blocks.term: length = 160px
  blocks.header-min: length = 240px
  blocks.panel-max: length = 640px
  blocks.panel-compact: length = 320px
  blocks.shape-full: length = 56px
  blocks.shape-compact: length = 40px
  blocks.bone: length = 12px
  blocks.bone-action: length = 96px  // the action's own footprint as drawn (ActionButton's least height, a two-word label's width)
  blocks.note-dot: length = 8px
  blocks.measure: length = 480px
  blocks.action-min: length = 44px  // ActionButton's own least height (components.row-min); a block may not reach into another package's sizes
  blocks.table-max: length = 960px
  blocks.row-min: length = 44px
  blocks.mark-line: length = 3px
  blocks.glyph: length = 12px
  blocks.state-glyph: length = 24px
  blocks.select-col: length = 48px
  blocks.col-status: length = 112px
  blocks.col-owner: length = 128px
  blocks.col-updated: length = 112px
  blocks.skel-bar: length = 8px
  blocks.skel-check: length = 20px
  blocks.tone-dot: length = 6px
  blocks.state-min: length = 176px
  blocks.state-max: length = 480px
