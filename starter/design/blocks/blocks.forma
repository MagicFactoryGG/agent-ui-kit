// The blocks' own sizes; shipping a design holds this package to Exact's library rules.
forma blocks

theme
  blocks.bar-min: length = 52px
  blocks.sheet-max: length = 480px
  blocks.steps-max: length = 640px
  blocks.step-dot: length = 28px
  blocks.step-tick: length = 12px
  blocks.step-line: length = 2px
  blocks.mark-line: length = 3px
  blocks.actions-min: length = 240px
  blocks.alert: length = 16px
  blocks.skel-head: length = 20px
  blocks.skel-line: length = 12px
  blocks.skel-count: length = 24px
  blocks.skel-btn: length = 96px
  blocks.skel-btn-tall: length = 44px
