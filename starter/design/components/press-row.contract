// PressRow: a row a person presses to run one thing: its label, a muted detail under it, and its keys (a
// shortcut) at the row's end as small key caps. Why a component of its own: a block may draw no button
// (tools/primitives.mjs), and the kit had no pressable row that carries a shortcut (LinkRow opens a link,
// ActionButton holds one label). A command menu's results are made of it; so can any list of acts.
//
// - `on` is the row the keyboard would run now (a command menu's highlight): the fill token and the label's
//   heavier type, said as aria-current. It is the list's one filled row.
// - An agent's mark is LinkRow's grammar: a line at the row's start in the accent (proposed, changed), with
//   `agentNote` under the detail when given.
// - The keys are drawn, not read: each one a cap with the line's hairline on the page token (never a fill
//   alone, which a theme may make the surface's own colour). The button's name is `label` alone.
//
// States:
//   interaction  idle|hover|pressed|focus|disabled
//   agent        none|proposed|changed
component PressRow
  props
    label: string
    detail: string
    keys: string[]
    on: bool
    agentNote: string
    interaction: enum<"idle", "hover", "pressed", "focus", "disabled">
    agent: enum<"none", "proposed", "changed">
    press: action
    testId: string
  view
    button press=press testId=testId aria-label=label aria-current=(on ? "true" : "false") disabled=(interaction == "disabled") position="relative" display="flex" flex-direction="row" align-items="center" gap="theme.space.md" width="100%" min-height="components.row-min" box-sizing="border-box" padding-left="theme.space.md" padding-right="theme.space.md" padding-top="theme.space.sm" padding-bottom="theme.space.sm" border-width=0 border-radius="theme.radius.control" text-align="start" color="theme.color.ink" background-color=(on ? "theme.color.fill" : interaction == "hover" ? "theme.color.hover" : interaction == "pressed" ? "theme.color.fill" : "transparent") opacity=(interaction == "disabled" ? 0.5 : 1) box-shadow=(interaction == "focus" ? "inset 0 0 0 2px theme.color.focus" : "none")
      :hover
        background-color="theme.color.hover"
      :active
        background-color="theme.color.fill"
      :focus-visible
        box-shadow="inset 0 0 0 2px theme.color.focus"
      if agent != "none"
        box position="absolute" left=0 top="theme.space.sm" bottom="theme.space.sm" width="components.mark-line" background-color="theme.color.accent" border-radius="theme.radius.pill" aria-hidden=true
      column flex=1 min-width=0 gap="theme.space.xs"
        text label font=(on ? "theme.type.label" : "theme.type.body") color="theme.color.ink" overflow-wrap="anywhere"
        if detail != ""
          text detail font="theme.type.caption" color="theme.color.ink-muted" overflow-wrap="anywhere"
        if agent != "none" and agentNote != ""
          text agentNote testId=`${testId}-mark` font="theme.type.caption" color="theme.color.accent"
      if keys.length > 0
        row flex-shrink=0 gap="theme.space.xs" aria-hidden=true
          for k in keys key=k
            text k min-width="components.key-min" box-sizing="border-box" text-align="center" padding-left="theme.space.xs" padding-right="theme.space.xs" font="theme.type.caption" color="theme.color.ink-muted" background-color="theme.color.page" border-width="theme.line.width" border-style="solid" border-color="theme.color.line" border-radius="theme.radius.control"
