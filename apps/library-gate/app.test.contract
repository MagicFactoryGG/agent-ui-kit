// Every cell renders, and every slot shows its marker.
test "every cell renders"
  expect tree has "gate-top"
  expect tree has "cm-base-mark"
  expect tree has "pb-base-accept"
  expect tree has "nt-base-no"
  expect tree has "sample-nt-proposed-yes"
  expect tree missing "sample-nt-direct-yes"
  expect tree has "al-base-a2-undo"
  expect tree has "sample-al-empty-empty"
  expect tree has "pl-base-setSetting"
  expect tree has "fd-base-hint"
  expect tree has "sample-fd-error-error"
  expect tree has "cb-base"
  expect tree has "tr-base"
  expect tree has "sample-tr-marked-mark"
  expect tree has "sample-tr-proposed-accept"
  expect tree has "ar-base-row"
  expect tree has "sample-ar-marked-mark"
  expect tree has "cp-base-undo-agent"

test "every slot holds its marker, and the marker presses"
  expect tree has "marker-fd-base"
  expect tree has "marker-sample-fd-error"
  expect tree has "marker-ar-base"
  expect tree has "marker-sample-ar-marked"
  tap "marker-ar-base"
  expect state glyph == "B"
